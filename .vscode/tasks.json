{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "startup vmw",
      "type": "shell",
      "isBackground": true,
      "command": "vmware -x -q $HOME/vmware/myos2test/myos2test_dbg.vmx",
      "problemMatcher": [
        {
          "pattern": [
            { "regexp": ".", "file": 1, "location": 2, "message": 3 }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "."
          }
        }
      ]
    },

    {
      "label": "startup qemu (myos2 host)",
      "type": "shell",
      "isBackground": true,
      "command": "bash",
      "args": ["${workspaceFolder}/.vscode-kdbg/run-qemu-gdb-myos2.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "USE_KVM": "1",
          "CPU_OPTS": "host",
          "GDB_PORT": "8864",
          "PIDFILE": "${workspaceFolder}/.qemu-myos2-host.pid",

          "OVMF_DIR": "${workspaceFolder}/myloader",
          "OVMF_VARS_OUT": "${workspaceFolder}/.vscode-kdbg/ovmf-vars-myos2-host.fd",

          "DISPLAY": "${env:DISPLAY}",
          "DISPLAY_OPTS": "-display gtk"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": [
        {
          "severity": "info",
          "pattern": [
            { "regexp": "^(qemu\\.task):(\\d+):\\s+(.*)$", "file": 1, "line": 2, "message": 3 }
          ],
          "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "READY" }
        }
      ]
    },
    {
      "label": "kill qemu (myos2 host)",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/.vscode-kdbg/kill-qemu-myos2.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PIDFILE": "${workspaceFolder}/.qemu-myos2-host.pid" }
      },
      "problemMatcher": []
    },

    {
      "label": "startup qemu (myos2 kvm)",
      "type": "shell",
      "isBackground": true,
      "command": "bash",
      "args": ["${workspaceFolder}/.vscode-kdbg/run-qemu-gdb-myos2.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "USE_KVM": "1",
          "CPU_OPTS": "host,+invtsc,kvm=on",
          "GDB_PORT": "8864",
          "PIDFILE": "${workspaceFolder}/.qemu-myos2-kvm.pid",

          "OVMF_DIR": "${workspaceFolder}/myloader",
          "OVMF_VARS_OUT": "${workspaceFolder}/.vscode-kdbg/ovmf-vars-myos2-kvm.fd",

          "DISPLAY": "${env:DISPLAY}",
          "DISPLAY_OPTS": "-display gtk"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": [
        {
          "severity": "info",
          "pattern": [
            { "regexp": "^(qemu\\.task):(\\d+):\\s+(.*)$", "file": 1, "line": 2, "message": 3 }
          ],
          "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "READY" }
        }
      ]
    },
    {
      "label": "kill qemu (myos2 kvm)",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/.vscode-kdbg/kill-qemu-myos2.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PIDFILE": "${workspaceFolder}/.qemu-myos2-kvm.pid" }
      },
      "problemMatcher": []
    },

    {
      "label": "startup qemu (myos2 tcg)",
      "type": "shell",
      "isBackground": true,
      "command": "bash",
      "args": ["${workspaceFolder}/.vscode-kdbg/run-qemu-gdb-myos2.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "USE_KVM": "0",
          "CPU_OPTS": "max",
          "GDB_PORT": "8864",
          "PIDFILE": "${workspaceFolder}/.qemu-myos2-tcg.pid",

          "OVMF_DIR": "${workspaceFolder}/myloader",
          "OVMF_VARS_OUT": "${workspaceFolder}/.vscode-kdbg/ovmf-vars-myos2-tcg.fd",

          "DISPLAY": "${env:DISPLAY}",
          "DISPLAY_OPTS": "-display gtk"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": [
        {
          "severity": "info",
          "pattern": [
            { "regexp": "^(qemu\\.task):(\\d+):\\s+(.*)$", "file": 1, "line": 2, "message": 3 }
          ],
          "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "READY" }
        }
      ]
    },
    {
      "label": "kill qemu (myos2 tcg)",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/.vscode-kdbg/kill-qemu-myos2.sh"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PIDFILE": "${workspaceFolder}/.qemu-myos2-tcg.pid" }
      },
      "problemMatcher": []
    }
  ]
}
