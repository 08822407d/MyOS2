// ST50 time@a039d9803ade | static control/value/event model only; runtime NOT_RUN
digraph ST50 {
  graph [rankdir=LR,labelloc=t,label="schedule_timeout: bounded source model"];
  node [shape=box,fontsize=10];
  a [label="schedule_timeout(long)"];
  max [label="timeout==MAX?"];
  sched [label="schedule()实际"];
  neg [label="timeout<0?"];
  run [label="TASK_RUNNING"];
  exp [label="expire=timeout+jiffies"];
  task [label="timer.task=current"];
  setup [label="timer_setup_on_stack"];
  mod [label="__mod_timer"];
  comment [label="// schedule()注释"];
  del [label="del_timer_sync"];
  destroy [label="destroy_timer_on_stack"];
  out [label="out return"];
  callback [label="process_timeout可选回调"];
  wake [label="wake_up_process请求"];
  public [label="wait_for_completion void"];
  wrapper [label="wait_for_common long"];
  core [label="do_wait done门"];
  action [label="action(MAX)"];
  repeat [label="!done&&timeout"];
  consume [label="done>0消费"];
  ms [label="msleep"];
  conv [label="msecs_to_jiffies"];
  loop [label="while(timeout)"];
  unint [label="schedule_timeout_uninterruptible"];
  state [label="TASK_UNINTERRUPTIBLE"];
  stop1 [label="STOP timer wheel"];
  stop2 [label="STOP scheduler"];
  stop3 [label="STOP task运行"];
  a -> max [label="control: switch",style=solid];
  max -> sched [label="control: MAX",style=solid];
  sched -> out [label="return: 正常返回后",style=solid];
  max -> neg [label="control: 非MAX",style=solid];
  neg -> run [label="control: 负值",style=solid];
  run -> out [label="control: goto",style=solid];
  neg -> exp [label="control: 非负",style=solid];
  exp -> task [label="control: 正常继续",style=solid];
  task -> setup [label="control: 正常继续",style=solid];
  setup -> mod [label="control: 正常继续",style=solid];
  mod -> comment [label="control: 正常继续",style=solid];
  comment -> del [label="control: 正常继续",style=solid];
  del -> destroy [label="control: 正常继续",style=solid];
  destroy -> out [label="control: 正常继续",style=solid];
  mod -> callback [label="possible: 异步候选",style=dashed];
  callback -> wake [label="control: 若回调执行",style=solid];
  mod -> stop1 [label="stop: 深入边界",style=dotted];
  sched -> stop2 [label="stop: 内部未知",style=dotted];
  wake -> stop3 [label="stop: 不是任务运行",style=dotted];
  public -> wrapper [label="call: void调用",style=solid];
  wrapper -> core [label="call: 传action",style=solid];
  core -> action [label="control: done0",style=solid];
  action -> a [label="call: MAX",style=solid];
  out -> repeat [label="return: MAX若未完成",style=solid];
  repeat -> core [label="loop: done0",style=dashed];
  repeat -> consume [label="control: done正",style=solid];
  ms -> conv [label="call: msecs",style=solid];
  conv -> loop [label="value: ulong",style=solid];
  loop -> unint [label="control: 非零",style=solid];
  unint -> state [label="control: 设状态",style=solid];
  state -> a [label="call: 返回long",style=solid];
  out -> loop [label="value: 赋回timeout",style=solid];
}
