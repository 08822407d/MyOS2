digraph OC39 {
  graph [rankdir=LR,label="CORE-USER-OPEN-COMPLETION-39 | fixed time | actual calls, contracts and premises",labelloc=t];
  node [shape=box,fontsize=9];
  sys [label="do_sys_open -> do_sys_openat2"];
  sys_build [label="build_open_flags(how,&op); result temporarily fd"];
  sys_name [label="getname: if error return"];
  sys_fd [label="fd=get_unused_fd_flags overwrites validation status"];
  sys_gate [label="fd>=0?",shape=diamond];
  sys_filp [label="f=do_filp_open(dfd,tmp,&op)"];
  sys_iserr [label="IS_ERR(f)?",shape=diamond];
  sys_errno [label="fd=PTR_ERR(f)"];
  install [label="fd_install(fd,f), if f normal"];
  sys_return [label="putname, return fd"];
  sys_name_error [label="IS_ERR(getname): return PTR_ERR(tmp) early"];
  khelper [label="file_open_name"];
  kbuild [label="build_open_flags checked by helper"];
  kerr [label="ERR_PTR(err) if helper validation error"];
  kfilp [label="do_filp_open helper call"];
  dofilp [label="do_filp_open; flags=op.lookup_flags"];
  pathopen [label="path_openat(nd,op,flags)"];
  op_open [label="op.open_flag (O_* domain)",shape=note];
  op_lookup [label="op.lookup_flags (LOOKUP_* domain)",shape=note];
  allocempty [label="alloc_empty_file(op.open_flag)"];
  allocfile [label="__alloc_file"];
  cache [label="kmem_cache_zalloc filp"];
  alloc_fail [label="ERR_PTR(-ENOMEM) on NULL"];
  alloc_success [label="f_count=1; f_flags=flags; f_mode=OPEN_FMODE(flags)"];
  fmode [label="f_mode low2 bits + FMODE_NONOTIFY",shape=note];
  fflags [label="f_flags retains selected open_flag",shape=note];
  early_iserr [label="path_openat IS_ERR(file)?",shape=diamond];
  early_return [label="return allocated error pointer"];
  pathinit [label="path_init nd/flags"];
  walk [label="while link_path_walk and open_last_lookups"];
  last [label="open_last_lookups uses lookup-flags named open_flag"];
  walkerr [label="link_path_walk returns nonzero int error"];
  walkdone [label="error==0 then do_open?",shape=diamond];
  doopen [label="do_open (int), calls vfs_open, NO return"];
  vfsopen [label="vfs_open (int), copy file.f_path=*path"];
  dentryopen [label="myos_do_dentry_open (int), NO return"];
  getpath [label="path_get(&file.f_path)"];
  setfields [label="file.f_inode=inode; f_mapping=inode.i_mapping; f_op=inode.i_fop"];
  ifopen [label="f_op && f_op.open?",shape=diamond];
  callback [label="call f_op.open(path.dentry.d_inode,file)"];
  fat32op [label="FAT32_file_ops.open=FAT32_open (static binding)"];
  fat32call [label="FAT32_open sets f_pos=0; returns1"];
  errlocal [label="error= -ENOERR or callback return (ulong)"];
  trunc [label="if(file.f_mode & O_TRUNC)?",shape=diamond];
  truncwrite [label="inode.i_size=0 conditional"];
  append [label="if(file.f_mode & O_APPEND)?",shape=diamond];
  appendwrite [label="file.f_pos=inode.i_size conditional"];
  dend [label="myos_do_dentry_open reaches end of int func without return"];
  vreturn [label="vfs_open returns callee result (not defined)"];
  doend [label="do_open reaches end of int func without return"];
  error_assign [label="path_openat error=do_open value (undefined contract)"];
  terminate [label="terminate_walk(nd)"];
  iszero [label="if(error==0)?",shape=diamond];
  success [label="return file if valid error exactly0; FMODE_OPENED check commented"];
  failure [label="fput(file); return ERR_PTR(error)"];
  fmopened [label="FMODE_OPENED: only commented gate in path_openat",shape=note];
  fput [label="fput dec count, may cache free"];
  failreturn [label="return ERR_PTR(error), if cleanup completes"];
  f_mapping [label="file.f_mapping is borrowed inode.i_mapping (not new object)",shape=note];
  path_valid [label="PREMISE: path, dentry,inode,mapping,files valid",shape=note];
  sb38 [label="SB38 root mapping / child containment not closed",shape=note];
  stop [label="STOP at invalid object/nonreturn/undefined consumed result",shape=octagon];
  notrun [label="No compiler, actual user open, fd table, mount or disk attested",shape=note];
  sys -> sys_build [label="actual build call"];
  sys_build -> sys_name [label="helper error ignored"];
  sys_name -> sys_fd [label="normal name"];
  sys_name -> sys_name_error [label="IS_ERR name, early return"];
  sys_fd -> sys_gate [label="fd overwritten"];
  sys_gate -> sys_filp [label="true"];
  sys_gate -> sys_return [label="false"];
  sys_filp -> dofilp [label="call"];
  sys_filp -> sys_iserr [label="returned filp"];
  sys_iserr -> sys_errno [label="true"];
  sys_iserr -> install [label="false, requires valid normal file"];
  sys_errno -> sys_return [label="update fd"];
  install -> sys_return [label="after install"];
  khelper -> kbuild [label="actual call"];
  kbuild -> kerr [label="nonzero err"];
  kbuild -> kfilp [label="zero err"];
  kfilp -> dofilp [label="actual call"];
  dofilp -> op_lookup [label="read lookup_flags"];
  op_lookup -> pathopen [label="flags argument"];
  dofilp -> pathopen [label="call"];
  pathopen -> op_open [label="read open_flag"];
  op_open -> allocempty [label="pass flags"];
  allocempty -> allocfile [label="actual call"];
  allocfile -> cache [label="actual kmem_cache_zalloc"];
  cache -> alloc_fail [label="NULL"];
  cache -> alloc_success [label="nonNULL"];
  alloc_fail -> early_iserr [label="return error"];
  alloc_success -> fflags [label="field write"];
  alloc_success -> fmode [label="field write"];
  fmode -> trunc [label="data: gate uses f_mode",style=dashed];
  fmode -> append [label="data: gate uses f_mode",style=dashed];
  alloc_success -> early_iserr [label="return normal file"];
  early_iserr -> early_return [label="IS_ERR true"];
  early_iserr -> pathinit [label="false"];
  pathinit -> walk [label="actual path walk"];
  walk -> last [label="when link walk returns zero and s evaluated"];
  last -> walk [label="nonNULL continuation, next iteration"];
  walk -> walkerr [label="nonzero error"];
  walk -> walkdone [label="loop end"];
  walkerr -> terminate [label="do_open skipped"];
  walkdone -> doopen [label="error==0"];
  walkdone -> terminate [label="error !=0"];
  doopen -> vfsopen [label="calls and discards result"];
  vfsopen -> dentryopen [label="return-expression invokes function"];

  dentryopen -> getpath [label="actual first steps"];
  getpath -> setfields [label="field writes"];
  setfields -> ifopen [label="after fields"];
  ifopen -> callback [label="true"];
  ifopen -> errlocal [label="false (initial error retained)"];
  fat32op -> callback [label="function-pointer binding only"];
  callback -> fat32call [label="only if table points to FAT32_open",style=dashed];
  fat32call -> errlocal [label="sets error=1"];
  callback -> errlocal [label="other callback normal return"];
  errlocal -> trunc [label="no return value check",style=dashed];
  trunc -> truncwrite [label="true; helper-only nonstandard mode bits",style=dashed];
  trunc -> append [label="false"];
  truncwrite -> append [label="after direct assignment"];
  append -> appendwrite [label="true; helper-only nonstandard mode bits",style=dashed];
  append -> dend [label="false"];
  appendwrite -> dend [label="after assignment"];
  dend -> vreturn [label="missing int return, cannot infer result",style=dashed];
  vreturn -> doend [label="do_open discards value and lacks own return"];
  doend -> error_assign [label="missing int return consumed",style=dashed];
  error_assign -> terminate [label="actual assignment but undefined result",style=dashed];
  terminate -> iszero [label="after cleanup if valid"];
  iszero -> success [label="true, requires defined error"];
  iszero -> failure [label="false, requires defined error"];
  failure -> fput [label="actual cleanup call"];
  fput -> failreturn [label="then ERR_PTR return"];
  fmopened -> success [label="commented, NOT an active guard",style=dashed];
  path_valid -> stop [label="failed analysis validity premise",style=dashed];
  sb38 -> path_valid [label="prior route unclosed",style=dashed];
  dend -> stop [label="normal no-return means no usable int value"];
  doend -> stop [label="normal no-return means no usable int value"];
  callback -> stop [label="if callback does not return normally"];
  setfields -> f_mapping [label="data alias",style=dashed];
  notrun -> stop [label="evidence boundary, not CPU control",style=dashed];
}
