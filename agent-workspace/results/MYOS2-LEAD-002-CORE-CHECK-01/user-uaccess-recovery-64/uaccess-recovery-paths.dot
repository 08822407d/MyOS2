digraph MYOS2_UACCESS_RECOVERY_64 {
 graph [rankdir=LR,labelloc=t,label="D00 documentary challenge; A source metadata; B bounded #PF call; C alternative source. Not full CFG"];
 node [shape=box]; edge [fontsize=9];
 subgraph cluster_D { label="D00 original source dispute";
   old [label="63 original C14/C15/C16 source text"];
   raw [label="time readdir.c L108–121"];
   match [label="3 original exact 5-line spans"];
   review [label="R63-01 review's blank-line accusation"];
   new [label="new D01/D02/D03/D04 exact sources"];
   pending [label="C05 has closure authority"];
 }
 subgraph cluster_A { label="A extable producer/linker";
   asm [label="asm.h extable macro"];
   uac [label="_ASM_EXTABLE_UA"];
   entry [label="__ex_table record declaration"];
   field1 [label="first .long field location"];
   field2 [label="second .long field location"];
   type [label="EX_TYPE_UACCESS symbolic"];
   copy [label="copy_user_generic inline asm"];
   labels [label="1b fault / 2b fixup labels"];
   script [label="target_kernel.cmake -T"];
   lds [label="selected kernel.lds"];
   sectiongap [label="no explicit extable output/bounds"];
   unknownelf [label="final ELF/linker orphan unknown",shape=octagon];
   consumer [label="fault.c selected consumer scan"];
   nofixup [label="no active extable lookup in chosen bodies"];
 }
 subgraph cluster_B { label="B kernel page fault routes";
   exc [label="exc_page_fault"];
   cr2 [label="read_cr2 address"];
   handle [label="handle_page_fault"];
   test [label="fault_in_kernel_space"];
   threshold [label="TASK_SIZE_MAX numeric comparison"];
   kern [label="do_kern_addr_fault"];
   kernloop [label="active while(1)"];
   user [label="do_user_addr_fault"];
   regs [label="user_mode(regs) control"];
   errbits [label="X86_PF_* fault flags"];
   mm [label="current/mm object"];
   vma [label="simple_find_vma"];
   bad [label="myos_bad_area"];
   diagnostic [label="kmalloc/parse/print"];
   badloop [label="diagnostic then while(1)"];
   mhandler [label="myos_handle_mm_fault"];
   once [label="one call then local fault"];
   zerof [label="fault == ENOERR"];
   nonzerof [label="while(fault!=ENOERR)"];
   usermissing [label="invalid VMA/mm STOP",shape=octagon];
   badctx [label="invalid regs/buffer STOP",shape=octagon];
   ptunknown [label="PTE/CPU retry not certified",shape=octagon];
 }
 subgraph cluster_C { label="C alt metadata/pacher search";
   alt [label="ALTERNATIVE producer macro"];
   oldinstr [label="OLDINSTR"];
   entryalt [label="ALTINSTR_ENTRY"];
   repl [label="ALTINSTR_REPLACEMENT"];
   metasec [label=".altinstructions metadata"];
   replsec [label=".altinstr_replacement candidate bytes"];
   flags [label="ALT_NOT feature mask"];
   callrep [label="call rep_movs_alternative string"];
   repmovs [label="rep movsb old text"];
   repbody [label="rep_movs body not found",shape=octagon];
   stac [label="stac wrapper"];
   clac [label="clac wrapper"];
   smap [label="SMAP feature candidates"];
   bugs [label="check_bugs"];
   cpu [label="cpu_init"];
   commented [label="alternative_instructions() commented"];
   patcher [label="runtime patcher not established"];
   norun [label="actual CPU patch and AC state unknown",shape=octagon];
 }
 old -> raw [label="DATA"];
