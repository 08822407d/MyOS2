// Static source and file provenance, fixed time@a039d9803ade. Graphviz NOT_RUN.
// DECLARED_INSTALL ≠ executed installer; SHELL_CP_REQUEST ≠ successful copy; INF_DECLARATION ≠ compiled module.
digraph UB99 {
 graph [rankdir=LR,label="UB99 UEFI module, artifact and installation provenance",labelloc=t];
 node [shape=box,fontsize=9]; edge [fontsize=8];
 subgraph cluster_A {label="A evidence matrices";
  inf [label="模块声明vs镜像生成身份缺环"];
  sources [label="C源与头文件的角色"];
  pkg [label="INF库类与包声明非解析结果"];
  libclass [label="INF重复头文件的含义上限"];
  efi_entry [label="实际C入口与协议调用"];
  cmake_loader [label="CMake3.16版本约束与配置结果分离"];
  entry_lib [label="入口类与机器码二进制未直接衔接"];
  tracked_efi [label="跟踪文件身份"];
  edk_output [label="外部Build输出文件与目标"];
  target_efi [label="CMake安装源与目标"];
  target_kernel [label="内核目标文件交付"];
 }
 subgraph cluster_B {label="B evidence matrices";
  uefi_types [label="UEFI基础类型来源"];
  elf_types [label="Elf64_Half和ELF内部乘积"];
  multiboot_alias [label="条件编译和类型目标宽度分开"];
  efi_page [label="外部整数宏的位宽"];
  assert_api [label="源码编译条件与断言实现"];
  include_chain [label="本地ELF_NEXT_ENTRY与外部类型"];
  kernel_flags [label="内核编译选项独立"];
  uefi_flags [label="EDK DEBUG_GCC5命名不足以证明实际工具链"];
 }
 subgraph cluster_C {label="C evidence matrices";
  runner [label="物理磁盘函数未被调用的限定"];
  kernel_fn [label="内核失败后的后缀"];
  initranfs_fn [label="中间阶段的目录和失败门"];
  loader_fn [label="bootloader后缀"];
  standalone_fn [label="独立EFI脚本不在主调用链"];
  failure_gate [label="配置/构建/复制/装入各自有条件停止点"];
  aux_efi [label="同一外部源的另存副本"];
  boot_request [label="内核安装→UEFI文件读取的跨阶段关系"];
  artifact_link [label="声明→对象→安装三类实体"];
 }
 subgraph cluster_evidence_stops {label="source actors and proof boundaries";
  rootvar [label="PROJ_ROOT=$(pwd), initial current directory",shape=box];
  main_script [label="make_install.sh calls three functions",shape=box];
  loader_cmake [label="myloader/CMakeLists.txt",shape=box];
  kernel_cmake [label="mykernel CMake + target_kernel.cmake",shape=box];
  source_inf [label="myloader/uefi/bootloader.inf",shape=box];
  source_uefi [label="bootloader.c UefiMain",shape=box];
  edk_dsc [label="Unknown DSC + selected EDK library implementations",shape=octagon];
  compiler [label="Unknown actual UEFI toolchain and binary",shape=box];
  tracked_binary [label="time tracked myloader/BOOTX64.EFI 19200B",shape=box];
  edk_binary [label="External Build/Shell/DEBUG_GCC5/.../bootloader.efi",shape=box];
  esp_path [label="/mnt/EFI/BOOT/BOOTX64.EFI target",shape=box];
  kernel_path [label="/mnt/boot/kernel target",shape=box];
  aux_path [label="~/projs/MyOS2/elfbinary_loader.efi target",shape=box];
  shell_cwd [label="Bash function cd changes current directory",shape=box];
  mount [label="/dev/dm-0 mounted at /mnt? NOT_RUN",shape=box];
  firmware [label="UEFI FileInfo, Read, entry NOT_RUN",shape=box];
  stop [label="PROOF STOP: source, ABI, mount, bytes, and status",shape=octagon];
  history [label="R85/R98 qualified IDs retained; no D00",shape=box];
 }
 main_script -> runner [label="SHELL_SOURCE: top-level calls and variables",color=gray];
 runner -> rootvar [label="DATA: pwd to PROJ_ROOT",color=gray];
 rootvar -> shell_cwd [label="WORKDIR_ASSUMPTION: relative source and build tree",color=gray];
 runner -> kernel_fn [label="SHELL_CALL: make_install_kernel",color=blue];
 runner -> initranfs_fn [label="SHELL_CALL: make_install_initranfs",color=blue];
 runner -> loader_fn [label="SHELL_CALL: make_install_bootloader",color=blue];
 kernel_fn -> shell_cwd [label="SHELL_CD: cd $1/build/mykernel",color=gray];
 initranfs_fn -> shell_cwd [label="SHELL_CD: cd $1/build/myinitramfs",color=gray];
 loader_fn -> shell_cwd [label="SHELL_CD: cd $1/build/bootloader",color=gray];
 shell_cwd -> stop [label="PROOF_BOUNDARY: actual cwd not observed",color=red,style=dashed];
 kernel_fn -> mount [label="MOUNT_REQUEST: mount before rm and cmake",color=darkorange,style=dashed];
 initranfs_fn -> mount [label="MOUNT_REQUEST: mount before cmake",color=darkorange,style=dashed];
 loader_fn -> mount [label="MOUNT_REQUEST: mount before cmake",color=darkorange,style=dashed];
 standalone_fn -> mount [label="MOUNT_REQUEST: independent install_loader.sh",color=darkorange,style=dashed];
 mount -> failure_gate [label="PROOF_BOUNDARY: mount result not guarded",color=red,style=dashed];
 failure_gate -> stop [label="PROOF_BOUNDARY: cannot assume safe installation state",color=red,style=dashed];
 kernel_fn -> kernel_cmake [label="CMAKE_REQUEST: configure then make and install",color=gray];
 loader_fn -> loader_cmake [label="CMAKE_REQUEST: configure then make and install",color=gray];
 kernel_cmake -> target_kernel [label="DECLARED_TARGET: kernel install(TARGETS)",color=purple];
 target_kernel -> kernel_path [label="DECLARED_INSTALL: prefix /mnt plus boot",color=darkorange,style=dashed];
 loader_cmake -> cmake_loader [label="RECIPE_FILE: project and install PROGRAMS",color=gray];
 loader_cmake -> tracked_binary [label="DECLARED_INSTALL_SOURCE: relative BOOTX64.EFI",color=darkorange,style=dashed];
 tracked_binary -> tracked_efi [label="GITHUB_METADATA: only Git blob SHA and size",color=gray];
 tracked_binary -> esp_path [label="CONDITIONAL_INSTALL: CMake PROGRAMS not observed",color=darkorange,style=dashed];
 esp_path -> target_efi [label="TARGET_PATH: path text not real installed bytes",color=gray];
 kernel_path -> boot_request [label="PATH_TEXT_JOIN: same boot/kernel components",color=gray];
 boot_request -> firmware [label="DATA_HANDOFF: UEFI file read not called by script",color=gray];
 firmware -> stop [label="PROOF_BOUNDARY: FileInfo and Read bytes unknown",color=red,style=dashed];
 source_inf -> inf [label="INF_DECLARATION: module type and entry",color=purple];
 source_inf -> sources [label="INF_DECLARATION: 15 entries, one duplicate",color=purple];
 source_inf -> pkg [label="INF_DECLARATION: four package names",color=purple];
 source_inf -> libclass [label="INF_DECLARATION: ten library class names",color=purple];
 source_inf -> entry_lib [label="INF_DECLARATION: UefiApplicationEntryPoint",color=purple];
 sources -> source_uefi [label="SOURCE_LIST_INTENT: bootloader.c named",color=gray];
 source_uefi -> efi_entry [label="FUNCTION_DEFINITION: EFIAPI UefiMain",color=gray];
 efi_entry -> entry_lib [label="UNVERIFIED_WRAPPER: ENTRY_POINT != proven PE entry",color=red,style=dashed];
 entry_lib -> edk_dsc [label="EXTERNAL_SELECTION_REQUIRED: library instance unknown",color=gray];
 pkg -> edk_dsc [label="EXTERNAL_SELECTION_REQUIRED: package version unknown",color=gray];
 libclass -> edk_dsc [label="EXTERNAL_SELECTION_REQUIRED: mapping unknown",color=gray];
 edk_dsc -> compiler [label="PROOF_BOUNDARY: actual flags not retrieved",color=red,style=dashed];
 compiler -> tracked_binary [label="UNKNOWN_BUILD_PROVENANCE: no source machine-code equality proof",color=red,style=dashed];
 compiler -> edk_binary [label="UNKNOWN_BUILD_PROVENANCE: DEBUG_GCC5 name is not actual compiler",color=red,style=dashed];
 standalone_fn -> edk_binary [label="SHELL_SOURCE_PATH: relative Build/Shell location",color=gray];
 edk_binary -> edk_output [label="EXTERNAL_ARTIFACT_PATH: not tracked Git blob",color=gray];
 edk_binary -> esp_path [label="SHELL_CP_REQUEST: cp to BOOTX64.EFI target",color=darkorange,style=dashed];
 edk_binary -> aux_path [label="SHELL_CP_REQUEST: second cp to auxiliary file",color=darkorange,style=dashed];
 aux_path -> aux_efi [label="TARGET_PATH: other destination",color=gray];
 tracked_binary -> artifact_link [label="SOURCE_IDENTITY_GAP: two possible ESP inputs",color=gray];
 edk_binary -> artifact_link [label="SOURCE_IDENTITY_GAP: different origin, no equality",color=gray];
 artifact_link -> stop [label="PROOF_BOUNDARY: not same bytes",color=red,style=dashed];
 include_chain -> uefi_types [label="INCLUDE_REQUEST: not the actual external definitions",color=gray];
 uefi_types -> elf_types [label="TYPE_USE: UINTN and Elf64_Half",color=gray];
 multiboot_alias -> uefi_types [label="CONDITIONAL_TYPEDEF: PI_UEFI branch selection unknown",color=gray];
 elf_types -> efi_page [label="ASSUMPTION: integer promotion and alignment types",color=gray];
 efi_page -> compiler [label="UNKNOWN_MACRO_TYPE: external EFI_PAGE_SIZE",color=red,style=dashed];
 assert_api -> edk_dsc [label="UNKNOWN_LIB_INSTANCE: DebugLib not resolved",color=red,style=dashed];
 kernel_flags -> uefi_flags [label="NOT_EQUAL: kernel mabi=sysv not evidence EFI ABI",color=red,style=dashed];
 uefi_flags -> compiler [label="UNKNOWN_TOOLCHAIN: actual UEFI flags not run",color=red,style=dashed];
 history -> stop [label="HISTORY_LIMIT: R98-S01-03 R85-S01-03",color=gray];
 standalone_fn -> stop [label="PROOF_BOUNDARY: none of mount or cp executed",color=red,style=dashed];
 tracked_binary -> stop [label="PROOF_BOUNDARY: binary byte read forbidden",color=red,style=dashed];
}
