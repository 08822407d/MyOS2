// CORE-USER-SEMAPHORE-TIMEOUT-51 static conditional graph, NOT_RUN
digraph SM51 {
 graph [rankdir=LR,label="semaphore wait/grant bounded source paths"];
 node [shape=box];
 entry [label="down_timeout"];
 lock [label="outer lock"];
 gate [label="count>0"];
 fast [label="count--"];
 wrap [label="__down_timeout"];
 common [label="__down_common"];
 slow [label="___down_common"];
 queue [label="append waiter"];
 init [label="task=current up=false"];
 signal [label="signal_pending_state?"];
 timeout [label="timeout<=0?"];
 state [label="set state"];
 unlock [label="unlock_irq"];
 action [label="schedule_timeout"];
 relock [label="lock_irq"];
 grant [label="waiter.up?"];
 success [label="ret0"];
 sdel [label="signal list_del"];
 eintr [label="ret-EINTR"];
 tdel [label="timeout list_del"];
 etime [label="ret-ETIME"];
 rslow [label="propagate int"];
 ounlock [label="outer unlock"];
 ret [label="return result"];
 up [label="up"];
 uplock [label="up lock"];
 empty [label="queue empty?"];
 inc [label="count++"];
 choose [label="head waiter"];
 del [label="unlink"];
 flag [label="up=true"];
 wake [label="wake request"];
 upunlock [label="up unlock"];
 upret [label="void"];
 stops [label="STOP scheduler"];
 stopw [label="STOP wake"];
 entry -> lock [label="call",style=solid];
 lock -> gate [label="test",style=solid];
 gate -> fast [label="true",style=solid];
 fast -> ounlock [label="fast result0",style=solid];
 gate -> wrap [label="false",style=solid];
 wrap -> common [label="call",style=solid];
 common -> slow [label="call",style=solid];
 slow -> queue [label="enqueue",style=solid];
 queue -> init [label="fields",style=solid];
 init -> signal [label="loop",style=solid];
 signal -> sdel [label="true generic",style=solid];
 sdel -> eintr [label="return",style=solid];
 signal -> timeout [label="false",style=solid];
 timeout -> tdel [label="<=0",style=solid];
 tdel -> etime [label="return",style=solid];
 timeout -> state [label=">0",style=solid];
 state -> unlock [label="state written",style=solid];
 unlock -> action [label="call",style=solid];
 action -> relock [label="normal return",style=solid];
 relock -> grant [label="check flag",style=solid];
 grant -> success [label="true",style=solid];
 grant -> signal [label="false next loop",style=dashed];
 success -> rslow [label="propagate",style=solid];
 eintr -> rslow [label="propagate",style=solid];
 etime -> rslow [label="propagate",style=solid];
 rslow -> ounlock [label="wrapper return",style=solid];
 ounlock -> ret [label="return int",style=solid];
 up -> uplock [label="lock",style=solid];
 uplock -> empty [label="test",style=solid];
 empty -> inc [label="true",style=solid];
 inc -> upunlock [label="count++",style=solid];
 empty -> choose [label="false",style=solid];
 choose -> del [label="first",style=solid];
 del -> flag [label="set true",style=solid];
 flag -> wake [label="request",style=solid];
 wake -> upunlock [label="if normal return",style=solid];
 upunlock -> upret [label="return",style=solid];
 flag -> grant [label="cross-context only after waiter relocks",style=dashed];
 action -> stops [label="scope opaque",style=dotted];
 wake -> stopw [label="scope opaque",style=dotted];
}
