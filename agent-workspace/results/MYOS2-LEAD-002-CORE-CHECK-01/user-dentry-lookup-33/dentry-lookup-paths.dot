digraph DL33 {
  graph [label="CORE-USER-DENTRY-LOOKUP-33 | pinned time static contract",labelloc=t,rankdir=LR];
  node [shape=box];
  parent [label="parent dentry"];
  query [label="qstr name,len"];
  child_list [label="parent.d_subdirs"];
  candidate [label="candidate via d_child"];
  compare [label="strncmp(query.name,candidate.name,query.len)"];
  length_gate [shape=note,label="candidate d_name.len == query.len NOT checked"];
  fast_hit [label="first predicate match"];
  fast_null [label="NULL fast miss"];
  walk [label="walk_component"];
  open [label="open_last_lookups"];
  open_gate [shape=diamond,label="!(lookup_flags & O_CREAT)? actual test"];
  slow [label="__lookup_slow"];
  allocator [label="__myos_d_alloc"];
  object_alloc [label="kzalloc dentry"];
  name_alloc [label="kzalloc len+1 name buffer"];
  oom [label="ERR_PTR(-ENOMEM)"];
  init [label="name memcpy, inode=NULL, list init"];
  callback [label="inode_ops.lookup(inode,original,flags)"];
  callback_null [shape=diamond,label="callback result == NULL?"];
  cb_nullexit [label="kfree original; ERR_PTR(-ENOENT)"];
  cb_nonnull [label="nonNULL, callback pointer ignored after check"];
  valid_original [shape=diamond,label="original.d_inode + mapping valid? ANALYSIS PREMISE"];
  stop [shape=octagon,label="STOP at invalid or indeterminate access"];
  original_inode [label="read original.d_inode"];
  map_update [label="nrpages, conditional page_array kzalloc"];
  publish [label="append original to parent list; parent=dir"];
  return_orig [label="return original allocated dentry"];
  error_cast [label="IS_ERR => ERR_CAST"];
  step [label="step_into(dentry)"];
  outer [label="outer pointer/int loop per R31,R32"];
  parent -> child_list [label="data"];
  child_list -> candidate [label="actual list iteration"];
  query -> compare [label="name and query length"];
  candidate -> compare [label="candidate name bytes"];
  length_gate -> compare [style=dashed,label="missing check, not an actual gate"];
  compare -> fast_hit [label="==0 first match"];
  compare -> fast_null [label="no match before anchor"];
  fast_hit -> walk [label="fast result"];
  fast_hit -> open [label="guarded fast result"];
  fast_null -> slow [label="fast NULL triggers slow"];
  walk -> slow [label="NULL branch"];
  open -> open_gate [label="actual control gate"];
  open_gate -> fast_null [label="true: fast+slow lookup path"];
  open_gate -> stop [style=dashed,label="false: possible unassigned dentry, old LC32"];
  slow -> allocator [label="allocate"];
  allocator -> object_alloc [label="first kzalloc"];
  object_alloc -> oom [label="NULL"];
  object_alloc -> name_alloc [label="nonNULL"];
  name_alloc -> oom [label="NULL then free object"];
  name_alloc -> init [label="normal bytes and object setup"];
  init -> callback [label="passes original"];
  callback -> callback_null [label="only NULL comparison"];
  callback_null -> cb_nullexit [label="true"];
  callback_null -> cb_nonnull [label="false"];
  cb_nonnull -> valid_original [label="actual original field consumption"];
  valid_original -> stop [style=dashed,label="invalid premise"];
  valid_original -> original_inode [label="valid premise"];
  original_inode -> map_update [label="field reads/updates"];
  map_update -> publish [label="normal completion"];
  publish -> return_orig [label="returns original"];
  oom -> error_cast [label="IS_ERR"];
  cb_nullexit -> error_cast [label="IS_ERR"];
  return_orig -> step [label="nonerror upper consumer"];
  fast_hit -> step [label="nonerror upper consumer"];
  error_cast -> outer [label="encoded pointer"];
  step -> outer [label="conditional pointer result"];
}