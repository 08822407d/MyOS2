// Source-only conditional relations, not actual compiled kernel CFG.
digraph BI55 {
 graph [rankdir=LR,label="Block IO consumption 55"];
 node [shape=box,fontsize=10];
 Am [label="ROOTBLK branch"];
 An [label="NVMe long"];
 Aa [label="ATA long"];
 Ar [label="FAT read block"];
 Ae [label="read error"];
 Ac [label="copy residue ignored"];
 Ap [label="read count return"];
 Aw [label="FAT write block"];
 Anw [label="new cluster sector0"];
 Awe [label="write error"];
 Awp [label="write progress"];
 As [label="STOP bad object"];
 Bi [label="iobuf init"];
 Br [label="readent miss"];
 Bh [label="cache hit"];
 Bl [label="ROOTBLK ignored"];
 Bp [label="publish buffers"];
 Bw [label="write flags DIRTY"];
 Bf [label="flag equality"];
 Bx [label="release void"];
 Bfw [label="DIRTY write ignored"];
 Bd [label="DELETE FAT write ignored"];
 Bfree [label="free objects"];
 Bs [label="STOP bounds"];
 Cg [label="FAT getter memset"];
 Crd [label="read result ignored"];
 Cv [label="u32 masked"];
 Cf [label="finder memset512"];
 Cfr [label="read result ignored"];
 Cval [label="free candidate"];
 Cs [label="FAT setter"];
 Cw [label="NumFATs writes"];
 C1 [label="return u64 1"];
 Cc [label="get_cluster_chain"];
 Cd [label="dir consumer"];
 Cstop [label="STOP data"];
 Am -> An [label="IF_NVME",style=solid];
 Am -> Aa [label="ELSE",style=solid];
 Ar -> Ae [label="NONZERO",style=solid];
 Ar -> Ac [label="ZERO",style=solid];
 Ac -> Ap [label="RESIDUE_IGNORED",style=solid];
 Anw -> Aw [label="VALID_CLUSTER",style=solid];
 Aw -> Awe [label="NONZERO",style=solid];
 Aw -> Awp [label="ZERO",style=solid];
 Ar -> As [label="STOP",style=dotted];
 Aw -> As [label="STOP",style=dotted];
 Bi -> Br [label="CALL",style=solid];
 Br -> Bh [label="HIT",style=solid];
 Br -> Bl [label="MISS",style=solid];
 Bl -> Bp [label="IGNORED",style=solid];
 Bp -> Bw [label="SAME_IOBUF",style=dashed];
 Bh -> Bw [label="SAME_IOBUF",style=dashed];
 Bw -> Bf [label="OR_DIRTY",style=solid];
 Bf -> Bx [label="CALL_LATER",style=solid];
 Bx -> Bfw [label="FLAG1",style=solid];
 Bx -> Bd [label="FLAG2",style=solid];
 Bfw -> Bfree [label="NORMAL",style=solid];
 Bd -> Bfree [label="NORMAL",style=solid];
 Bx -> Bfree [label="OTHER",style=solid];
 Bw -> Bs [label="STOP",style=dotted];
 Bfree -> Bs [label="STOP",style=dotted];
 Cg -> Crd [label="CALL",style=solid];
 Crd -> Cv [label="IGNORED",style=solid];
 Cf -> Cfr [label="CALL",style=solid];
 Cfr -> Cval [label="IGNORED",style=solid];
 Cs -> Cw [label="CALL",style=solid];
 Cw -> C1 [label="FIXED1",style=solid];
 Cv -> Cc [label="CONSUMED",style=dashed];
 Cval -> Cd [label="CONSUMED",style=dashed];
 C1 -> Cd [label="IGNORED",style=solid];
 Cv -> Cstop [label="STOP",style=dotted];
 Cval -> Cstop [label="STOP",style=dotted];
 C1 -> Cstop [label="STOP",style=dotted];
}
