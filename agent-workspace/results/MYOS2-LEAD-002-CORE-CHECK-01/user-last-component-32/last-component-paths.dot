// LC32, fixed time@a039d9803ade, static only, NOT_RUN.
// Distinguish real call/assignment gates from analysis-only premises.
// Return of link_path_walk is int. Return of lookup_last and open_last_lookups
// is const char*: NULL, ERR_PTR, or hypothetical normal continuation.
// ERR_PTR(-ENOERR) == ERR_PTR(0) == NULL in this selected source.
// O_CREAT==LOOKUP_RCU==0x40 numerically, but op.intent and
// op.lookup_flags are different objects. Valid build_open_flags does
// not establish an actual LOOKUP_RCU caller for open_last_lookups.
// Only source direct function calls have call/conditional_call edges.
// No dcache/mount/permission/CPU success inferred.
digraph LAST_COMPONENT_32 {
  graph [rankdir=LR, labelloc=t, fontsize=12, label="LC32: component metadata / dispatch / pointer return / integer consumption"];
  node [fontsize=10, shape=box];
  linkwalk [label="link_path_walk() -> int", shape=box];
  walkcomp [label="walk_component() -> const char*", shape=box];
  lastlookup [label="lookup_last() -> const char*", shape=box];
  openlast [label="open_last_lookups() -> const char*", shape=box];
  handledots [label="handle_dots() -> const char*", shape=box];
