digraph FS45 {
  rankdir=LR;
  graph [label="FS45 taskfs context: real gates and returns vs analytic prerequisites; no kernel runtime",labelloc=t];
  node [fontname="sans",shape=box];
  S0 [label="static init_task.fs = &init_fs",shape=box,style=solid];
  S1 [label="static init_fs users=1 umask=0022",shape=box,style=solid];
  S2 [label="dynamic fs_cachep created by proc_caches_init",shape=box,style=solid];
  P0 [label="copy_process: valid p from dup_task_struct; p.fs pointer preseed",shape=box,style=solid];
  P1 [label="copy_files completed normally before copy_fs",shape=box,style=dashed];
  P2 [label="copy_fs(flags,p) call",shape=box,style=solid];
  P3 [label="SOURCE: if(retval) after copy_fs",shape=diamond,style=solid];
  P4 [label="bad_fork_cleanup_files: exit_files(p), skipping exit_fs",shape=box,style=solid];
  P5 [label="later copy_sighand return check",shape=diamond,style=solid];
  P6 [label="bad_fork_cleanup_fs: exit_fs(p)",shape=box,style=solid];
  P7 [label="fallthrough bad_fork_cleanup_files",shape=box,style=solid];
  P8 [label="normal success continues later fork work",shape=box,style=solid];
  F0 [label="copy_fs: fs=current->fs",shape=box,style=solid];
  F1 [label="SOURCE: clone_flags & CLONE_FS",shape=diamond,style=solid];
  F2 [label="ANALYTIC: current.fs is valid, users represent valid positive count",shape=box,style=dashed];
  F3 [label="SOURCE: if(fs->in_exec)",shape=diamond,style=solid];
  F4 [label="return -EAGAIN; no users++",shape=box,style=solid];
  F5 [label="fs->users++ ordinary int",shape=box,style=solid];
  F6 [label="return0 shared; no local tsk.fs assignment",shape=box,style=solid];
  F7 [label="tsk->fs = copy_fs_struct(fs) returned pointer",shape=box,style=solid];
  F8 [label="SOURCE: if(!tsk->fs)",shape=diamond,style=solid];
  F9 [label="return -ENOMEM, tsk.fs already NULL",shape=box,style=solid];
  F10 [label="return0 for valid newfs",shape=box,style=solid];
  F11 [label="STOP: invalid fs->in_exec before error return",shape=octagon,style=solid];
  A0 [label="copy_fs_struct(old) alloc fs_cachep, GFP_KERNEL",shape=box,style=solid];
  A1 [label="SOURCE: if(fs_new)",shape=diamond,style=solid];
  A2 [label="return NULL (no old member read)",shape=box,style=solid];
  A3 [label="newfs.users=1; in_exec=0",shape=box,style=solid];
  A4 [label="spin_lock_init(newfs.lock)",shape=box,style=solid];
  A5 [label="newfs.umask = old.umask BEFORE old lock",shape=box,style=solid];
  A6 [label="spin_lock(old.lock)",shape=box,style=solid];
  A7 [label="newfs.root=old.root (value-copy path_s)",shape=box,style=solid];
  A8 [label="path_get(&newfs.root)",shape=box,style=solid];
  A9 [label="wrapper dget(root.dentry) active; mntget comment",shape=box,style=solid];
  A10 [label="newfs.pwd=old.pwd (value-copy path_s)",shape=box,style=solid];
  A11 [label="path_get(&newfs.pwd)",shape=box,style=solid];
  A12 [label="wrapper dget(pwd.dentry) active; mntget comment",shape=box,style=solid];
  A13 [label="spin_unlock(old.lock)",shape=box,style=solid];
  A14 [label="return newfs",shape=box,style=solid];
  A15 [label="STOP: invalid old/root/pwd or path_get nonreturn",shape=octagon,style=solid];
  A16 [label="path_s has mnt,dentry pointers; not deep-copy",shape=box,style=solid];
  E0 [label="exit_fs(tsk), valid task prerequisite",shape=box,style=solid];
  E1 [label="save fs=tsk->fs BEFORE task_lock",shape=box,style=solid];
  E2 [label="SOURCE: if(fs)",shape=diamond,style=solid];
  E3 [label="fs NULL: return without users change",shape=box,style=solid];
  E4 [label="task_lock(tsk)",shape=box,style=solid];
  E5 [label="spin_lock(fs.lock)",shape=box,style=solid];
  E6 [label="tsk->fs=NULL",shape=box,style=solid];
  E7 [label="kill=!--fs->users",shape=diamond,style=solid];
  E8 [label="spin_unlock(fs.lock); task_unlock(tsk)",shape=box,style=solid];
  E9 [label="SOURCE: if(kill)",shape=diamond,style=solid];
  E10 [label="not last: no free_fs_struct",shape=box,style=solid];
  E11 [label="free_fs_struct(fs)",shape=box,style=solid];
  E12 [label="path_put(&fs.root)",shape=box,style=solid];
  E13 [label="wrapper dput(root.dentry) active; mntput comment",shape=box,style=solid];
  E14 [label="path_put(&fs.pwd)",shape=box,style=solid];
  E15 [label="wrapper dput(pwd.dentry) active; mntput comment",shape=box,style=solid];
  E16 [label="kmem_cache_free(fs_cachep,fs) REQUEST only",shape=box,style=solid];
  E17 [label="return if all invoked callees normal",shape=box,style=solid];
  E18 [label="STOP: invalid fs/path or nonreturn cleanup",shape=octagon,style=solid];
  E19 [label="ANALYTIC: valid positive users and no other writers",shape=box,style=dashed];
  E20 [label="ANALYTIC origin: static init_fs, last users path",shape=box,style=dashed];
  E21 [label="ANALYTIC origin: dynamic newfs from fs_cachep",shape=box,style=dashed];
  T0 [label="taskfs.users=int, not files.refcount or file.f_count",shape=box,style=dashed];
  S0 -> S1 [label="DATA: static pointer provenance",style=solid];
  S0 -> P0 [label="ANALYTIC: only if current identity actually uses init_fs",style=dashed];
  P0 -> P1 [label="SOURCE: normal predecessor",style=solid];
  P1 -> P2 [label="SOURCE: copy_fs after copy_files",style=solid];
  P2 -> F0 [label="CALL: enter helper",style=solid];
