  F1 -> F2 [label="SOURCE: CLONE_FS true, require valid fs",style=solid];
  F2 -> F3 [label="ANALYTIC: valid",style=dashed];
  F2 -> F11 [label="ANALYTIC: invalid fs object",style=dashed];
  F3 -> F4 [label="SOURCE: in_exec nonzero",style=solid];
  F3 -> F5 [label="SOURCE: in_exec zero",style=solid];
  F5 -> F6 [label="SOURCE: source",style=solid];
  F1 -> A0 [label="SOURCE: CLONE_FS false",style=solid];
  A0 -> A1 [label="SOURCE: allocation returned",style=solid];
  A1 -> A2 [label="SOURCE: NULL",style=solid];
  A1 -> A3 [label="SOURCE: valid newfs",style=solid];
  A3 -> A4 [label="SOURCE: source",style=solid];
  A4 -> A5 [label="SOURCE: source",style=solid];
  A5 -> A15 [label="ANALYTIC: old invalid before lock",style=dashed];
  A5 -> A6 [label="SOURCE: old valid",style=solid];
  A6 -> A7 [label="SOURCE: lock normal",style=solid];
  A7 -> A8 [label="SOURCE: source",style=solid];
  A8 -> A9 [label="CALL: actual wrapper",style=solid];
  A9 -> A15 [label="ANALYTIC: dget does not return or invalid dentry",style=dashed];
  A9 -> A10 [label="RETURN: root path_get normal",style=solid];
  A10 -> A11 [label="SOURCE: source",style=solid];
  A11 -> A12 [label="CALL: second wrapper",style=solid];
  A12 -> A15 [label="ANALYTIC: invalid pwd or dget nonreturn",style=dashed];
  A12 -> A13 [label="RETURN: pwd path_get normal",style=solid];
  A13 -> A14 [label="SOURCE: unlock normal",style=solid];
  A16 -> A7 [label="DATA: structure value copied",style=solid];
  A16 -> A10 [label="DATA: pointee not deep-copied",style=solid];
  S2 -> A0 [label="DATA: cache origin",style=solid];
  A2 -> F7 [label="RETURN: NULL pointer returned",style=solid];
  A14 -> F7 [label="RETURN: valid newfs returned",style=solid];
  F7 -> F8 [label="SOURCE: source",style=solid];
  F8 -> F9 [label="SOURCE: NULL",style=solid];
  F8 -> F10 [label="SOURCE: nonNULL, requires valid newfs",style=solid];
  F4 -> P3 [label="RETURN: -EAGAIN",style=solid];
  F6 -> P3 [label="RETURN: 0",style=solid];
  F9 -> P3 [label="RETURN: -ENOMEM",style=solid];
  F10 -> P3 [label="RETURN: 0",style=solid];
  P3 -> P4 [label="GOTO: error: goto cleanup_files, skip exit_fs",style=solid];
  P3 -> P5 [label="SOURCE: copy_fs returned0",style=solid];
  P5 -> P6 [label="GOTO: copy_sighand failed -> cleanup_fs",style=solid];
  P5 -> P8 [label="SOURCE: copy_sighand succeeded; later path opaque",style=solid];
  P6 -> E0 [label="CALL: exit_fs definition",style=solid];
  E0 -> E1 [label="SOURCE: source",style=solid];
  E1 -> E2 [label="SOURCE: source",style=solid];
  E2 -> E3 [label="SOURCE: NULL fs",style=solid];
  E2 -> E19 [label="ANALYTIC: nonNULL must be valid",style=dashed];
  E19 -> E4 [label="SOURCE: valid",style=solid];
  E19 -> E18 [label="ANALYTIC: invalid/zero/overflow prerequisites",style=dashed];
  E4 -> E5 [label="SOURCE: task lock normal",style=solid];
  E5 -> E6 [label="SOURCE: fs lock normal",style=solid];
  E6 -> E7 [label="SOURCE: source",style=solid];
  E7 -> E8 [label="SOURCE: kill assigned after pre-decrement",style=solid];
  E8 -> E9 [label="SOURCE: unlocks normal",style=solid];
  E9 -> E10 [label="SOURCE: kill false",style=solid];
  E9 -> E11 [label="SOURCE: kill true",style=solid];
  E11 -> E12 [label="CALL: free_fs_struct starts",style=solid];
  E12 -> E13 [label="CALL: path_put wrapper",style=solid];
  E13 -> E18 [label="ANALYTIC: dput nonreturn/invalid",style=dashed];
