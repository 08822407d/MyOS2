digraph NP36 {
  graph [label="CORE-USER-FAT-NAME-PARSE-36 | pinned time, actual gates and analytical premises",rankdir=LR];
  node [shape=box,fontsize=9];
  lookup [label="FAT32_lookup enters"];
  outer [label="outer while cursor<L and getter !IS_ERR?",shape=diamond];
  getter [label="get_full_ent returns directory entry"];
  tmpde [label="valid tmpde and shared cursor"];
  aux [label="tmplde=readent(shared cursor-2E)"];
  empty [label="empty tmpde?",shape=diamond];
  select [label="long marker on auxiliary tmplde?",shape=diamond];
  short [label="parse_short"];
  short_init [label="*namelen=0; kzalloc(15)"];
  short_base [label="base loop x<8, copy bytes and maybe add32"];
  short_dir [label="directory bit set?",shape=diamond];
  short_dot [label="non-dir appends dot"];
  short_ext [label="extension loop x=8..10"];
  short_undo [label="x==8 undo dot and set NUL"];
  short_ret [label="return short ret_val"];
  long [label="parse_long"];
  long_cursor [label="i=0, local cursor=shared-2E"];
  long_read [label="lde_tmp=readent(local cursor)"];
  long_gate [label="while attr long, nonempty, cursor>=0?",shape=diamond];
  long_count [label="i++ and test id&0x40"];
  long_back [label="cursor-=E; readent"];
  long_alloc [label="kzalloc(i*13+1)"];
  long_reset [label="reset local cursor; lde=readent"];
  long_for [label="for x<i?",shape=diamond];
  long_units [label="three byte arrays, 13 u16 units"];
  long_write [label="accepted u16 -> one low-address byte; ++namelen"];
  long_update [label="x++,cursor-=E,lde=readent even last"];
  long_ret [label="return long ret_val"];
  readent [label="FAT32_iobuf_readent actual call"];
  shared [label="iobuf.iter_cursor (data field, not callee)"];
  cache [label="readent may populate cache"];
  namelen0 [label="lookup sets namelen=0 before call"];
  name [label="parse return assigned to name"];
  max [label="int len=max(namelen,destlen)"];
  cmp [label="equal=!strncmp(name,destname,size_t len)"];
  free [label="kfree(name)"];
  equal [label="if(equal)?",shape=diamond];
  next [label="next while iteration"];
  break [label="break while"];
  post [label="after while: IS_ERR or inode path"];
  end_err [label="getter ERR_PTR; no parser"];
  premise [label="ANALYSIS PREMISE: pointers/size/zeroing/valid data",shape=note];
  stop [label="STOP at invalid access or nonreturn",shape=octagon];
  no_cursor [label="parse/readent no direct shared cursor write",shape=note];
  nul [label="NUL tail if zero-filled successful allocation",shape=note];
  lookup -> outer [label="actual"];
  outer -> getter [label="true"];
  outer -> post [label="false skips loop body"];
  getter -> end_err [label="ERR_PTR"];
  end_err -> post [label="loop exits then post"];
  getter -> tmpde [label="nonerror and valid"];
  tmpde -> aux [label="actual aux read"];
  aux -> readent [label="function call"];
  aux -> empty [label="after readent"];
  empty -> next [label="true: continue"];
  empty -> select [label="false"];
  select -> short [label="not long"];
  select -> long [label="long slot predicate true"];
  lookup -> namelen0 [label="local declaration"];
  namelen0 -> short [label="source of argument",style=dashed];
  namelen0 -> long [label="source of argument",style=dashed];
  short -> short_init [label="entry and allocation"];
  short_init -> short_base [label="if output writable"];
  short_base -> short_dir [label="loop finished"];
  short_dir -> short_ret [label="true"];
  short_dir -> short_dot [label="false"];
  short_dot -> short_ext [label="continue"];
  short_ext -> short_undo [label="x==8"];
  short_ext -> short_ret [label="x>8"];
  short_undo -> short_ret [label="normal"];
  long -> long_cursor [label="local only"];
  shared -> long_cursor [label="read data"];
  long_cursor -> long_read [label="call"];
  long_read -> readent [label="actual callee"];
  long_read -> long_gate [label="return pointer before attr"];
  long_gate -> long_count [label="true"];
  long_gate -> long_alloc [label="false"];
  long_count -> long_alloc [label="id 0x40 set"];
  long_count -> long_back [label="id 0x40 unset"];
  long_back -> long_read [label="backtrack"];
  long_alloc -> long_reset [label="allocate output"];
  long_reset -> readent [label="actual call"];
  long_reset -> long_for [label="after first readent"];
  long_for -> long_units [label="x<i"];
  long_for -> long_ret [label="x>=i"];
  long_units -> long_write [label="unit eligible"];
  long_write -> long_update [label="after inner loops"];
  long_update -> readent [label="actual extra call"];
  long_update -> long_for [label="next test, last pointer may be unused"];
  readent -> cache [label="may fill buffer"];
  short_ret -> name [label="return value"];
  long_ret -> name [label="return value"];
  name -> max [label="actual"];
  max -> cmp [label="implicit size_t"];
  cmp -> free [label="before equal branch"];
  free -> equal [label="normal return premise",style=dashed];
  equal -> break [label="true"];
  equal -> next [label="false"];
  next -> outer [label="reevaluate"];
  break -> post [label="after breaking"];
  long -> no_cursor [label="local-only cursor"];
  short -> no_cursor [label="short no iobuf"];
  readent -> no_cursor [label="no iter_cursor write"];
  short_init -> nul [label="zeroing premise",style=dashed];
  long_alloc -> nul [label="zeroing premise",style=dashed];
  premise -> stop [label="invalid premise",style=dashed];
  long_read -> stop [label="ERR_PTR consumed by attr",style=dashed];
  long_units -> stop [label="invalid u16 access",style=dashed];
  long_write -> stop [label="NULL output/overflow"];
  cmp -> stop [label="invalid pointer/count",style=dashed];
}
