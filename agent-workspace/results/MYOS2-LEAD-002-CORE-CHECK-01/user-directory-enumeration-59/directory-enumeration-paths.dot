  fat -> parser [label="CALL"];
  fat -> actor [label="CALL"];
  actor -> fill [label="CALL"];
  fill -> actor [label="RETURN"];
  actor -> fat [label="RETURN"];
  fat -> kfree [label="CALL"];
  fat -> localerr [label="LOCAL_CONTROL"];
  localerr -> markend [label="LOCAL_CONTROL"];
  fat -> release [label="CALL"];
  fat -> stop [label="ANALYSIS_STOP"];
  getter -> stop [label="ANALYSIS_STOP"];
  aux -> stop [label="ANALYSIS_STOP"];
  parser -> stop [label="ANALYSIS_STOP"];
  fat -> markend [label="LOCAL_CONTROL"];
  markend -> fpos [label="DATA"];
  ctx -> actor [label="DATA"];
  ctx -> fill [label="DATA"];
  fill -> layout [label="DATA"];
  layout -> reclen [label="DATA"];
  fill -> reclen [label="LOCAL_CONTROL"];
  reclen -> verify [label="LOCAL_CONTROL"];
  pathmax -> verify [label="DATA"];
  verify -> capacity [label="LOCAL_CONTROL"];
  capacity -> prev [label="LOCAL_CONTROL"];
  prev -> directwrite [label="LOCAL_CONTROL"];
  directwrite -> copy [label="LOCAL_CONTROL"];
  fill -> copy [label="CALL"];
