digraph MYOS2_DIRECTORY_ENUMERATION_59 {
  graph [rankdir=LR, labelloc=t, label="D00 / A getdents dispatch / B FAT iterator / C record fill (bounded, not complete CFG)"];
  node [shape=box];
  edge [fontsize=9];
  subgraph cluster_D {
    label="D00 documentary replacement";
    old58 [label="58 B24/B25 historical source labels"];
    d01 [label="D01 LOOKUP_CREATE alone"];
    d02 [label="D02 LOOKUP_EXCL alone"];
    d03 [label="D03 init_mkdir exact five lines"];
    pending [label="R58-01 submitted, C05 decides"];
  }
  subgraph cluster_A {
    label="A fd/dispatch";
    sys [label="getdents64 syscall macro body"];
    fd [label="myos_fdget_pos"];
    fdarr [label="current.files.fd_array[fd]"];
    nofd [label="valid NULL slot => -EBADF"];
    fop [label="file.f_op / iterate_shared"];
    direct [label="direct method invocation"];
    helper [label="iterate_dir (separate, not called here)"];
    helpercheck [label="method presence gate -ENOTDIR"];
    ctx [label="callback context actor/count/current"];
    fpos [label="file.f_pos ↔ ctx.pos"];
    final [label="syscall error and byte return"];
    fdputpos [label="fdput_pos"];
    fdput [label="fdput flags condition"];
    fput [label="fput request only if FDPUT_FPUT"];
    badfd [label="invalid fd index / object STOP", shape=octagon];
    badmethod [label="missing method STOP", shape=octagon];
  }
  subgraph cluster_B {
    label="B FAT enumeration";
    fops [label="FAT32_file_ops binding"];
    fat [label="FAT32_getdents64"];
    endcheck [label="ctx.pos == -1 early return0"];
    iobuf [label="FAT32_iobuf_init"];
    iterinit [label="iobuf.iter_init resets cursor0"];
    getter [label="FAT32_get_full_ent"];
    next [label="FAT32_iobuf_iter_next"];
    readent [label="FAT32_iobuf_readent"];
    aux [label="FAT auxiliary readent"];
    parser [label="FAT32_parse_short/long"];
    actor [label="ctx.actor(ctx,name,len,0,0,0)"];
    kfree [label="kfree(name)"];
    localerr [label="actor return error/break"];
    markend [label="error==0 => ctx.pos=-1"];
    release [label="FAT32_iobuf_release"];
    stop [label="getter/parser invalid prefix STOP", shape=octagon];
  }
  subgraph cluster_C {
    label="C dirent fill";
    fill [label="filldir64"];
    layout [label="linux_dirent64_s / d_name offset model"];
    reclen [label="reclen ALIGN(offsetof+len+1,8)"];
    verify [label="verify_dirent_name"];
    pathmax [label="PATH_MAX len gate"];
    capacity [label="reclen > buf.count => -EINVAL"];
    prev [label="prev=current-prev_reclen"];
    directwrite [label="direct d_off/ino/reclen/d_type stores"];
    copy [label="copy_to_user name bytes"];
    inline [label="inline access_ok/raw copy"];
    residue [label="cplen unused as condition"];
    nul [label="direct d_name[len] NUL"];
    account [label="prev_reclen/current_dir/count advance"];
    eofpatch [label="final d_off patch commented"];
    retbytes [label="prev_reclen => bytes override"];
    errstop [label="bad pointer/arithmetic STOP", shape=octagon];
    efault [label="efault label after return0, no active goto"];
  }
  old58 -> d01 [label="DATA"];
  old58 -> d02 [label="DATA"];
  old58 -> d03 [label="DATA"];
  d01 -> pending [label="DATA"];
  d02 -> pending [label="DATA"];
  d03 -> pending [label="DATA"];
  sys -> fd [label="CALL"];
  fd -> fdarr [label="DATA"];
  fd -> sys [label="RETURN"];
  fdarr -> badfd [label="ANALYSIS_STOP"];
  sys -> nofd [label="LOCAL_CONTROL"];
  sys -> ctx [label="LOCAL_CONTROL"];
  sys -> fpos [label="DATA"];
  sys -> direct [label="CALL"];
  direct -> fop [label="DATA"];
  direct -> badmethod [label="ANALYSIS_STOP"];
  helper -> helpercheck [label="LOCAL_CONTROL"];
  helper -> fop [label="DATA"];
  helper -> fpos [label="DATA"];
  direct -> fat [label="CALL"];
  fat -> direct [label="RETURN"];
  sys -> final [label="LOCAL_CONTROL"];
  final -> retbytes [label="DATA"];
  sys -> fdputpos [label="CALL"];
  fdputpos -> fdput [label="CALL"];
  fdput -> fput [label="LOCAL_CONTROL"];
  fops -> fop [label="DATA"];
  fat -> endcheck [label="LOCAL_CONTROL"];
  fat -> iobuf [label="CALL"];
  fat -> iterinit [label="CALL"];
  fat -> getter [label="CALL"];
  getter -> next [label="CALL"];
  next -> readent [label="CALL"];
  fat -> aux [label="CALL"];
