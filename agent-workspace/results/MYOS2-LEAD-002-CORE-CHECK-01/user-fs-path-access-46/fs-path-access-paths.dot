digraph FP46 {
  rankdir=LR;
  graph [label="FP46 path value / request / direct no-op / lifetime unknown; call-site matched returns only",labelloc=t];
  node [fontname="sans",shape=box];
  G0 [label="get_fs_root / get_fs_pwd: choose ONE source field",shape=box,style=solid];
  G1 [label="ANALYTIC valid fs, lock, writable out path_s",shape=box,style=dashed];
  G2 [label="spin_lock(fs.lock)",shape=box,style=solid];
  G3 [label="*out = fs.chosen_path (copy path_s pointer values)",shape=box,style=solid];
  G4 [label="path_get(out) REQUEST",shape=box,style=solid];
  G5 [label="spin_unlock(fs.lock)",shape=box,style=solid];
  G6 [label="void return if calls normal",shape=box,style=solid];
  G7 [label="STOP invalid fs/output or lock nonreturn",shape=octagon,style=solid];
  G8 [label="ANALYTIC out may alias other internal fs field",shape=box,style=dashed];
  G9 [label="getter has no prior output path_put",shape=box,style=dashed];
  S0 [label="set_fs_root / set_fs_pwd: choose ONE target field",shape=box,style=solid];
  S1 [label="ANALYTIC valid path input and fs for later lock",shape=box,style=dashed];
  S2 [label="path_get(input) BEFORE fs lock",shape=box,style=solid];
  S3 [label="spin_lock(fs.lock)",shape=box,style=solid];
  S4 [label="old_path=fs.chosen_path (value copy)",shape=box,style=solid];
  S5 [label="fs.chosen_path=*input (publish copied pointer values)",shape=box,style=solid];
  S6 [label="spin_unlock(fs.lock)",shape=box,style=solid];
  S7 [label="SOURCE: if(old_path.dentry)",shape=diamond,style=solid];
  S8 [label="old dentry NULL: skip old path_put",shape=box,style=solid];
  S9 [label="path_put(&old_path) REQUEST",shape=box,style=solid];
  S10 [label="void return if normal",shape=box,style=solid];
  S11 [label="STOP input path member invalid before lock",shape=octagon,style=solid];
  S12 [label="STOP invalid fs/lock or member copy",shape=octagon,style=solid];
  S13 [label="old.mnt NOT tested by put gate",shape=box,style=dashed];
  PG0 [label="path_get(const path_s*): actual wrapper",shape=box,style=solid];
  PG1 [label="evaluate path->dentry (requires readable path_s)",shape=box,style=solid];
  PG2 [label="dget(dentry) call; mntget commented",shape=box,style=solid];
  PG3 [label="dget returns same pointer; no refcount mutation",shape=box,style=solid];
  PG4 [label="dget return value discarded by path_get",shape=box,style=solid];
  PG5 [label="path_get returns void",shape=box,style=solid];
  PG6 [label="STOP if path struct member read invalid",shape=octagon,style=solid];
  PP0 [label="path_put(const path_s*): actual wrapper",shape=box,style=solid];
  PP1 [label="evaluate path->dentry (requires readable path_s)",shape=box,style=solid];
  PP2 [label="dput(dentry) call; mntput commented",shape=box,style=solid];
  PP3 [label="dput body has no active statements",shape=box,style=solid];
  PP4 [label="path_put returns void",shape=box,style=solid];
  PP5 [label="STOP if path struct member read invalid",shape=octagon,style=solid];
  C0 [label="init_mount_tree: one real setter caller scene",shape=box,style=solid];
  C1 [label="mnt=vfs_kern_mount(rootfs)",shape=box,style=solid];
  C2 [label="SOURCE: IS_ERR(mnt)",shape=diamond,style=solid];
  C3 [label="error branch has while(1); no setter on that branch",shape=octagon,style=solid];
  C4 [label="root.mnt=mnt; root.dentry=mnt->mnt_root",shape=box,style=solid];
  C5 [label="set_fs_pwd(curr.fs,&root) call-site",shape=box,style=solid];
  C6 [label="set_fs_root(curr.fs,&root) call-site",shape=box,style=solid];
  C7 [label="return from init_mount_tree if both setters normal",shape=box,style=solid];
  T0 [label="path_s contains mnt and dentry pointers",shape=box,style=dashed];
  T1 [label="dentry_s d_lockref commented, no selected active count",shape=box,style=dashed];
  T2 [label="actual dget/dput do NOT adjust directory refs",shape=box,style=dashed];
  T3 [label="no active mntget/mntput in direct wrappers",shape=box,style=dashed];
  T4 [label="getter selection under DEBUG/FS_STRUCT_DEFINATION",shape=box,style=dashed];
  T5 [label="getters: no independent caller in default-branch search",shape=box,style=dashed];
  T6 [label="actual physical object lifetime and mount refs UNKNOWN",shape=box,style=dashed];
  X0 [label="ANALYTIC source/target pointer alias and value equality",shape=box,style=dashed];
  G0 -> G1 [label="ANALYTIC: valid inputs needed, NOT source gate",style=dashed];
  G1 -> G2 [label="SOURCE: valid",style=solid];
  G1 -> G7 [label="ANALYTIC: invalid source/target",style=dashed];
  G2 -> G3 [label="SOURCE: lock normal",style=solid];
  G2 -> G7 [label="ANALYTIC: lock nonreturn/invalid",style=dashed];
  G3 -> G4 [label="SOURCE: out assignment valid",style=solid];
  G3 -> G7 [label="ANALYTIC: out invalid",style=dashed];
  G4 -> PG0 [label="CALL: getter context",style=solid];
  PG5 -> G5 [label="RETURN: only getter invocation and normal",style=solid];
  G5 -> G6 [label="SOURCE: unlock normal",style=solid];
  G8 -> G3 [label="ANALYTIC: output may alias internal other field",style=dashed];
  G9 -> G3 [label="NOTE: old output not put",style=dashed];
  T4 -> G0 [label="NOTE: definition condition, no preproc certification",style=dashed];
  T5 -> G0 [label="NOTE: search scope limited",style=dashed];
  S0 -> S1 [label="ANALYTIC: valid path must be readable",style=dashed];
  S1 -> S2 [label="SOURCE: valid input",style=solid];
  S1 -> S11 [label="ANALYTIC: input path invalid",style=dashed];
  S2 -> PG0 [label="CALL: setter pre-lock context",style=solid];
  PG5 -> S3 [label="RETURN: only setter invocation and normal",style=solid];
  S3 -> S4 [label="SOURCE: lock normal",style=solid];
  S3 -> S12 [label="ANALYTIC: invalid fs or lock",style=dashed];
  S4 -> S5 [label="SOURCE: valid old path object",style=solid];
  S4 -> S12 [label="ANALYTIC: invalid old field",style=dashed];
  S5 -> S6 [label="SOURCE: publish done",style=solid];
  S6 -> S7 [label="SOURCE: unlock normal",style=solid];
  S7 -> S8 [label="SOURCE: old dentry NULL",style=solid];
  S7 -> S9 [label="SOURCE: old dentry nonNULL",style=solid];
  S8 -> S10 [label="SOURCE: no old put",style=solid];
  S9 -> PP0 [label="CALL: setter old path put request",style=solid];
  PP4 -> S10 [label="RETURN: setter context when put normal",style=solid];
  S13 -> S7 [label="NOTE: gate checks only dentry",style=dashed];
  PG0 -> PG1 [label="SOURCE: source",style=solid];
  PG1 -> PG6 [label="ANALYTIC: invalid path storage",style=dashed];
  PG1 -> PG2 [label="SOURCE: valid path struct",style=solid];
  PG2 -> PG3 [label="CALL: dget selected body",style=solid];
  PG3 -> PG4 [label="RETURN: pointer unchanged",style=solid];
  PG4 -> PG5 [label="SOURCE: source",style=solid];
  PP0 -> PP1 [label="SOURCE: source",style=solid];
  PP1 -> PP5 [label="ANALYTIC: invalid path storage",style=dashed];
  PP1 -> PP2 [label="SOURCE: valid path struct",style=solid];
  PP2 -> PP3 [label="CALL: dput selected body",style=solid];
  PP3 -> PP4 [label="RETURN: empty dput normal",style=solid];
  C0 -> C1 [label="SOURCE: source",style=solid];
  C1 -> C2 [label="SOURCE: mount returns",style=solid];
  C2 -> C3 [label="SOURCE: IS_ERR true",style=solid];
  C2 -> C4 [label="SOURCE: IS_ERR false and valid mnt",style=solid];
  C4 -> C5 [label="SOURCE: root pointers set",style=solid];
  C5 -> S0 [label="CALL: pwd setter invocation only",style=solid];
  S10 -> C6 [label="RETURN: match pwd caller only",style=solid];
  C6 -> S0 [label="CALL: root setter invocation only",style=solid];
  S10 -> C7 [label="RETURN: match root caller only",style=solid];
  T0 -> G3 [label="DATA: value copy, not deep copy",style=solid];
  T0 -> S5 [label="DATA: value copy, not deep copy",style=solid];
  T1 -> T2 [label="NOTE: commented lockref in dentry struct",style=dashed];
  T2 -> PG3 [label="NOTE: dget no-op count",style=dashed];
  T2 -> PP3 [label="NOTE: dput no-op count",style=dashed];
  T3 -> PG2 [label="NOTE: mntget is comment",style=dashed];
  T3 -> PP2 [label="NOTE: mntput is comment",style=dashed];
  X0 -> G3 [label="ANALYTIC: possible output alias, not actual caller",style=dashed];
  X0 -> S5 [label="ANALYTIC: possible input alias or equal value",style=dashed];
  T6 -> G6 [label="NOTE: return != lifetime proof",style=dashed];
  T6 -> S10 [label="NOTE: void return != resource safety",style=dashed];
}
