digraph SB38 {
  graph [label="CORE-USER-FAT-SUPERBLOCK-BINDING-38 | bounded source paths, no runtime proof",rankdir=LR];
  node [fontsize=10];
  reg [label="register_diskfs: init_fat32_fs active, init_vfat_fs commented",shape=box];
  initA [label="init_fat32_fs calls register_filesystem, ignores status",shape=box];
  typeA [label="FAT32_fs_type: name FAT32; read_super bound",shape=note];
  registry [label="file_systems registry; insertion needs no duplicate/next link",shape=box];
  boot [label="myos_switch_to_root_disk: earlier disk/buffer gates opaque",shape=box];
  select [label="matching GUID pair and i==BOOT_FS_IDX?",shape=diamond];
  mount [label="mount_fs finds name by strcmp; calls matching read_super",shape=box];
  miss [label="name miss -> normal NULL return",shape=ellipse];
  readA [label="read_fat32_superblock",shape=box];
  allocS [label="alloc_super: kzalloc and local initialization",shape=box];
  allocerr [label="kzalloc NULL -> ERR_PTR(-ENOMEM)",shape=ellipse];
  nullgate [label="read_super caller checks sbp==NULL only",shape=diamond];
  defnull [label="defensive NULL branch -> ERR_PTR; no selected NULL producer",shape=ellipse];
  bindA [label="s_op=FAT32_sb_ops; allocate private_sb_info then use it",shape=box];
  opsA [label="FAT32_sb_ops omitted alloc_inode=NULL under C initializer model",shape=note];
  rootD [label="root dentry and name allocation/field writes",shape=box];
  rootI [label="root kmalloc(sizeof inode_s), direct ops/size/mode/i_sb writes",shape=box];
  rootP [label="separate FAT32_inode_info_s private_idx_info buffer",shape=box];
  sbret [label="ordinary sbp only after valid completed construction",shape=ellipse];
  rootuse [label="boot assigns returned sb; set_init_mount/taskfs consume s_root",shape=box];
  rootmap [label="root i_mapping/i_data writers not established by this body",shape=note];
  lookup [label="later FAT32_lookup with this parent i_sb, after valid scan",shape=box];
  buildA [label="fat_build_inode calls new_inode with A superblock",shape=box];
  allocA [label="new_inode -> alloc_inode: unchanged A alloc_inode slot NULL",shape=box];
  cacheA [label="fallback kmem_cache_alloc(inode_cachep): sizeof inode_s",shape=box];
  ptrA [label="allocator result NULL?",shape=diamond];
  nullA [label="alloc_inode/new_inode NULL -> fat_build_inode ERR_PTR(-ENOMEM)",shape=ellipse];
  initChild [label="valid nonNULL: inode_init_always, list init/publication, return",shape=box];
  fillA [label="fat_fill_inode: i_mode=0, then MSDOS_I(inode)->i_pos=0",shape=box];
  contain [label="A standalone provenance does not establish required enclosing msdos_inode_info_s",shape=note];
  boundary [label="ANALYSIS boundary: no defined continuation beyond unsupported access; not a halt instruction",shape=note];
  typeB [label="vfat_fs_type: name vfat; mount bound; read_super omitted NULL",shape=note];
  initB [label="init_vfat_fs defined; only separately invoked registration",shape=box];
  mountB [label="vfat_mount passes vfat_fill_super to mount_bdev",shape=box];
  opaque [label="mount_bdev actual callback/lifecycle not audited",shape=note];
  fillB [label="vfat_fill_super -> fat_fill_super",shape=box];
  sbiGate [label="sbi=kzalloc(msdos_sb_info_s); NULL?",shape=diamond];
  sbiErr [label="return integer -ENOMEM",shape=ellipse];
  bindB [label="s_fs_info=sbi; s_op=fat_sops; setup",shape=box];
  opsB [label="fat_sops.alloc_inode=fat_alloc_inode",shape=note];
  newB [label="after earlier valid setup/read gates: root_inode=new_inode(sb)",shape=box];
  fatallocB [label="alloc_inode calls fat_alloc_inode: kmalloc outer msdos_inode_info_s",shape=box];
  ptrB [label="outer allocation NULL?",shape=diamond];
  nullB [label="alloc_inode/new_inode return NULL to fat_fill_super",shape=ellipse];
  embedB [label="outer fields initialized; return &ei->vfs_inode",shape=box];
  initBroot [label="inode_init_always and list publication inside new_inode",shape=box];
  resumeB [label="fat_fill_super receives nonNULL root; invokes fat_read_root",shape=box];
  readB [label="fat_read_root returned negative?",shape=diamond];
  rootErr [label="iput(root_inode); goto out_fail",shape=box];
  fall [label="nonnegative result falls through out_invalid: error=-EINVAL",shape=box];
  cleanupB [label="clear s_fs_info; kfree(sbi); return integer error",shape=ellipse];
  outerB [label="B allocation supplies enclosing object premise if all prior calls valid",shape=note];
  reg -> initA [label="CALL",style=solid];
  initA -> registry [label="CALL; registration result not consumed by initA",style=solid];
  typeA -> initA [label="DATA: object argument",style=dashed];
  boot -> select [label="when earlier operations and scan are valid",style=solid];
  select -> mount [label="true: mount_fs(\"FAT32\",...)",style=solid];
  registry -> mount [label="DATA: matching node must really be registered",style=dashed];
  mount -> miss [label="no matching name",style=solid];
  mount -> readA [label="matching known A node: CALL read_super, not mount",style=solid];
  readA -> allocS [label="CALL",style=solid];
  allocS -> allocerr [label="allocation NULL: normal encoded error return",style=solid];
  allocS -> nullgate [label="ordinary pointer RETURN",style=solid];
  allocerr -> nullgate [label="encoded pointer RETURN; !=NULL",style=solid];
  nullgate -> defnull [label="true; no normal NULL producer in selected alloc_super",style=solid];
  nullgate -> bindA [label="false; actual store requires valid object",style=solid];
  bindA -> boundary [label="if pointer invalid at first field store",style=dashed];
  opsA -> bindA [label="DATA: assigned global table",style=dashed];
  bindA -> rootD [label="only if private writes and requests completed validly",style=solid];
  rootD -> rootI [label="only if prior allocations/fields valid",style=solid];
  rootI -> rootP [label="after valid blocks arithmetic",style=solid];
  rootP -> sbret [label="construction returns normally",style=solid];
  sbret -> rootuse [label="RETURN then assignment and direct consumption",style=solid];
  miss -> rootuse [label="RETURN NULL; no local validity gate before s_root",style=solid];
  rootuse -> boundary [label="if sb pointer invalid at actual access",style=dashed];
  rootI -> rootmap [label="ANALYSIS: no visible mapping writer",style=dashed];
  rootI -> lookup [label="DATA: later lookup dispatch via root i_op, if invoked",style=dashed];
  lookup -> buildA [label="CALL using same parent i_sb",style=solid];
  buildA -> allocA [label="CALL new_inode -> alloc_inode",style=solid];
  opsA -> allocA [label="DATA: unchanged alloc_inode member NULL",style=dashed];
  allocA -> cacheA [label="NULL callback selects fallback",style=solid];
  cacheA -> ptrA [label="allocator returns",style=solid];
  ptrA -> nullA [label="true: normal allocation failure chain",style=solid];
  ptrA -> initChild [label="false, ordinary valid inode",style=solid];
  initChild -> fillA [label="RETURN to fat_build_inode, then CALL fat_fill_inode",style=solid];
  fillA -> contain [label="required outer-object premise at MSDOS_I write",style=dashed];
  contain -> boundary [label="absence of enclosing-object evidence limits continuation",style=dashed];
  typeB -> initB [label="DATA: distinct registration object",style=dashed];
  initB -> registry [label="CALL only if separately invoked",style=solid];
  typeB -> mountB [label="STATIC .mount binding, not A dispatcher",style=dashed];
  mountB -> opaque [label="CALL with fill callback",style=solid];
  opaque -> fillB [label="only if delegate invokes callback",style=dashed];
  fillB -> sbiGate [label="local allocation and actual NULL check",style=solid];
  sbiGate -> sbiErr [label="true: normal integer error return",style=solid];
  sbiGate -> bindB [label="false: valid sbi required",style=solid];
  opsB -> bindB [label="DATA: distinct assigned table",style=dashed];
  bindB -> newB [label="only if setup and earlier read/validation gates pass",style=solid];
  newB -> fatallocB [label="CALL new_inode/alloc_inode with B table",style=solid];
  opsB -> fatallocB [label="DATA: nonNULL slot resolves to fat_alloc_inode",style=dashed];
  fatallocB -> ptrB [label="kmalloc result check",style=solid];
  ptrB -> nullB [label="true: normal NULL return",style=solid];
  nullB -> cleanupB [label="fat_fill_super root NULL -> out_fail; preserve current error",style=solid];
  ptrB -> embedB [label="false: valid outer object",style=solid];
  embedB -> initBroot [label="RETURN to alloc_inode then per-allocation initialization",style=solid];
  initBroot -> resumeB [label="RETURN to B caller, not A fat_build_inode",style=solid];
  embedB -> outerB [label="DATA: actual enclosing storage",style=dashed];
  resumeB -> readB [label="fat_read_root result after normal return",style=solid];
  readB -> rootErr [label="negative",style=solid];
  rootErr -> cleanupB [label="goto out_fail",style=solid];
  readB -> fall [label="nonnegative; no active success return before label",style=solid];
  fall -> cleanupB [label="active cleanup fallthrough",style=solid];
}
