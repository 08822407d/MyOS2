 f05_src -> d00_pending [label="DOCUMENT_CORRECTION_PENDING: no kernel fix",color=gray,style=dotted];
 start -> page [label="CALL_SOURCE_ORDER: AllocatePages and SetMem are indirect gBS calls",color=gray,style=dotted];
 page -> arena [label="DATA: same pages base and 32-page nominal capacity",color=black,style=solid];
 arena -> head [label="DATA: header pointer pages",color=black,style=solid];
 arena -> initcursor [label="DATA: base passed to init_info_tag_addr",color=black,style=solid];
 start -> initcursor [label="CALL: direct init_info_tag_addr",color=blue,style=solid];
 initcursor -> frame [label="DATA: first tag cursor",color=black,style=solid];
 start -> frame [label="CALL: direct fill_framebuffer_info",color=blue,style=solid];
 frame -> next [label="CALL: fill_framebuffer_info invokes next",color=blue,style=solid];
 frame -> mmap [label="SOURCE_ORDER: returned next cursor",color=gray,style=dotted];
 start -> mmap [label="CALL: direct fill_mmap_info",color=blue,style=solid];
 mmap -> next [label="CALL: fill_mmap_info invokes next",color=blue,style=solid];
 mmap -> acpi [label="SOURCE_ORDER: returned next cursor",color=gray,style=dotted];
 start -> acpi [label="CALL: direct fill_acpi_RSDT_info",color=blue,style=solid];
 acpi -> next [label="CALL: fill_acpi invokes next",color=blue,style=solid];
 acpi -> cpu [label="SOURCE_ORDER: returned next cursor",color=gray,style=dotted];
 start -> cpu [label="CALL: direct fill_cputopo_info",color=blue,style=solid];
 cpu -> next [label="CALL: fill_cputopo invokes next",color=blue,style=solid];
 cpu -> tagend [label="SOURCE_ORDER: after all four producers return",color=gray,style=dotted];
 start -> tagend [label="CALL: direct fill_info_tag_end",color=blue,style=solid];
 tagend -> next [label="CALL: END advances by its size",color=blue,style=solid];
 tagend -> publish [label="SOURCE_ORDER: publish last",color=gray,style=dotted];
 start -> publish [label="CALL: direct fill_info_tag_header",color=blue,style=solid];
 publish -> head [label="DATA: total_size / reserved written",color=black,style=solid];
 arena -> Astop [label="CONDITIONAL_STOP: no remaining capacity bound",color=red,style=dashed];
 next -> Astop [label="CONDITIONAL_STOP: u32 size+7 wrap or no progress",color=red,style=dashed];
 probe -> pool [label="SOURCE_ORDER: first GetMemoryMap size probe",color=gray,style=dotted];
 mmap -> probe [label="INDIRECT_CALL: gBS GetMemoryMap",color=purple,style=dashed];
 pool -> getmap [label="SOURCE_ORDER: AllocatePool/SetMem then GetMemoryMap",color=gray,style=dotted];
 getmap -> desc [label="CONDITIONAL: successful status only",color=gray,style=dotted];
 desc -> type [label="DATA: Type/NumberOfPages",color=black,style=solid];
 type -> merge [label="BRANCH: recognized type and positive pages",color=gray,style=dotted];
 merge -> newent [label="BRANCH: not same type contiguous",color=gray,style=dotted];
 merge -> sort [label="SOURCE_ORDER: completed input iteration",color=gray,style=dotted];
 newent -> sort [label="SOURCE_ORDER: after all appends",color=gray,style=dotted];
 sort -> exit [label="SOURCE_ORDER: FreePool and ExitBootServices",color=gray,style=dotted];
 exit -> mmap_tag [label="SOURCE_ORDER: publish MMAP fields AFTER Exit call",color=gray,style=dotted];
 mmap_tag -> extra [label="DATA: size includes e820_nr+1",color=black,style=solid];
 page -> extra [label="CONDITIONAL_DATA: SetMem can supply zero if succeeds",color=gray,style=dotted];
 mmap_tag -> next [label="CALL: after setting type, size, entry_size",color=blue,style=solid];
 mmap_tag -> parse [label="DATA_HANDOFF: not C CALL between bootloader and kernel",color=black,style=dotted];
 parse -> rammap [label="DATA: store entries pointer",color=black,style=solid];
 rammap -> e820 [label="DATA: each local C sizeof step until zero sentinel",color=black,style=solid];
 extra -> e820 [label="CONDITIONAL_DATA: source sentinel requires valid object",color=gray,style=dotted];
 e820 -> cap [label="DATA: destination entries[128]",color=black,style=solid];
 desc -> Bstop [label="CONDITIONAL_STOP: DescriptorSize 0/overflow/extent",color=red,style=dashed];
 sort -> Bstop [label="CONDITIONAL_STOP: e820_nr/array and service state",color=red,style=dashed];
 extra -> Bstop [label="CONDITIONAL_STOP: no explicit terminal write",color=red,style=dashed];
 cap -> old80 [label="HISTORY_GATE: 129th record is old BM80-F03",color=darkorange,style=dotted];
 e820 -> old80 [label="HISTORY_GATE: stride and sentinel BM80-F04",color=darkorange,style=dotted];
 exit -> acpi [label="SOURCE_ORDER: C stage after ExitBootServices call",color=gray,style=dotted];
 acpi -> config [label="SOURCE_CHAIN: uses gST ConfigurationTable",color=gray,style=dotted];
 config -> sig [label="BRANCH: CompareGuid literal ==0 and readable Root",color=gray,style=dotted];
 sig -> copy [label="BRANCH: signature and revision predicates pass",color=gray,style=dotted];
 copy -> acpi_tag [label="DATA: copied fixed RSDP length",color=black,style=solid];
 sig -> acpi_tag [label="SOURCE_ORDER: tag published even if no valid match",color=gray,style=dotted];
 acpi_tag -> next [label="CALL: after setting ACPI_NEW size",color=blue,style=solid];
 acpi_tag -> acpi_cons [label="DATA_HANDOFF: kernel case only local variable",color=black,style=dotted];
 exit -> cpu [label="SOURCE_ORDER: CPU service call after ExitBootServices",color=gray,style=dotted];
 cpu -> mp [label="INDIRECT_CALL: gBS LocateProtocol",color=purple,style=dashed];
 mp -> count [label="INDIRECT_CALL: mpp GetNumberOfProcessors",color=purple,style=dashed];
 count -> each [label="BRANCH: for i<nCores",color=gray,style=dotted];
 each -> cpu_tag [label="DATA: writes cpus[i] per external result",color=black,style=solid];
 count -> cpu_tag [label="DATA: core_num and core_available narrowed to u32",color=black,style=solid];
 cpu_tag -> next [label="CALL: dynamic size then cursor advanced",color=blue,style=solid];
 cpu_tag -> cpu_cons [label="DATA_HANDOFF: kernel parser case",color=black,style=dotted];
 cpu_cons -> nr [label="CALL: get_smpinfo",color=blue,style=solid];
 acpi -> service [label="SOURCE_ORDER: UefiMain after tag construction",color=gray,style=dotted];
 cpu -> service [label="SOURCE_ORDER: UefiMain later Print/Close",color=gray,style=dotted];
 mp -> Cstop [label="CONDITIONAL_STOP: protocol ptr and service phase unknown",color=red,style=dashed];
 copy -> Cstop [label="CONDITIONAL_STOP: ACPI contents and validity unknown",color=red,style=dashed];
 each -> Cstop [label="CONDITIONAL_STOP: cpus[i] extent and service status",color=red,style=dashed];
 publish -> nostart [label="PROOF_BOUNDARY: serialized tag bytes unobserved",color=gray,style=dotted];
 acpi_cons -> nostart [label="PROOF_BOUNDARY: not full ACPI driver audit",color=gray,style=dotted];
 nr -> nostart [label="PROOF_BOUNDARY: not full SMP audit",color=gray,style=dotted];
 Astop -> nostage [label="PROOF_BOUNDARY: no runtime certification",color=gray,style=dotted];
 Bstop -> nostage [label="PROOF_BOUNDARY: no runtime certification",color=gray,style=dotted];
 Cstop -> nostage [label="PROOF_BOUNDARY: no runtime certification",color=gray,style=dotted];
 d00_pending -> old96 [label="HISTORY_GATE: S01 S02 S03 intact",color=darkorange,style=dotted];
}
