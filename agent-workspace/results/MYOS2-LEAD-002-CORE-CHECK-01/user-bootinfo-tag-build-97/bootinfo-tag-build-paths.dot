// Fixed time@a039d9803ade; static conditional graph, not full CFG; Graphviz NOT_RUN.
// CALL denotes real direct source call, INDIRECT_CALL denotes function pointer; DATA_HANDOFF is NOT a direct call.
digraph BT97_BootinfoTagBuild {
 graph [rankdir=LR,labelloc=t,label="BT97: D00 R96 documentary repair plus shared bootinfo arena / MMAP / ACPI & CPU"];
 node [shape=box,fontsize=10]; edge [fontsize=8];
 subgraph cluster_D00 {
  label="D00 / fixed time source evidence";
  fm96_old_e036 [label="FM96-E036 old quote crosses struct and typedef",shape=box];
  fm97_struct [label="BT97-E001 bounded struct tail",shape=box];
  fm97_typedef [label="BT97-E002 separate typedef",shape=box];
  fm96_f04 [label="FM96-F04 producer/type consumer",shape=box];
  fm96_badf05 [label="FM96-F05 fields incorrectly typed",shape=box];
  f05_src [label="BT97-E003/4/5: bpp/8 consumer",shape=box];
  f05_old [label="FM96-E035/E041/E044 valid old evidence",shape=box];
  cn95 [label="CN95-U05 prior qualified ID only",shape=box];
  d00_pending [label="R96-01/02 correction PENDING C06 review",shape=octagon];
 }
 subgraph cluster_A {
  label="A / fixed time source evidence";
  start [label="UefiMain: fixed producer call order",shape=box];
  page [label="AllocatePages 32 pages; SetMem zero",shape=box];
  arena [label="one shared MBI buffer",shape=box];
  head [label="MBI header total_size/reserved",shape=box];
  initcursor [label="init_info_tag_addr: base+sizeof(header)",shape=box];
  frame [label="fill_framebuffer_info; type/size",shape=box];
  mmap [label="fill_mmap_info; type/size/entries",shape=box];
  acpi [label="fill_acpi_RSDT_info; ACPI_NEW",shape=box];
  cpu [label="fill_cputopo_info; CPU_TOPO",shape=box];
  next [label="next_info_tag_addr: align(size,8)",shape=box];
  tagend [label="fill_info_tag_end: END/sizeof(tag)",shape=box];
  publish [label="fill_info_tag_header: end-after-END minus base",shape=box];
  Astop [label="capacity/status/size wrap not proven",shape=octagon];
 }
 subgraph cluster_B {
  label="B / fixed time source evidence";
  probe [label="first GetMemoryMap; status unused",shape=box];
  pool [label="AllocatePool+SetMem; status unused",shape=box];
  getmap [label="second GetMemoryMap; error checked",shape=box];
  desc [label="DescriptorSize byte stride; NumberOfPages",shape=box];
  type [label="EFI->MMAP type mapping, unknown skip",shape=box];
  merge [label="merge only previous same-type contiguous",shape=box];
  newent [label="append addr,len,type; e820_nr++",shape=box];
  sort [label="sort after merge; no second merge",shape=box];
  exit [label="FreePool; ExitBootServices return unchecked",shape=box];
  mmap_tag [label="MMAP.size includes e820_nr+1; entry_size",shape=box];
  extra [label="extra zero sentinel depends arena zeroing",shape=box];
  parse [label="kernel parse_tag case MMAP",shape=box];
  rammap [label="kernel ram_map=tag.entries",shape=box];
  e820 [label="e820__memory_setup sizeof stride, 0 sentinel",shape=box];
  cap [label="e820_table capacity 128",shape=box];
  Bstop [label="valid descriptors, number/size/real memory unknown",shape=octagon];
 }
 subgraph cluster_C {
  label="C / fixed time source evidence";
  config [label="gST ConfigurationTable + GUID test",shape=box];
  sig [label="Root Signature/Revision gate",shape=box];
  copy [label="ZeroMem+CopyMem RSDP if matched",shape=box];
  acpi_tag [label="ACPI_NEW type/size always published",shape=box];
  mp [label="LocateProtocol MP Services",shape=box];
  count [label="GetNumberOfProcessors; UINTN",shape=box];
  each [label="GetProcessorInfo for i<nCores",shape=box];
  cpu_tag [label="CPU_TOPO fields and dynamic size",shape=box];
  acpi_cons [label="kernel ACPI_NEW: local pointer only",shape=box];
  cpu_cons [label="kernel CPU_TOPO calls get_smpinfo",shape=box];
  nr [label="nr_cpu_ids = smp_info->core_num",shape=box];
  service [label="gBS/Print/Close after fill stages",shape=box];
  Cstop [label="external EFI/ACPI/MP returns & phase unverified",shape=octagon];
 }
 subgraph cluster_proof {
  label="proof / fixed time source evidence";
  old80 [label="BM80 F01-F04, U02-U07 preserved",shape=box];
  old96 [label="FM96 R96-S01/02/03 preserved",shape=box];
  nostart [label="No real boot, ABI, compiler, test or code edits",shape=box];
  nostage [label="time static order != runtime success",shape=box];
 }
 fm96_old_e036 -> fm97_struct [label="DOCUMENTARY_CORRECTION: first definition only",color=darkorange,style=dashed];
 fm96_old_e036 -> fm97_typedef [label="DOCUMENTARY_CORRECTION: separate typedef",color=darkorange,style=dashed];
 fm97_struct -> fm96_f04 [label="EVIDENCE: framebuffer_type field",color=gray,style=dotted];
