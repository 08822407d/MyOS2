// PI31 stage2, frozen time@a039d9803ade, no runtime evidence.
// write/conditional_write are actual function-assignment edges; data is not ownership.
// result does not imply successful path resolution, permission, or acquired references.
// Empty restore_nameidata/terminate_walk and constant complete_walk are modelled as
// code facts; this graph does NOT certify mount/path reference or lock state.
// Actual direct callers pass root=NULL; any nonNULL root is helper-only.
// The selected path_init reads first character, not dfd/LOOKUP_IN_ROOT or LOOKUP_BENEATH.
digraph PATH_INIT_31 {
  graph [rankdir=LR, labelloc=t, fontsize=12, label="PI31: nameidata init / path start / caller / local exit"];
  node [shape=box, fontsize=10];
