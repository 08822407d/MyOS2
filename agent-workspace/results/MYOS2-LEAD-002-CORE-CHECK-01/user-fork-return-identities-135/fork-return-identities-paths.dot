subgraph cluster_D00_R134_04 { label="D00_R134_04";
D135_E134_ROOT [label="134 frozen evidence 47 formal; every old E134 ID narrow assertion below; 16 location windows separate"];
D135_E135_TASKPID125 [label="135 source E135-001 1-line task_pid return task->thread_pid; virtual old one-to-one"];
D135_E134_001 [label="E134-001 RQCF_REQ_SKIP source 46-46: REQ_SKIP宏单独定义为十六进制0x01；不证明跳过分支已生效"];
D135_E134_002 [label="E134-002 RQCF_ACT_SKIP source 47-47: ACT_SKIP宏单独定义为十六进制0x02；不同于REQ_SKIP独立一行"];
D135_E134_003 [label="E134-003 RQCF_UPDATED source 48-48: UPDATED宏单独定义为十六进制0x04；调用者覆盖使用此值"];
D135_E134_004 [label="E134-004 update_rq_clock source 24-27: update_rq_clock先算纳秒差，负差return，非负才对clock执行+=delta"];
D135_E134_005 [label="E134-005 __schedule source 1065-1067: __schedule依次左移flags、直接调用update_rq_clock、将flags覆盖为RQCF_UPDATED"];
D135_E134_006 [label="E134-006 normal_boot source 30-32: normal_boot调用一次fork并在rv等于0时进入子分支"];
D135_E134_007 [label="E134-007 normal_boot source 33-33: normal_boot子分支把getpid返回值赋给局部pid；本行不证明其数值"];
D135_E134_008 [label="E134-008 normal_boot source 35-35: normal_boot子分支请求execve(prog_name,args,envs)，不是getpid调用的一部分"];
D135_E134_009 [label="E134-009 normal_boot source 38-38: normal_boot非零rv的else分支把getpid返回值赋给另一个局部pid"];
D135_E134_010 [label="E134-010 normal_boot source 40-42: normal_boot非零rv后进入无限循环并调用sched_yield"];
D135_E134_011 [label="E134-011 getpid source 47-47: getpid查询体直接返回task_tgid_vnr(current)，类型为TGID而非线程PID"];
D135_E134_012 [label="E134-012 getppid source 117-117: getppid函数体内声明局部int pid，本行不证明赋值或返回"];
D135_E134_013 [label="E134-013 getppid source 120-120: getppid把task_tgid_vnr(current->real_parent)赋给局部pid"];
D135_E134_014 [label="E134-014 getppid source 123-123: getppid仅返回已保存的局部pid；不自动重读父对象"];
D135_E134_015 [label="E134-015 __NR_getpid source 50-50: x86_64静态编号宏__NR_getpid的值为39"];
D135_E134_016 [label="E134-016 __NR_getppid source 135-135: x86_64静态编号宏__NR_getppid的值为110"];
D135_E134_017 [label="E134-017 __SYSCALL source 10-10: __SYSCALL第一个宏语境生成extern __x64_##sym声明，不产生调用"];
