digraph FT43 {
  rankdir=LR;
  graph [label="FT43 files table provenance, copy/share/unshare: SOURCE vs ANALYTIC preconditions",labelloc=t];
  node [fontname="sans",shape=box];
  I0 [label="static init_task.files=&init_files",shape=box,style=solid];
  I1 [label="global init_files refcount1, fd_count0",shape=box,style=solid];
  I2 [label="ANALYTIC: actual current==init_task not proved",shape=box,style=dashed];
  P0 [label="copy_process obtains p from dup_task_struct(current)",shape=box,style=solid];
  P1 [label="dup_task_struct: *tsk=*orig (preseed files pointer)",shape=box,style=solid];
  P2 [label="call copy_files(clone_flags,p)",shape=box,style=solid];
  P3 [label="oldf=current->files",shape=box,style=solid];
  P4 [label="SOURCE: if(!oldf)",shape=diamond,style=solid];
  P5 [label="return0; no explicit tsk.files write",shape=box,style=solid];
  P6 [label="SOURCE: clone_flags & CLONE_FILES",shape=diamond,style=solid];
  P7 [label="atomic_inc(oldf.refcount); no tsk.files assignment",shape=box,style=solid];
  P8 [label="return0 with inherited files pointer",shape=box,style=solid];
  P9 [label="newf=dup_fd(oldf,NR_OPEN_MAX,&error)",shape=box,style=solid];
  P10 [label="SOURCE: if(!newf)",shape=diamond,style=solid];
  P11 [label="return error; tsk.files unchanged by copy_files",shape=box,style=solid];
  P12 [label="tsk.files=newf; error=0",shape=box,style=solid];
  P13 [label="return0",shape=box,style=solid];
  P14 [label="ANALYTIC: p.files inherited oldf when orig=current and stable",shape=box,style=dashed];
  D0 [label="dup_fd(oldf,max_fds,errorp)",shape=box,style=solid];
  D1 [label="*errorp=-ENOMEM",shape=box,style=solid];
  D2 [label="kmem_cache_alloc(files_cachep,GFP_KERNEL)",shape=box,style=solid];
  D3 [label="SOURCE: if(!newf)",shape=diamond,style=solid];
  D4 [label="out: return NULL",shape=box,style=solid];
  D5 [label="newf.refcount=1; fd_count=256; file_lock init",shape=box,style=solid];
  D6 [label="old_fds=oldf.fd_array; new_fds=newf.fd_array",shape=box,style=solid];
  D7 [label="SOURCE: i<max_fds",shape=diamond,style=solid];
  D8 [label="return newf",shape=box,style=solid];
  D9 [label="ANALYTIC: i<256 physical bound",shape=box,style=dashed];
  D10 [label="STOP invalid old_fds[i] array index",shape=octagon,style=solid];
  D11 [label="old_fp=old_fds[i]",shape=box,style=solid];
  D12 [label="SOURCE: if(old_fp!=NULL)",shape=diamond,style=solid];
  D13 [label="old NULL: no new slot store",shape=box,style=solid];
  D14 [label="new_fp=kzalloc(sizeof(file_s))",shape=box,style=solid];
  D15 [label="ANALYTIC valid new_fp and old_fp",shape=box,style=dashed];
  D16 [label="STOP kzalloc NULL / invalid old file",shape=octagon,style=solid];
  D17 [label="*new_fp=*old_fp value-copy file_s",shape=box,style=solid];
  D18 [label="new_fds[i]=new_fp",shape=box,style=solid];
  D19 [label="i++",shape=box,style=solid];
  D20 [label="call site NR_OPEN_MAX=256, not helper guard",shape=box,style=dashed];
  D21 [label="new file_s address differs; pointer fields shallow copied",shape=box,style=solid];
  U0 [label="begin_new_exec calls unshare_files when reached",shape=box,style=solid];
  U1 [label="unshare_files: copy=NULL",shape=box,style=solid];
  U2 [label="unshare_fd(CLONE_FILES,NR_OPEN_MAX,&copy)",shape=box,style=solid];
  U3 [label="fd=current->files; error=0",shape=box,style=solid];
  U4 [label="SOURCE: flag & CLONE_FILES && fd && refcount>1",shape=diamond,style=solid];
  U5 [label="without duplication: output unchanged, return0",shape=box,style=solid];
  U6 [label="*new_fdp=dup_fd(fd,max_fds,&error)",shape=box,style=solid];
  U7 [label="if(!*new_fdp) return error; else return0",shape=box,style=solid];
  U8 [label="unshare_files: if(error||!copy)",shape=diamond,style=solid];
  U9 [label="return error; no table publication",shape=box,style=solid];
  U10 [label="old=task.files",shape=box,style=solid];
  U11 [label="task_lock(task)",shape=box,style=solid];
  U12 [label="task.files=copy",shape=box,style=solid];
  U13 [label="task_unlock(task)",shape=box,style=solid];
  U14 [label="put_files_struct(old)",shape=box,style=solid];
  U15 [label="return0 if put returns normally",shape=box,style=solid];
  U16 [label="ANALYTIC: old identity stable, valid refcount; no other writer",shape=box,style=dashed];
  U17 [label="STOP if old invalid or put fails to return",shape=octagon,style=solid];
  C0 [label="files_struct refcount vs per-file f_count distinct",shape=box,style=dashed];
  I0 -> I1 [label="DATA: initial address",style=solid];
  I0 -> I2 [label="ANALYTIC: actual current?",style=dashed];
  I2 -> P0 [label="ANALYTIC: only if selected current",style=dashed];
  P0 -> P1 [label="CALL: valid precursor",style=solid];
  P1 -> P2 [label="SOURCE: copy_process later call",style=solid];
  P1 -> P14 [label="ANALYTIC: copied address before branch",style=dashed];
  P2 -> P3 [label="CALL: call",style=solid];
  P3 -> P4 [label="SOURCE: source",style=solid];
  P4 -> P5 [label="SOURCE: oldf NULL",style=solid];
  P4 -> P6 [label="SOURCE: oldf nonNULL",style=solid];
  P6 -> P7 [label="SOURCE: CLONE_FILES set",style=solid];
  P7 -> P8 [label="SOURCE: source",style=solid];
  P14 -> P8 [label="ANALYTIC: pointer inherited",style=dashed];
  P6 -> P9 [label="SOURCE: CLONE_FILES clear",style=solid];
  P9 -> D0 [label="CALL: dup_fd",style=solid];
  D4 -> P10 [label="RETURN: null",style=solid];
  D8 -> P10 [label="RETURN: newf",style=solid];
  P10 -> P11 [label="SOURCE: newf NULL",style=solid];
  P10 -> P12 [label="SOURCE: newf valid",style=solid];
  P12 -> P13 [label="SOURCE: source",style=solid];
  D0 -> D1 [label="SOURCE: source",style=solid];
  D1 -> D2 [label="SOURCE: source",style=solid];
  D2 -> D3 [label="SOURCE: source",style=solid];
  D3 -> D4 [label="SOURCE: alloc NULL",style=solid];
  D3 -> D5 [label="SOURCE: newf valid",style=solid];
  D5 -> D6 [label="SOURCE: source",style=solid];
  D6 -> D7 [label="SOURCE: source",style=solid];
  D7 -> D8 [label="SOURCE: i>=max_fds",style=solid];
  D7 -> D9 [label="SOURCE: i<max_fds",style=solid];
  D9 -> D10 [label="ANALYTIC: i>=256",style=dashed];
  D9 -> D11 [label="ANALYTIC: i<256",style=dashed];
  D11 -> D12 [label="SOURCE: source",style=solid];
  D12 -> D13 [label="SOURCE: old_fp NULL",style=solid];
  D13 -> D19 [label="SOURCE: source",style=solid];
  D12 -> D14 [label="SOURCE: old_fp nonNULL",style=solid];
  D14 -> D15 [label="ANALYTIC: valid target/source",style=dashed];
  D15 -> D16 [label="ANALYTIC: NULL/invalid",style=dashed];
  D15 -> D17 [label="SOURCE: both valid",style=solid];
  D17 -> D18 [label="SOURCE: source",style=solid];
  D17 -> D21 [label="DATA: value copy not deep copy",style=solid];
  D18 -> D19 [label="SOURCE: source",style=solid];
  D19 -> D7 [label="SOURCE: next i",style=solid];
  D20 -> D7 [label="NOTE: caller input not bound check",style=dashed];
  C0 -> P7 [label="NOTE: table count",style=dashed];
  C0 -> D17 [label="NOTE: file count copied as value",style=dashed];
  U0 -> U1 [label="SOURCE: source",style=solid];
  U1 -> U2 [label="SOURCE: source",style=solid];
  U2 -> U3 [label="CALL: unshare_fd",style=solid];
  U3 -> U4 [label="SOURCE: source",style=solid];
  U4 -> U5 [label="SOURCE: test false",style=solid];
  U5 -> U8 [label="RETURN: copy unchanged NULL in this caller",style=solid];
  U4 -> U6 [label="SOURCE: test true",style=solid];
  U6 -> D0 [label="CALL: dup_fd",style=solid];
  D4 -> U7 [label="RETURN: NULL",style=solid];
  D8 -> U7 [label="RETURN: newf",style=solid];
  U7 -> U8 [label="RETURN: error/copy",style=solid];
  U8 -> U9 [label="SOURCE: error or no copy",style=solid];
  U8 -> U10 [label="SOURCE: valid copy and zero error",style=solid];
  U10 -> U11 [label="SOURCE: source",style=solid];
  U11 -> U12 [label="SOURCE: lock returns",style=solid];
  U12 -> U13 [label="SOURCE: source",style=solid];
  U13 -> U16 [label="ANALYTIC: old remains valid/stable",style=dashed];
  U16 -> U14 [label="SOURCE: valid",style=solid];
  U16 -> U17 [label="ANALYTIC: invalid old/table",style=dashed];
  U14 -> U15 [label="RETURN: put normal return",style=solid];
  U14 -> U17 [label="ANALYTIC: put nonreturn",style=dashed];
  I1 -> U16 [label="ANALYTIC: static origin relevant only if actual old",style=dashed];
  D21 -> U12 [label="DATA: copy has separate file_s objects",style=solid];
}
