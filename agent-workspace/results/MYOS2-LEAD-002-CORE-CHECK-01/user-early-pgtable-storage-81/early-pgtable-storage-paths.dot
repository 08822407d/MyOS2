digraph CORE_USER_EARLY_PGTABLE_STORAGE_81 {
  graph [label="第81批：brk页表缓冲、提前映射、三阶段存储源；静态关系图，不是运行CFG", labelloc="t", rankdir="LR"];
  node [shape=box,fontname="sans-serif",fontsize=10];
  edge [fontname="sans-serif",fontsize=8];
  // type is semantic: CALL, CALLER_SEQUENCE, DATA, MACRO, CONDITION, ANALYSIS_STOP, HYPOTHETICAL_SEQUENCE
  subgraph cluster_A {
    label="G01 缓冲区来源和别名";
    A_sizemacro [label="PMD_SIZE×4=8MiB [A04-A06]"];
    A_reservemacro [label="RESERVE_BRK→.bss..brk [A07]"];
    A_bss [label="linker .bss* [A08]"];
    A_brksec [label="linker .brk* &64KiB [A09-A10]"];
    A_setup [label="setup_arch"];
    A_extend [label="extend_brk(8MiB,2MiB) [A13-A16]"];
    A_brkcursor [label="_brk_end + mask, limit [A14]"];
    A_phys [label="__pa / __phys_addr_nodebug [A29-A30]"];
    A_start [label="pgt_buf_start PFN [A17]"];
    A_pud [label="early_pgtbuf_pud IMAGE alias"];
    A_pmd [label="early_pgtbuf_pmd IMAGE alias"];
    A_end [label="pgt_buf_end=start+2"];
    A_top [label="pgt_buf_top=start+2048"];
    A_close [label="reserve_brk()"];
    A_reserve [label="simple_mmblk_reserve()"];
    A_link_stop [label="STOP: link-map / brk bound",style=dashed];
    A_alias_stop [label="STOP: alias/writable mapping",style=dashed];
  }
  subgraph cluster_B {
    label="G02 页表链接和root发布";
    B_setup [label="setup_arch"];
    B_map [label="myos_early_map_pgt_buf_into_directmap"];
    B_phys [label="phys_start/end from buffer PFNs"];
    B_va [label="__va(phys_start)/vend"];
    B_early [label="early_top_pgt[pgd_index(va)]"];
    B_init [label="init_top_pgt[pgd_index(va)]"];
    B_guard [label="commented boundary checks, not gate"];
    B_pudclear [label="memset(PUD,0,PAGE_SIZE)"];
    B_p4d_pop [label="p4d_populate"];
    B_pudslot [label="pud_base[pud_index(va)]"];
    B_pmdclear [label="memset(PMD,0,PAGE_SIZE)"];
    B_pud_pop [label="pud_populate"];
    B_loop [label="nr_pmd and i/pa loop"];
    B_pmdidx [label="pmd_index(this_va)"];
    B_leaf [label="set_pmd(__pmd(pa|pgprot_val(...)))"];
    B_flush [label="__flush_tlb_all"];
    B_copy [label="*init_pgd=*early_pgd"];
    B_later [label="init_mem_mapping/load_cr3"];
    B_cross_stop [label="STOP: crossed PUD or PGD parent",style=dashed];
    B_addr_stop [label="STOP: addr/flags/writable alias",style=dashed];
    B_model [label="isolated 1GiB crossing model"];
  }
  subgraph cluster_C {
    label="G03 分配来源和清零";
    C_wrap [label="alloc_low_page wrapper num1"];
    C_alloc [label="alloc_low_pages(num)"];
    C_phase [label="after_bootmem predicate"];
    C_meminit [label="mem_init produces after_bootmem=1"];
    C_order [label="get_order(num<<PAGE_SHIFT)"];
    C_gfp [label="GFP_ATOMIC|__GFP_ZERO"];
    C_getfree [label="__get_free_pages"];
    C_allocpages [label="alloc_pages (callee via get_free_pages)"];
    C_hook [label="post_alloc_hook (conditional)"];
    C_retlate [label="late return pointer or zero"];
    C_cursor [label="pgt_buf_end + num"];
    C_top [label="pgt_buf_top"];
    C_capacity [label="buffer capacity predicate"];
    C_window [label="min_pfn_mapped<max_pfn_mapped"];
    C_fallback [label="memblock_phys_alloc_range"];
    C_retphys [label="phys ret; 0 check"];
    C_pfn [label="pfn=ret>>12 or old end"];
    C_endwrite [label="pgt_buf_end+=num"];
    C_clearloop [label="for int i<num clear_page(__va(...))"];
    C_ret [label="return __va(pfn<<PAGE_SHIFT)"];
    C_panic [label="panic();while(1) source"];
    C_stopnum [label="STOP: num/overflow/int width",style=dashed];
    C_stopmap [label="STOP: PFN mapping/writability",style=dashed];
    C_stoplate [label="STOP: late hook ZERO reachability",style=dashed];
    C_model [label="isolated num/order/fallback models"];
  }
  A_sizemacro -> A_extend [type="DATA", label="DATA | runtime bytes and alignment"];
  A_sizemacro -> A_reservemacro [type="DATA", label="DATA | static nominal bytes +PMD_SIZE"];
  A_reservemacro -> A_bss [type="DATA", label="DATA | section name .bss..brk matches .bss* textually"];
  A_reservemacro -> A_brksec [type="CONDITION", label="CONDITION | distinct .brk* section pattern; actual link object unresolved"];
  A_bss -> A_link_stop [type="ANALYSIS_STOP", label="ANALYSIS_STOP | no actual link map",style=dashed];
  A_brksec -> A_link_stop [type="ANALYSIS_STOP", label="ANALYSIS_STOP | brk_limit cannot be inferred from nominal macro",style=dashed];
  A_setup -> A_extend [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | calls early_alloc_pgt_buf -> extend_brk; not direct setup->extend"];
  A_extend -> A_brkcursor [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | align then limit/ret/memset"];
  A_extend -> A_phys [type="DATA", label="DATA | return virtual image-brk pointer"];
  A_phys -> A_start [type="DATA", label="DATA | base physical>>PAGE_SHIFT"];
  A_phys -> A_pud [type="DATA", label="DATA | base + START_KERNEL_map image alias"];
  A_pud -> A_pmd [type="DATA", label="DATA | +PAGE_SIZE separate table page"];
  A_start -> A_end [type="DATA", label="DATA | end=start+2"];
  A_start -> A_top [type="DATA", label="DATA | top=start+2048"];
  A_pud -> A_alias_stop [type="ANALYSIS_STOP", label="ANALYSIS_STOP | image alias writability unknown",style=dashed];
  A_setup -> A_close [type="CALL", label="CALL | setup_arch calls reserve_brk"];
  A_extend -> A_close [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | through setup_arch, after early_alloc returns"];
  A_close -> A_reserve [type="CALL", label="CALL | reserve_brk conditional direct call"];
  A_reserve -> A_link_stop [type="ANALYSIS_STOP", label="ANALYSIS_STOP | request does not mean success",style=dashed];
  A_start -> B_phys [type="DATA", label="DATA | PFN physical domain"];
  A_top -> B_phys [type="DATA", label="DATA | PFN physical domain"];
  A_pud -> B_pudclear [type="DATA", label="DATA | table alias"];
  A_pmd -> B_pmdclear [type="DATA", label="DATA | table alias"];
  B_setup -> B_map [type="CALL", label="CALL | setup_arch invokes early mapping"];
  B_map -> B_phys [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | read PFN state"];
  B_phys -> B_va [type="DATA", label="DATA | __va expression"];
  B_va -> B_early [type="DATA", label="DATA | pgd_index(va)"];
  B_va -> B_init [type="DATA", label="DATA | pgd_index(va)"];
  B_va -> B_guard [type="DATA", label="DATA | commented checks have no active stop effect"];
  B_early -> B_pudclear [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | root selected before zero"];
  B_pudclear -> B_p4d_pop [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | zero PUD then populate"];
  B_map -> B_p4d_pop [type="CALL", label="CALL | macro->fill_pud_to_p4d_ent"];
  B_p4d_pop -> B_early [type="DATA", label="DATA | write early root entry"];
  B_p4d_pop -> B_pudslot [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | parent created then pick one PUD entry"];
  B_va -> B_pudslot [type="DATA", label="DATA | pud_index(va)"];
  B_pudslot -> B_pmdclear [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | select then zero PMD"];
  B_pmdclear -> B_pud_pop [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | PMD page cleared before parent populate"];
  B_map -> B_pud_pop [type="CALL", label="CALL | macro->fill_pmd_to_pud_ent"];
  B_pud_pop -> B_pudslot [type="DATA", label="DATA | write one PUD entry"];
  B_pud_pop -> B_loop [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | before leaf writes"];
  B_phys -> B_loop [type="DATA", label="DATA | nr_pmd=(phys_end-start)/PMD_SIZE"];
  B_va -> B_pmdidx [type="DATA", label="DATA | this_va index each loop"];
  B_loop -> B_pmdidx [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | iteration va/pa"];
  B_pmdidx -> B_leaf [type="DATA", label="DATA | pmd_base[slot]"];
  B_loop -> B_leaf [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | construct pa and flags"];
  B_map -> B_leaf [type="CALL", label="CALL | set_pmd macro to set_pmd_ent"];
  B_loop -> B_model [type="HYPOTHETICAL_SEQUENCE", label="HYPOTHETICAL_SEQUENCE | arithmetic boundary cases only",style=dashed];
  B_model -> B_cross_stop [type="ANALYSIS_STOP", label="ANALYSIS_STOP | 1GiB/512GiB parent change",style=dashed];
  B_va -> B_addr_stop [type="ANALYSIS_STOP", label="ANALYSIS_STOP | invalid __va/vend expression",style=dashed];
  B_leaf -> B_flush [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | all leaves then local flush request"];
  B_map -> B_flush [type="CALL", label="CALL | __flush_tlb_all"];
  B_flush -> B_copy [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | copy root AFTER flush"];
  B_early -> B_copy [type="DATA", label="DATA | root value source"];
  B_copy -> B_init [type="DATA", label="DATA | one root entry target"];
  B_copy -> B_later [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | setup_arch later init_mem_mapping"];
  B_later -> C_stopmap [type="ANALYSIS_STOP", label="ANALYSIS_STOP | not proof mapping was active earlier",style=dashed];
  C_wrap -> C_alloc [type="CALL", label="CALL | wrapper num1"];
  C_meminit -> C_phase [type="DATA", label="DATA | after_bootmem=1 set in mem_init"];
  C_alloc -> C_phase [type="CONDITION", label="CONDITION | stage branch"];
  C_phase -> C_order [type="CONDITION", label="CONDITION | after_bootmem true"];
  C_order -> C_gfp [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | build flags + computed order"];
  C_alloc -> C_order [type="CALL", label="CALL | get_order"];
  C_alloc -> C_getfree [type="CALL", label="CALL | late direct call"];
  C_gfp -> C_getfree [type="DATA", label="DATA | GFP flags and order"];
  C_getfree -> C_allocpages [type="CALL", label="CALL | alloc_pages"];
  C_allocpages -> C_hook [type="HYPOTHETICAL_SEQUENCE", label="HYPOTHETICAL_SEQUENCE | page-layer hook conditional; do not draw direct call",style=dashed];
  C_hook -> C_stoplate [type="ANALYSIS_STOP", label="ANALYSIS_STOP | ZERO semantics depend on selected hook & index",style=dashed];
  C_getfree -> C_retlate [type="DATA", label="DATA | returns virtual or 0"];
  C_phase -> C_cursor [type="CONDITION", label="CONDITION | after_bootmem false"];
  A_end -> C_cursor [type="DATA", label="DATA | buffer cursor"];
  A_top -> C_top [type="DATA", label="DATA | buffer upper limit"];
  C_cursor -> C_capacity [type="CONDITION", label="CONDITION | sum > top"];
  C_top -> C_capacity [type="DATA", label="DATA | upper limit"];
  C_capacity -> C_window [type="CONDITION", label="CONDITION | insufficient"];
  C_window -> C_fallback [type="CONDITION", label="CONDITION | only min<max"];
  C_alloc -> C_fallback [type="CALL", label="CALL | conditional direct call"];
  C_fallback -> C_retphys [type="DATA", label="DATA | physical address or zero"];
  C_retphys -> C_panic [type="CONDITION", label="CONDITION | if !ret"];
  C_retphys -> C_pfn [type="DATA", label="DATA | ret>>PAGE_SHIFT if nonzero"];
  C_capacity -> C_pfn [type="CONDITION", label="CONDITION | sufficient -> pfn=old end"];
  C_pfn -> C_endwrite [type="CONDITION", label="CONDITION | buffer branch only"];
  C_endwrite -> C_clearloop [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | cursor advanced before clearing"];
  C_pfn -> C_clearloop [type="DATA", label="DATA | also used by fallback"];
  C_alloc -> C_clearloop [type="CALL", label="CALL | clear_page macro, per page"];
  C_clearloop -> C_ret [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | return after clearing"];
  C_cursor -> C_stopnum [type="ANALYSIS_STOP", label="ANALYSIS_STOP | overflow / invalid num",style=dashed];
  C_clearloop -> C_stopmap [type="ANALYSIS_STOP", label="ANALYSIS_STOP | __va writable not proven",style=dashed];
  C_order -> C_model [type="HYPOTHETICAL_SEQUENCE", label="HYPOTHETICAL_SEQUENCE | num3 order2, num0 invalid",style=dashed];
  C_model -> C_stopnum [type="ANALYSIS_STOP", label="ANALYSIS_STOP | int loop or get_order(0)",style=dashed];
  C_fallback -> C_stopmap [type="ANALYSIS_STOP", label="ANALYSIS_STOP | memblock physical allocated vs mapped",style=dashed];
}
