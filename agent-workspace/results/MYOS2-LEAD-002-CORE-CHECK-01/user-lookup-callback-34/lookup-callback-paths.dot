  fields [label="copy tmpde/iobuf metadata into finode"];
  assign [label="original dest_dentry.d_inode=p"];
  cleanup [label="build_inode_fail + ent_not_found labels"];
  release [label="FAT32_iobuf_release"];
  ret [label="return local dest_dentry"];
  uppernull [label="upper NULL -> kfree(original), ERR_PTR(-ENOENT)"];
  upperok [label="upper nonNULL -> read original inode/mapping"];
