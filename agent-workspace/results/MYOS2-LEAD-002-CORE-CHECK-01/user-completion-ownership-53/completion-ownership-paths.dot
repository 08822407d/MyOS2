// CO53 A/B/C NEW object-specific graph, no old52 graph re-drawn. NOT_RUN.
// Solid local; dashed cross-thread conditional; dotted STOP.
digraph CO53 {
 graph [rankdir=LR,labelloc=t,label="Completion ownership A/B/C"];
 node [shape=box,fontsize=10];
 Acreate [label="A create heap req"];
 Adelete [label="A delete stack req"];
 Auninit [label="A delete fields invalid STOP"];
 Asubmit [label="A submit init/publish"];
 Aw [label="A worker handle/write err"];
 Ac [label="A worker complete"];
 Af [label="A worker kfree(req)"];
 Ar [label="A caller wait done"];
 Aread [label="A caller read req.err"];
 Ast [label="A STOP lifetime/allocator"];
 Bcreate [label="B heap create & stack done"];
 Bname [label="B full_name independent"];
 Bq [label="B queue to kthreadd"];
 Bspawn [label="B create_kthread"];
 Bsuccess [label="B new kthread xchg(done)"];
 Bfail [label="B pid<0 xchg"];
 Bresult [label="B write result or ERR_PTR"];
 Bcomplete [label="B complete(done)"];
 Bcontinue [label="B schedule after complete"];
 Bwait [label="B creator wait"];
 Bread [label="B creator read result"];
 Bfree [label="B creator kfree(create)"];
 Btransfer [label="B self.full_name pointer"];
 Blater [label="B free_kthread_struct"];
 Bstop [label="B STOP framework/lifetime"];
 Kstatic [label="C keyboard static done"];
 Kirq [label="C keyboard handler"];
 Kbuf [label="C buffer count separate"];
 Kcomplete [label="C complete(getcode_done)"];
 Kwait [label="C repeated kbd_get_scancode"];
 Kstop [label="C STOP IRQ/CA04"];
 Inode [label="C IDE node + Params heap"];
 Idone [label="C IDE local stack done"];
 Iqueue [label="C IDE publish queue"];
 Iirq [label="C ATA IRQ count gate"];
 Icomplete [label="C end_request complete"];
 Iclear [label="C clear req_in_using"];
 Iwait [label="C ATA wait"];
 Ifree [label="C caller frees node/Params"];
 Istop [label="C STOP hardware/other users"];
 Acreate -> Asubmit [label="CALL: heap object",style=solid];
 Adelete -> Asubmit [label="CALL: stack address",style=solid];
 Adelete -> Auninit [label="STOP: first undefined member reads",style=dotted];
 Asubmit -> Aw [label="CROSS: worker may take queue",style=dashed];
 Aw -> Ac [label="CONTROL: if handle returns normally",style=solid];
 Ac -> Af [label="CONTROL: worker release request",style=solid];
 Asubmit -> Ar [label="CALL: wait",style=solid];
 Ac -> Ar [label="CROSS: matching completion",style=dashed];
 Ar -> Aread [label="CONTROL: after tmp NULL free",style=solid];
 Af -> Ast [label="STOP: lifetime unknown",style=dotted];
 Aread -> Ast [label="STOP: if freed earlier",style=dotted];
 Bcreate -> Bname [label="CONTROL: kvasprintf",style=solid];
 Bcreate -> Bq [label="DATA: create.done=&stack",style=solid];
 Bname -> Bq [label="CONTROL: if name valid",style=solid];
 Bq -> Bspawn [label="CROSS: dequeue",style=dashed];
 Bspawn -> Bsuccess [label="CROSS: new kernel thread",style=dashed];
 Bspawn -> Bfail [label="CONTROL: pid negative",style=solid];
 Bsuccess -> Btransfer [label="DATA: full name",style=solid];
 Btransfer -> Blater [label="CROSS: later free",style=dashed];
 Bsuccess -> Bresult [label="CONTROL: write create.result",style=solid];
 Bfail -> Bresult [label="CONTROL: ERR_PTR if done",style=solid];
 Bresult -> Bcomplete [label="CONTROL: notify",style=solid];
 Bcomplete -> Bcontinue [label="CONTROL: producer still executes",style=solid];
 Bq -> Bwait [label="CALL: creator wait",style=solid];
 Bcomplete -> Bwait [label="CROSS: matching done",style=dashed];
 Bwait -> Bread [label="RETURN: normal return",style=solid];
 Bread -> Bfree [label="CONTROL: free create",style=solid];
 Bcomplete -> Bstop [label="STOP: no full task lifecycle",style=dotted];
 Kstatic -> Kirq [label="DATA: static completion",style=solid];
 Kbuf -> Kirq [label="DATA: buffer separate",style=solid];
 Kirq -> Kcomplete [label="CONTROL: after buffer write",style=solid];
 Kcomplete -> Kwait [label="CROSS: if waiter resumes",style=dashed];
 Kstatic -> Kwait [label="CALL: same named done",style=solid];
 Kwait -> Kstop [label="STOP: CA04 conditional reuse",style=dotted];
 Inode -> Iqueue [label="DATA: node and params",style=solid];
 Idone -> Iqueue [label="DATA: node.done points stack",style=solid];
 Iqueue -> Iirq [label="CROSS: hardware path candidate",style=dashed];
 Iirq -> Icomplete [label="CONTROL: count0",style=solid];
 Icomplete -> Iclear [label="CONTROL: producer continues",style=solid];
 Iqueue -> Iwait [label="CALL: caller wait",style=solid];
 Icomplete -> Iwait [label="CROSS: if wait returns",style=dashed];
 Iwait -> Ifree [label="RETURN: free after wait",style=solid];
 Icomplete -> Istop [label="STOP: actual IRQ unknown",style=dotted];
}
