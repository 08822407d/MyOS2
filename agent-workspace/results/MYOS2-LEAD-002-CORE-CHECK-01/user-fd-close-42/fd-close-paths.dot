digraph CL42 {
  rankdir=LR;
  graph [label="CL42 fixed-source close and last-ref table teardown; analytical premises not source checks", labelloc=t];
  node [fontname="sans",shape=box];
  C0 [label="close(unsigned int fd)",shape=box,style=solid];
  C1 [label="current/files validity ANALYTIC premise",shape=box,style=dashed];
  C2 [label="SOURCE: fd<0(always false) || fd>=fd_count",shape=diamond,style=solid];
  C3 [label="return -EBADF",shape=box,style=solid];
  C4 [label="ANALYTIC physical fd<256",shape=box,style=dashed];
  C5 [label="fp = fd_array[fd]",shape=box,style=solid];
  C6 [label="invalid subscript STOP, not source return",shape=octagon,style=solid];
  C7 [label="kfree(fp) call (not fput)",shape=box,style=solid];
  C8 [label="selected kfree: if(object==NULL)",shape=diamond,style=solid];
  C9 [label="NULL early return from kfree",shape=box,style=solid];
  C10 [label="nonNULL kfree internal release dispatch",shape=box,style=solid];
  C11 [label="kfree returns normally to close",shape=box,style=solid];
  C12 [label="fd_array[fd] = NULL",shape=box,style=solid];
  C13 [label="close returns 0",shape=box,style=solid];
  C14 [label="invalid/unknown file cannot assume kfree returns",shape=octagon,style=solid];
  F0 [label="filp_close(file)",shape=box,style=solid];
  F1 [label="retval = 0",shape=box,style=solid];
  F2 [label="fput(file)",shape=box,style=solid];
  F3 [label="ANALYTIC: valid file and f_count positive",shape=box,style=dashed];
  F4 [label="atomic_long_dec_and_test(file.f_count)",shape=diamond,style=solid];
  F5 [label="not-zero branch: no cache free",shape=box,style=solid];
  F6 [label="zero branch: kmem_cache_free(filp_cachep,file)",shape=box,style=solid];
  F7 [label="filp_close returns retval(0) if normal",shape=box,style=solid];
  F8 [label="invalid count/object STOP",shape=octagon,style=solid];
  X0 [label="exit_files(tsk)",shape=box,style=solid];
  X1 [label="files=tsk->files; requires valid tsk",shape=box,style=solid];
  X2 [label="SOURCE: if(files)",shape=diamond,style=solid];
  X3 [label="no files; no action",shape=box,style=solid];
  X4 [label="task_lock(tsk)",shape=box,style=solid];
  X5 [label="tsk->files=NULL",shape=box,style=solid];
  X6 [label="task_unlock(tsk)",shape=box,style=solid];
  X7 [label="put_files_struct(files)",shape=box,style=solid];
  X8 [label="ANALYTIC valid files/refcount",shape=box,style=dashed];
  X9 [label="atomic_dec_and_test(files.refcount)",shape=diamond,style=solid];
  X10 [label="refcount stays positive; return",shape=box,style=solid];
  X11 [label="last ref: i=0 unsigned int",shape=box,style=solid];
  X12 [label="SOURCE loop: i<fd_count",shape=diamond,style=solid];
  X13 [label="ANALYTIC physical i<256",shape=box,style=dashed];
  X14 [label="out-of-bounds/invalid object STOP",shape=octagon,style=solid];
  X15 [label="file = fd_array[i]",shape=box,style=solid];
  X16 [label="SOURCE: if(file!=NULL)",shape=diamond,style=solid];
  X17 [label="NULL slot: no filp_close",shape=box,style=solid];
  X18 [label="call filp_close(file), result ignored",shape=box,style=solid];
  X19 [label="i++ and next iteration",shape=box,style=solid];
  X20 [label="kmem_cache_free(files_cachep,files)",shape=box,style=solid];
  X21 [label="put_files_struct returns if free call normal",shape=box,style=solid];
  X22 [label="ANALYTIC origin: init_files global, refcount1",shape=box,style=dashed];
  X23 [label="nonNULL but invalid file STOP",shape=octagon,style=solid];
  C0 -> C1 [label="ANALYTIC: valid current/files needed",style=dashed];
  C1 -> C2 [label="SOURCE: valid",style=solid];
  C2 -> C3 [label="SOURCE: fd>=fd_count",style=solid];
  C2 -> C4 [label="SOURCE: fd<fd_count",style=solid];
  C4 -> C6 [label="ANALYTIC: out-of-bounds",style=dashed];
  C4 -> C5 [label="ANALYTIC: in bounds",style=dashed];
  C5 -> C7 [label="SOURCE: control",style=solid];
  C7 -> C8 [label="CALL: if selected definition",style=solid];
  C7 -> C14 [label="ANALYTIC: non-NULL invalid object",style=dashed];
  C8 -> C9 [label="SOURCE: NULL",style=solid];
  C8 -> C10 [label="SOURCE: non-NULL",style=solid];
  C9 -> C11 [label="RETURN: return",style=solid];
  C10 -> C11 [label="RETURN: only if normal",style=solid];
  C11 -> C12 [label="SOURCE: valid table after call",style=solid];
  C12 -> C13 [label="SOURCE: control",style=solid];
  F0 -> F1 [label="SOURCE: control",style=solid];
  F1 -> F2 [label="SOURCE: control",style=solid];
  F2 -> F3 [label="ANALYTIC: file object validity",style=dashed];
  F3 -> F8 [label="ANALYTIC: invalid file or count",style=dashed];
  F3 -> F4 [label="SOURCE: valid",style=solid];
  F4 -> F5 [label="SOURCE: nonzero",style=solid];
  F4 -> F6 [label="SOURCE: zero",style=solid];
  F5 -> F7 [label="SOURCE: control",style=solid];
  F6 -> F7 [label="RETURN: if cache free returns",style=solid];
  X0 -> X1 [label="SOURCE: control",style=solid];
  X1 -> X2 [label="SOURCE: control",style=solid];
  X2 -> X3 [label="SOURCE: NULL",style=solid];
  X2 -> X4 [label="SOURCE: nonNULL",style=solid];
  X4 -> X5 [label="SOURCE: lock returns",style=solid];
  X5 -> X6 [label="SOURCE: control",style=solid];
  X6 -> X7 [label="SOURCE: control",style=solid];
  X7 -> X8 [label="ANALYTIC: valid saved files",style=dashed];
  X8 -> X9 [label="SOURCE: valid",style=solid];
  X8 -> X14 [label="ANALYTIC: invalid files",style=dashed];
  X9 -> X10 [label="SOURCE: not last ref",style=solid];
  X9 -> X11 [label="SOURCE: last ref",style=solid];
  X11 -> X12 [label="SOURCE: control",style=solid];
  X12 -> X20 [label="SOURCE: loop ends",style=solid];
  X12 -> X13 [label="SOURCE: i<fd_count",style=solid];
  X13 -> X14 [label="ANALYTIC: invalid physical index",style=dashed];
  X13 -> X15 [label="ANALYTIC: physical index valid",style=dashed];
  X15 -> X16 [label="SOURCE: control",style=solid];
  X16 -> X17 [label="SOURCE: NULL",style=solid];
  X17 -> X19 [label="SOURCE: control",style=solid];
  X16 -> X18 [label="SOURCE: nonNULL",style=solid];
  X18 -> X23 [label="ANALYTIC: file not a valid live object",style=dashed];
  X18 -> F0 [label="CALL: filp_close if valid",style=solid];
  F7 -> X19 [label="RETURN: filp_close returned; ignore retval",style=solid];
  X19 -> X12 [label="SOURCE: next i",style=solid];
  X20 -> X21 [label="RETURN: if release call normal",style=solid];
  X22 -> X20 [label="ANALYTIC: static object origin if selected and last ref",style=dashed];
}
