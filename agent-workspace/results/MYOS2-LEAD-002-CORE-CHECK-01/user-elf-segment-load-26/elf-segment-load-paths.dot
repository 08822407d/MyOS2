  unmapvma [label="simple_do_vma_munmap()"];
  trim [label="trailing overall-reservation range"];
  munmapret [label="trim return [ignored]"];
  probe_unmap [label="preliminary probe vm_munmap result [ignored]"];
  pad [label="padzero()"];
  padres [label="padzero() returned int; not the byte range"];
  clear [label="clear_user()"];
  rawclear [label="__clear_user()"];
  cleartarget [label="user tail byte range"];
