  load -> brk [label="conditional_call: memsz>filesz and previous gates permit", style=dashed];
  zero_start -> brk [label="data: ceil page start", style=solid];
  zero_end -> brk [label="data: ceil page end -> length", style=solid];
  prot -> brk [label="data: conditional VM_EXEC flag argument", style=solid];
  brk -> dobrk [label="conditional_call: only when PAGE_ALIGN(request)!=0", style=dashed];
  dobrk -> anon [label="effect_attempt: anonymous VMA create/merge/metadata conditionally", style=bold];
  dobrk -> mergelink [label="conditional_call: new-VMA branch", style=dashed];
  mergelink -> linkret [label="result: returned int (not checked)", style=solid];
  linkret -> dobrk [label="ignored_result: not consumed before return0", style=dashed];
  dobrk -> brkerr [label="result: returns int status", style=solid];
  brkerr -> load [label="result_consumed: nonzero overwrites map_addr", style=solid];
  mapaddr -> load [label="data: return from elf_load when no brk error", style=solid];
  load -> loader [label="result: returns ulong (address/error)", style=solid];
  loader -> bad [label="macro_use: post elf_load call BAD_ADDR(error)", style=solid];
  bad -> codederr [label="control: IS_ERR_VALUE / PTR_ERR on failure", style=solid];
  loader -> post [label="sequence: only after selected elf_load success", style=dashed];
