digraph FG41 {
  rankdir=LR;
  graph [label="FG41 fixed source vs analytic premises; static diagram NOT runtime trace",labelloc=t];
  node [fontname="sans",shape=box];
  M0 [label="mmap(fd: ulong)",shape=box,style=solid];
  M1 [label="off alignment SOURCE gate",shape=diamond,style=solid];
  M2 [label="return -EINVAL",shape=box,style=solid];
  M3 [label="MAP_ANONYMOUS SOURCE gate",shape=diamond,style=solid];
  M4 [label="fget(uint(fd)) low 32 bits in LP64",shape=box,style=solid];
  M5 [label="if(!file) SOURCE after fget",shape=diamond,style=solid];
  M6 [label="return -EBADF",shape=box,style=solid];
  M7 [label="vm_mmap_pgoff opaque call",shape=box,style=solid];
  M8 [label="if(file) fput(file)",shape=box,style=solid];
  M9 [label="return retval",shape=box,style=solid];
  M10 [label="MAP_HUGETLB anonymous gate",shape=diamond,style=solid];
  M11 [label="while(1): no normal exit proven",shape=octagon,style=solid];
  F0 [label="__simple_fget: fd<fd_count",shape=diamond,style=solid];
  F1 [label="return NULL without slot read",shape=box,style=solid];
  F2 [label="fd_array[fd] read",shape=box,style=solid];
  F3 [label="NULL/out-of-bounds/invalid file: no certified continuation",shape=octagon,style=solid];
  F4 [label="atomic_long_inc on valid file",shape=box,style=solid];
  F5 [label="return file_s* (acquired ref)",shape=box,style=solid];
  F6 [label="ANALYTIC: fd physical bound and object valid",shape=box,style=dashed];
  F7 [label="mask argument not consumed",shape=box,style=dashed];
  R0 [label="ksys_read uint fd",shape=box,style=solid];
  R1 [label="myos_fdget_pos(int): direct fd_array index flags=0",shape=box,style=solid];
  R2 [label="invalid index stop",shape=octagon,style=solid];
  R3 [label="if(f.file) SOURCE gate",shape=diamond,style=solid];
  R4 [label="return -EBADF",shape=box,style=solid];
  R5 [label="file_ppos + opaque vfs_read",shape=box,style=solid];
  R6 [label="ret>=0 && ppos: conditional f_pos",shape=box,style=solid];
  R7 [label="fdput_pos flags0: no fput",shape=box,style=solid];
  R8 [label="return ret",shape=box,style=solid];
  W0 [label="ksys_write unsigned int fd",shape=box,style=solid];
  W1 [label="fdget_pos(int)->__to_fd(ulong) flags=3",shape=box,style=solid];
  W2 [label="invalid index stop",shape=octagon,style=solid];
  W3 [label="if(filp!=NULL) SOURCE gate",shape=diamond,style=solid];
  W4 [label="return -EBADF",shape=box,style=solid];
  W5 [label="file_ppos + opaque vfs_write",shape=box,style=solid];
  W6 [label="ret>=0 && ppos: conditional f_pos",shape=box,style=solid];
  W7 [label="fdput_pos flags3: fput",shape=box,style=solid];
  W8 [label="return ret",shape=box,style=solid];
  M0 -> M1 [label="SOURCE: control",style=solid];
  M1 -> M2 [label="SOURCE: unaligned",style=solid];
  M1 -> M3 [label="SOURCE: aligned",style=solid];
  M3 -> M4 [label="SOURCE: nonanonymous",style=solid];
  M4 -> F0 [label="CALL: call",style=solid];
  F0 -> F1 [label="SOURCE: fd>=fd_count",style=solid];
  F0 -> F2 [label="SOURCE: fd<fd_count",style=solid];
  F6 -> F2 [label="ANALYTIC: physical index and file validity not checked by code",style=dashed];
  F2 -> F3 [label="ANALYTIC: invalid actual object or array index",style=dashed];
  F2 -> F4 [label="SOURCE: valid file_s assumed",style=solid];
  F4 -> F5 [label="SOURCE: control",style=solid];
  F5 -> M5 [label="RETURN: return",style=solid];
  F1 -> M5 [label="RETURN: return",style=solid];
  M5 -> M6 [label="SOURCE: file NULL",style=solid];
  M5 -> M7 [label="SOURCE: file valid",style=solid];
  M3 -> M10 [label="SOURCE: anonymous",style=solid];
  M10 -> M11 [label="SOURCE: HUGETLB",style=solid];
  M10 -> M7 [label="SOURCE: not HUGETLB, file=NULL",style=solid];
  M7 -> M8 [label="SOURCE: opaque normally returns",style=solid];
  M8 -> M9 [label="SOURCE: control",style=solid];
  F7 -> F0 [label="NOTE: no actual mask filter",style=dashed];
  R0 -> R1 [label="CALL: call",style=solid];
  R1 -> R2 [label="ANALYTIC: index invalid",style=dashed];
  R1 -> R3 [label="RETURN: valid index",style=solid];
