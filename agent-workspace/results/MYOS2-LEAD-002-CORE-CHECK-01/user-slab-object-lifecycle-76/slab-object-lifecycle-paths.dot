  B_ONLINE -> B_STATS_UP [label="WRITE: nr_slabs and total_objects",style=solid];
  B_ONLINE -> B_RETRY [label="RETURN_TO_CALLER: after online returns",style=solid];
  B_RETRY -> B_GET [label="CALL: next while condition",style=solid];
  B_ALLOC -> B_HOOK [label="CALLER_CONDITION: only valid object",style=solid];
  B_READ -> B_STOP [label="ANALYSIS_STOP: bad object before post NULL test",style=dotted];
  B_LIST_DELETE -> B_STOP [label="ANALYSIS_STOP: contains or node inconsistent",style=dotted];
  B_LIST_ADD -> B_STOP [label="ANALYSIS_STOP: insert validity uncertain",style=dotted];
  C_ENTRY -> C_FREE [label="CALL: arg virt_to_slab pre-evaluated",style=solid];
  C_ENTRY -> C_STOP [label="ANALYSIS_STOP: bad x conversion before slab_free",style=dotted];
  C_FREE -> C_RETURN [label="CALL: free_to_partial_list",style=solid];
  C_RETURN -> C_WAS_FULL [label="READ: before inuse decrement",style=solid];
  C_WAS_FULL -> C_FULL2PART [label="CONDITION: true branch",style=solid];
  C_FULL2PART -> B_FULL [label="MACRO_CALL: remove from full",style=solid];
  C_FULL2PART -> B_PARTIAL [label="MACRO_CALL: add to partial",style=solid];
  C_RETURN -> C_SINGLE [label="CALL: regardless full/partial",style=solid];
  C_SINGLE -> C_PUSH [label="WRITE: inuse--, freenext pointer and head",style=solid];
  C_PUSH -> C_UNLOCK [label="CALLER_SEQUENCE: spin_unlock_irqrestore",style=solid];
  C_UNLOCK -> C_OR [label="CALLER_SEQUENCE: after free_to_partial_list returns",style=solid];
  A_MIN -> C_OR [label="DATA: min_partial",style=solid];
  B_PARTIAL -> C_OR [label="DATA: partial.count after return",style=solid];
  C_OR -> C_OFFLINE [label="CONDITION: inuse0 OR threshold",style=solid];
