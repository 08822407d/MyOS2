  A_OPEN -> B_FULL [label="INITIALIZE: INIT_LIST_HEADER_S",style=solid];
  A_CACHE -> A_PAGE [label="DATA: s.oo.order/allocflags",style=solid];
  A_PAGE -> A_INIT [label="RETURN: valid slab pointer if page alloc succeeded",style=solid];
  A_INIT -> A_SLAB [label="WRITE: objects,inuse0,frozen0,slab_cache",style=solid];
  A_INIT -> A_START [label="WRITE: start/free list",style=solid];
  A_START -> A_LOOP [label="SEQUENCE: slot cursor",style=solid];
  A_LOOP -> A_SETUP [label="CALL: only next slots, not slot0",style=solid];
  A_SETUP -> A_WRITE [label="CALLER_SEQUENCE: after ctor returns",style=solid];
  A_LOOP -> A_WRITE [label="SEQUENCE: per preceding slot",style=solid];
  A_WRITE -> A_FINAL [label="CALLER_SEQUENCE: after loop final NULL",style=solid];
  A_WRITE -> A_STOP [label="ANALYSIS_STOP: invalid offset/target",style=dotted];
  A_OO -> A_STOP [label="ANALYSIS_STOP: unproved width or zero objects",style=dotted];
  B_ENTRY -> B_ALLOC [label="CALL: slab_alloc(s,flags)",style=solid];
  B_ALLOC -> B_GET [label="CALL: while repeats",style=solid];
  B_GET -> B_LOCK [label="LOCK_REQUEST: locks around list operations",style=solid];
  B_GET -> B_ITER [label="MACRO: list_header_for_each_container_safe",style=solid];
  B_ITER -> B_TAKE [label="CALLER_CONDITION: on each valid slab",style=solid];
  B_TAKE -> B_READ [label="CALL: get_freepointer(s,object)",style=solid];
  B_READ -> B_INUSE [label="CALLER_SEQUENCE: if get_freepointer returns",style=solid];
  B_INUSE -> B_FULLGATE [label="CALLER_CONDITION: caller tests after returning object",style=solid];
  B_FULLGATE -> B_RM_PART [label="CONDITION: equals objects",style=solid];
  B_RM_PART -> B_LIST_DELETE [label="MACRO_CALL: conditional membership",style=solid];
  B_FULLGATE -> B_ADD_FULL [label="CONDITION: after remove call",style=solid];
  B_ADD_FULL -> B_LIST_ADD [label="MACRO_CALL: add full",style=solid];
  B_RM_PART -> B_PARTIAL [label="STATE: partial.count may decrement",style=solid];
  B_ADD_FULL -> B_FULL [label="STATE: full.count may increase",style=solid];
  B_GET -> B_ALLOC [label="RETURN: returns object or NULL",style=solid];
  B_ALLOC -> B_NEW [label="CALLER_CONDITION: partial miss; NOT direct get call",style=solid];
  B_NEW -> A_PAGE [label="CALL: alloc_slab when new",style=solid];
  B_NEW -> B_NULL [label="CONDITION: alloc_slab returned NULL",style=solid];
  B_NEW -> B_ONLINE [label="CALLER_CONDITION: valid new slab",style=solid];
