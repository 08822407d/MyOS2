  A_CACHE -> A_CALC [label="DATA: object_size,align",style=solid];
  A_CALC -> A_ALIGN1 [label="SEQUENCE: first align",style=solid];
  A_ALIGN1 -> A_ALIGN2 [label="SEQUENCE: inuse field set first",style=solid];
  A_ALIGN2 -> A_ORDER [label="CALL: size input",style=solid];
  A_ORDER -> A_ORDER_OBJECTS [label="DATA: order to capacity",style=solid];
  A_ORDER_OBJECTS -> A_OO [label="CALL: obj_nr producer",style=solid];
  A_OO -> A_CACHE [label="DATA: s.oo updated",style=solid];
  A_OPEN -> A_MIN [label="SEQUENCE: after calculate_sizes success",style=solid];
