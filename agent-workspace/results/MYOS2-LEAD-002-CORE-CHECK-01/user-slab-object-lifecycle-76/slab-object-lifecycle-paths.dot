// Bounded source-evidence graph, NOT compiled CFG or runtime-state proof.
// DATA, CALLER_SEQUENCE, RETURN_TO_CALLER, HISTORICAL_CONDITION and ANALYSIS_STOP are not unconditional executable calls.
digraph SL76 {
  rankdir=LR;
  node [shape=box];
  A_CACHE [label="kmem_cache fields: object_size,size,align,inuse,offset,ctor,oo"];
  A_OPEN [label="simple_kmem_cache_open"];
  A_CALC [label="simple_calculate_sizes"];
  A_ALIGN1 [label="ALIGN(object_size,sizeof(void*)) then cache.inuse"];
  A_ALIGN2 [label="ALIGN(cache.inuse,cache.align) then cache.size"];
  A_ORDER [label="simple_calculate_order"];
  A_ORDER_OBJECTS [label="order_objects=(PAGE_SIZE<<order)/size"];
  A_OO [label="oo_make: oo.order16/oo.obj_nr16"];
  A_MIN [label="min_partial: clamp MIN4 MAX8 ilog2(size)/2"];
  A_PAGE [label="alloc_slab: alloc_pages with oo.order"];
  A_INIT [label="alloc_init_new_slab"];
  A_SLAB [label="slab: objects15,inuse16,frozen1,slab_cache"];
  A_START [label="start=page_to_virt(folio.page), freelist=start"];
  A_LOOP [label="for i=0..objects-2: next=p+cache.size"];
  A_SETUP [label="setup_object(s,next) ctor if set"];
  A_WRITE [label="set_freepointer(s,p,next) at offset"];
  A_FINAL [label="set_freepointer(last,NULL)"];
  A_STOP [label="ANALYSIS_STOP invalid count, offset, pointer or capacity"];
  A_ALIAS [label="calculate_order/sizes/kmem_cache_open and oo accessor macro aliases"];
  B_ENTRY [label="kmem_cache_alloc"];
  B_ALLOC [label="slab_alloc caller while"];
  B_GET [label="get_from_partial_list"];
  B_ITER [label="iter_partial_list safe macro"];
  B_LOCK [label="node.list_lock allocation region"];
  B_TAKE [label="alloc_single_from_partial"];
  B_READ [label="get_freepointer before caller NULL check"];
  B_INUSE [label="slab.inuse++"];
  B_FULLGATE [label="inuse==objects?"];
  B_RM_PART [label="remove_from_partial -> list_header_delete_node"];
  B_ADD_FULL [label="add_to_full -> list_header_add_to_head"];
  B_PARTIAL [label="node.partial List_hdr count"];
  B_FULL [label="node.full List_hdr count"];
  B_NEW [label="alloc_init_new_slab on partial miss"];
  B_ONLINE [label="online_new_empty_slab"];
  B_STATS_UP [label="nr_slabs++,total_objects+=objects"];
  B_RETRY [label="slab_alloc re-fetch object after online"];
  B_HOOK [label="slab_post_alloc_hook after object found"];
  B_NULL [label="NULL return if new slab creation fails"];
  B_STOP [label="ANALYSIS_STOP NULL freelist, bad linked nodes or get_freepointer"];
  B_LIST_DELETE [label="list_header_delete_node: contains/test then conditional decrement"];
  B_LIST_ADD [label="list_header_add_to_head: request link then ++count"];
  C_ENTRY [label="kmem_cache_free(s,virt_to_slab(x),x)"];
  C_FREE [label="slab_free"];
  C_RETURN [label="free_to_partial_list with lock"];
  C_WAS_FULL [label="if old inuse==objects"];
  C_FULL2PART [label="remove_from_full and add_to_partial"];
  C_SINGLE [label="free_single_to_partial"];
  C_PUSH [label="inuse--, set_freepointer, freelist=object"];
  C_UNLOCK [label="unlock then slab_free condition"];
  C_OR [label="slab.inuse==0 OR partial.count>=min_partial"];
  C_MC07 [label="MC-07: live slab may reach threshold; historical root"];
  C_OFFLINE [label="offline_exceeded_empty_slab reacquire lock"];
  C_DELETE [label="remove_from_partial return ignored"];
  C_STATS_DOWN [label="nr_slabs--/total_objects-=objects independent of delete result"];
  C_FREESLAB [label="free_slab"];
  C_PG_HEAD [label="oo.order==0 && folio.PG_head!=0 while"];
  C_FLAGS [label="folio.mapping=NULL, barrier, clear slab flag"];
  C_FREEPAGES [label="__free_pages request boundary"];
  C_STOP [label="ANALYSIS_STOP invalid origin, underflow, concurrency or prior failure"];
  C_WIN [label="unlock -> OR read -> re-lock window"];
  A_OPEN -> A_CALC [label="MACRO_CALL: calculate_sizes alias",style=solid];
  A_ALIAS -> A_CALC [label="MACRO_ALIAS: calculate_sizes",style=solid];
