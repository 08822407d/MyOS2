digraph MYOS2_VFS_MUTATION_GATES_58 {
  graph [rankdir=LR, label="D00 repair + bounded VFS mutation consumer relations (NOT full CFG)", labelloc=t];
  node [shape=box];
  edge [fontsize=9];
  subgraph cluster_D {
    label="D00 prior57 disposition";
    old32 [label="57 evidence A32 (out-of-definition comment)"];
    new32 [label="D01-D03 replacement inside struct"];
    oldstatus [label="57 prior canonical_status (invalid)"];
    realstatus [label="source_field/source_value + supplement"];
    pending [label="CORRECTION_SUBMITTED_PENDING_MAINLINE"];
  }
  subgraph cluster_A {
    label="A parent/path/name";
    raw [label="valid pathname source"];
    getname [label="getname/getname_kernel"];
    filename [label="filename_s buffer"];
    setnd [label="set_nameidata"];
    parentat [label="filename_parentat"];
    pathparent [label="path_parentat"];
    pathinit [label="path_init"];
    walk [label="link_path_walk"];
    last [label="nd.last / LAST type"];
    hash [label="__lookup_hash"];
    lookup [label="__d_lookup"];
    cachehit [label="cached dentry"];
    alloc [label="__myos_d_alloc"];
    dname [label="owned dentry.d_name copy"];
    callback [label="dir.i_op.lookup"];
    allocbad [label="ERR_PTR allocation / invalid object STOP", shape=octagon];
    striptail [label="vfat_striptail_len/strrchr boundary"];
  }
  subgraph cluster_B {
    label="B create/mkdir";
    fc [label="filename_create"];
    creat [label="do_creatat"];
    mkdir [label="do_mkdirat"];
    vmkdir [label="vfs_mkdir"];
    imkdir [label="init_mkdir"];
    createcb [label="dir.i_op.create"];
    mkdircb [label="dir.i_op.mkdir"];
    excl [label="LOOKUP_CREATE/EXCL bits"];
    slash [label="is_dir then trailing slash branch"];
    mode [label="mode mask"];
    done [label="done_path_create"];
    putname [label="putname"];
    pathput [label="path_put"];
    dput [label="dput (no-op body)"];
    no_method [label="direct -EPERM; skips cleanup"];
    namebad [label="ERR_PTR name to putname STOP", shape=octagon];
  }
  subgraph cluster_C {
    label="C rmdir/unlink";
    rmdir [label="do_rmdir"];
    unlink [label="do_unlinkat"];
    vrmdir [label="vfs_rmdir"];
    vunlink [label="vfs_unlink"];
    rcb [label="dir.i_op.rmdir"];
    ucb [label="dir.i_op.unlink"];
    typed [label="LAST and S_ISDIR guards"];
    negative [label="negative dentry / NULL inode"];
    nullbad [label="S_ISDIR(NULL inode) STOP", shape=octagon];
    dget [label="dget (returns pointer)"];
    iput [label="iput (no-op body)"];
    sdead [label="S_DEAD only successful rmdir"];
    fatold [label="57 conditional FAT release/parent mark"];
    returnc [label="outer error and cleanup request"];
  }
  old32 -> new32 [label="DATA"];
  new32 -> pending [label="DATA"];
  oldstatus -> realstatus [label="DATA"];
  realstatus -> pending [label="DATA"];
  raw -> getname [label="DATA"];
  getname -> filename [label="RETURN"];
  filename -> setnd [label="DATA"];
  parentat -> setnd [label="CALL"];
  parentat -> pathparent [label="CALL"];
  pathparent -> pathinit [label="CALL"];
  pathparent -> walk [label="CALL"];
  walk -> last [label="DATA"];
  last -> parentat [label="RETURN"];
  parentat -> fc [label="RETURN"];
  fc -> hash [label="CALL"];
  last -> hash [label="DATA"];
  hash -> lookup [label="CALL"];
  lookup -> cachehit [label="RETURN"];
  cachehit -> hash [label="RETURN"];
  hash -> alloc [label="CALL"];
  alloc -> dname [label="DATA"];
  alloc -> callback [label="LOCAL_CONTROL"];
  hash -> callback [label="CALL"];
  alloc -> allocbad [label="ANALYSIS_STOP"];
  dname -> striptail [label="DATA"];
  fc -> excl [label="LOCAL_CONTROL"];
  fc -> slash [label="LOCAL_CONTROL"];
  creat -> fc [label="CALL"];
  mkdir -> fc [label="CALL"];
  imkdir -> vmkdir [label="CALL"];
  vmkdir -> mkdircb [label="CALL"];
  creat -> createcb [label="CALL"];
  mkdir -> mkdircb [label="CALL"];
  creat -> mode [label="LOCAL_CONTROL"];
  mkdir -> mode [label="LOCAL_CONTROL"];
  vmkdir -> mode [label="LOCAL_CONTROL"];
  creat -> done [label="CALL"];
  mkdir -> done [label="CALL"];
  done -> dput [label="CALL"];
  done -> pathput [label="CALL"];
  pathput -> dput [label="CALL"];
  creat -> putname [label="CALL"];
  mkdir -> putname [label="CALL"];
  creat -> no_method [label="LOCAL_CONTROL"];
  mkdir -> no_method [label="LOCAL_CONTROL"];
  filename -> namebad [label="ANALYSIS_STOP"];
  namebad -> putname [label="DATA"];
  putname -> namebad [label="ANALYSIS_STOP"];
  rmdir -> parentat [label="CALL"];
  unlink -> parentat [label="CALL"];
  rmdir -> hash [label="CALL"];
  unlink -> hash [label="CALL"];
  rmdir -> typed [label="LOCAL_CONTROL"];
  unlink -> typed [label="LOCAL_CONTROL"];
  hash -> negative [label="DATA"];
  negative -> nullbad [label="DATA"];
  unlink -> nullbad [label="ANALYSIS_STOP"];
  rmdir -> vrmdir [label="CALL"];
  unlink -> vunlink [label="CALL"];
  vrmdir -> dget [label="CALL"];
  vrmdir -> rcb [label="CALL"];
  rcb -> vrmdir [label="RETURN"];
  vrmdir -> sdead [label="LOCAL_CONTROL"];
  vrmdir -> dput [label="CALL"];
  vunlink -> ucb [label="CALL"];
  ucb -> vunlink [label="RETURN"];
  vrmdir -> returnc [label="RETURN"];
  vunlink -> returnc [label="RETURN"];
  rmdir -> dput [label="CALL"];
  unlink -> dput [label="CALL"];
  unlink -> iput [label="CALL"];
  rmdir -> pathput [label="CALL"];
  unlink -> pathput [label="CALL"];
  rmdir -> putname [label="CALL"];
  unlink -> putname [label="CALL"];
  rcb -> fatold [label="DATA"];
  ucb -> fatold [label="DATA"];
