// AG56 source-level bounded graph: DATA_NOT_CALL is data dependency, not function invocation.
digraph AG56 {
 graph [rankdir=LR,label="FAT allocation geometry A/B/C"];
 node [shape=box,fontsize=10];
 Ar [label="read current cluster"];
 An [label="read do-tail getter->cluster"];
 Ars [label="STOP invalid next cluster"];
 Aw [label="write current cluster flags0"];
 Aget [label="next_cluster=FAT getter"];
 Akeep [label="ordinary next leaves cluster unchanged"];
 Ae [label="EOF finder and FAT links"];
 Aflags [label="set cluster=next,flags1"];
 Asec [label="sector stale under flags1"];
 As [label="STOP invalid source"];
 Bi [label="iobuf_init arrays only count>0"];
 Bowner [label="returned iobuf DATA"];
 Bcaller [label="fat_add_entries calls expand"];
 Bexp [label="expand(size_t nr,int tmp_nr)"];
 Bfind [label="finder candidate>1"];
 Barray [label="write arrays[tmp_nr]"];
 Bdec [label="tmp_nr++;nr--"];
 Bloop [label="nr>=0 always true"];
 Brollback [label="nr>0 rollback"];
 Bcommit [label="nr==0 commit"];
 Bnext [label="caller next ignores ret"];
 Bs [label="STOP arrays/capacity"];
 Cbp [label="BPB/GPT types"];
 Csb [label="read_fat32_superblock"];
 Cmul [label="u32 FAT-size product and cluster byte size"];
 Clba [label="clus_to_blknr"];
 Ccount [label="ROOTBLK count selected"];
 Cbuffer [label="buffer capacity/initialized bytes"];
 Cfat [label="FAT shift7/index127 and page count"];
 Cs [label="STOP hardware/unit unknown"];
 Ar -> An [label="IF_MORE",style=solid];
 An -> Ar [label="LOOP_NONZERO",style=solid];
 An -> Ars [label="STOP_INVALID",style=dotted];
 Aw -> Aget [label="IF_MORE",style=solid];
 Aget -> Akeep [label="NEXT_ORDINARY",style=solid];
 Akeep -> Aw [label="LOOP_UNCHANGED",style=solid];
 Aget -> Ae [label="NEXT_EOF",style=solid];
 Ae -> Aflags [label="IF_CANDIDATE",style=solid];
 Aflags -> Asec [label="FLAGS1",style=solid];
 Asec -> Aw [label="LOOP_STALE",style=solid];
 Ae -> As [label="STOP_BAD_CANDIDATE",style=dotted];
 Bi -> Bowner [label="DATA_RETURN",style=dashed];
 Bowner -> Bcaller [label="DATA_NOT_CALL",style=dashed];
 Bcaller -> Bexp [label="CALL",style=solid];
 Bexp -> Bfind [label="LOCAL",style=solid];
 Bfind -> Barray [label="VALID_FINDER_ALLOC",style=solid];
 Barray -> Bdec [label="LOCAL",style=solid];
 Bdec -> Bloop [label="LOCAL",style=solid];
 Bloop -> Bfind [label="LOOP",style=solid];
 Bfind -> Brollback [label="NO_CANDIDATE_NR_POS",style=solid];
 Bfind -> Bcommit [label="NO_CANDIDATE_NR_ZERO",style=solid];
 Barray -> Bs [label="STOP_INVALID_SLOT",style=dotted];
 Brollback -> Bnext [label="CALLER_IGNORES_INT",style=solid];
 Bcommit -> Bnext [label="CALLER_IGNORES_INT",style=solid];
 Cbp -> Csb [label="INPUT",style=solid];
 Csb -> Cmul [label="ASSIGN",style=solid];
 Cmul -> Clba [label="DATA",style=dashed];
 Clba -> Ccount [label="LBA_DATA",style=dashed];
 Ccount -> Cbuffer [label="MODEL_UNIT",style=dashed];
 Ccount -> Cfat [label="SECT_PER_PG",style=solid];
 Cfat -> Cs [label="STOP_LAYOUT",style=dotted];
 Cbuffer -> Cs [label="STOP_ACTUAL_IO",style=dotted];
}
