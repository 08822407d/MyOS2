  A_EXPAND [label="expand high order to low"];
  A_SPLIT [label="half-block added to lower free_area"];
  A_REF [label="refcount++ on delivered low block"];
  A_PREP [label="prep_new_page"];
  A_RETURN [label="selected alloc returns page"];
  A_FAIL [label="selected helper returns NULL; outer may continue"];
  B_ZERO [label="gfp & __GFP_ZERO condition"];
  B_HOOK [label="post_alloc_hook"];
  B_PGTO [label="page_to_virt(page)"];
  B_CLEAR [label="clear_page(base + i bytes)"];
  B_MEMSET [label="memset(start,0,PAGE_SIZE)"];
  B_INTERVAL [label="overlapping byte ranges not whole pages"];
  B_COMP [label="order>0 AND __GFP_COMP"];
  B_MAKE [label="prep_compound_page"];
  B_HEADFLAG [label="__SetPageHead"];
  B_TAIL [label="prep_compound_tail(s)"];
  B_TAILTAG [label="set_compound_head(head+1)"];
  B_HEAD [label="prep_compound_head"];
  B_FOLIO [label="folio._flags_1 order and _folio_nr_pages"];
  B_SLAB [label="slub alloc_slab"];
  B_FILTER [label="prepare_alloc_flags (mask ZERO except cache flags)"];
  B_LARGE [label="kmalloc_large"];
  B_LOCALZERO [label="large local memset(ptr,0,request size)"];
  B_ZEROFLAG [label="__GFP_ZERO typed macro"];
  B_COMPFLAG [label="__GFP_COMP typed macro"];
  B_STOP [label="ANALYSIS_STOP invalid buffer or nonreturn"];
  C_FREE [label="__free_pages(page,order) direct"];
  C_OK [label="__free_pages_ok"];
