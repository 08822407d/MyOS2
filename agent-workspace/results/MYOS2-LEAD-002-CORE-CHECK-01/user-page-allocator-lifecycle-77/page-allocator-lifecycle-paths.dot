  C_ZONE [label="myos_page_zone span scan"];
  C_ZONESTOP [label="ANALYSIS_STOP invalid/missing zone"];
  C_LOCK [label="zone.lock free critical section"];
  C_ONE [label="__myos_free_one_page"];
  C_FIND [label="find_buddy_page_pfn"];
  C_XOR [label="__find_buddy_pfn=pfn^(1<<order)"];
  C_PTR [label="page+(unsigned buddy_pfn-pfn) BEFORE validation"];
