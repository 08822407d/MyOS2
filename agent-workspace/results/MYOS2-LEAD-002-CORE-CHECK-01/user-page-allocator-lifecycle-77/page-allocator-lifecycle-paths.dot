// Fixed time static evidence & data dependency graph. NOT CPU CFG, compiled kernel, or physical memory reclamation.
// ANALYSIS_STOP is a knowledge boundary; HISTORICAL_LIMIT does not create a new bug identity.
digraph PA77 {
  rankdir=LR;
  node [shape=box];
  A_WRAP [label="alloc_pages(gfp,order) wrapper"];
  A_BUDDY [label="__myos_alloc_pages selected source"];
  A_ORDER [label="order > MAX_ORDER?"];
  A_PREF [label="prefered_zone_list three elements"];
  A_NR [label="pgdat.nr_zones=MAX_NR_ZONES (selected init)"];
