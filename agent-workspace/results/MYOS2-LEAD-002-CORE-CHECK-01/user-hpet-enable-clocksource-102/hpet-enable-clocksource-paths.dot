// MYOS2-LEAD-002 / batch102 static evidence graph; DOT text only, Graphviz NOT_RUN
// Fixed time a039d9803ade. Do not interpret conditional/provisional edges as runtime events.
digraph HC102_HPET_CLOCKSOURCE {
  graph [rankdir=LR, labelloc=t, label="HC102: HPET mapping / counter / clocksource / timekeeper (static only)"];
  node [shape=box, fontsize=10];
  edge [fontsize=9];
  start_kernel [label="start_kernel", shape=box, style="solid"];
  timekeeping_init [label="timekeeping_init\nsource default first", shape=box, style="solid"];
  late_time_init [label="late_time_init\nlater than timekeeping", shape=box, style="solid"];
