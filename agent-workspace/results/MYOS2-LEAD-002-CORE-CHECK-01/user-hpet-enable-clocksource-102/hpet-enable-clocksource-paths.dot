  best_local -> curr_clocksource [label="UNPROVEN_JOIN: actual assignment commented out", style=dashed];
  curr_clocksource -> tkr [label="UNPROVEN_JOIN: timekeeping_notify commented; no proven rebind", style=dashed];
  timekeeping_init -> default_clock [label="DIRECT_CALL: default selection", style=solid];
  default_clock -> jiffies_clock [label="DATA_FLOW: weak default if selected by linker", style=solid];
  timekeeping_init -> tk_setup [label="DIRECT_CALL: with clock pointer", style=solid];
  jiffies_clock -> tk_setup [label="DATA_FLOW: conditional weak default", style=solid];
  tk_setup -> tkr [label="DATA_FLOW: sets tkr_mono.clock and mult/mask", style=solid];
  timekeeping_get_ns -> tk_clock_read [label="DIRECT_CALL: clock read site", style=solid];
  tkr -> tk_clock_read [label="DATA_FLOW: READ_ONCE pointer", style=solid];
  tk_clock_read -> hpet_clock [label="UNPROVEN_JOIN: no code-proven HPET binding", style=dashed];
  tk_clock_read -> jiffies_clock [label="CALLBACK_BINDING: if weak default selected and not replaced", style=solid];
