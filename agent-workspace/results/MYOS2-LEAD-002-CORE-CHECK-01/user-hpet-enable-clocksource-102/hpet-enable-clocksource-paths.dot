  jiffies64 [label="jiffies_64", shape=ellipse, style="solid"];
  real_hw [label="real HPET/IRQ/mapping result\nNOT VERIFIED", shape=octagon, style="dashed"];
  d00_old [label="IR101 20 boundary failures\nfrozen original", shape=note, style="solid"];
  d00_new [label="HC102-E001..020\n20 qualified body anchors", shape=note, style="solid"];
