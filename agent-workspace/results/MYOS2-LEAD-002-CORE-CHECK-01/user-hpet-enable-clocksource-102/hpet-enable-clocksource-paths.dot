  cfg_sanitize [label="global and per-channel CFG\nfirst write; second only local", shape=ellipse, style="solid"];
  hpet_counting [label="hpet_counting\ncounter vs TSC", shape=box, style="solid"];
  restart_counter [label="hpet_restart_counter", shape=box, style="solid"];
  stop_counter [label="hpet_stop_counter", shape=box, style="solid"];
  reset_counter [label="hpet_reset_counter", shape=box, style="solid"];
  start_counter [label="hpet_start_counter", shape=box, style="solid"];
  hpet_readl [label="hpet_readl\nreturn uint", shape=box, style="solid"];
