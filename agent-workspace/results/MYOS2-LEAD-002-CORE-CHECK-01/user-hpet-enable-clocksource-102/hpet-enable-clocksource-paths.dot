  period_check -> out_nohpet [label="CONDITIONAL_STEP: period outside allowed range", style=dotted];
  period_check -> freq_calc [label="DATA_FLOW: valid nonzero period", style=solid];
  freq_calc -> freq32 [label="DATA_FLOW: u64 to u32 at register call", style=solid];
  hpet_enable -> channels_decode [label="CONDITIONAL_STEP: period valid", style=dotted];
  channels_decode -> kcalloc [label="DIRECT_CALL: request array; allocation opaque", style=solid];
  kcalloc -> hpet_base [label="DATA_FLOW: allocation success publishes pointer/count", style=solid];
  kcalloc -> out_nohpet [label="CONDITIONAL_STEP: allocation returned NULL", style=dotted];
  hpet_base -> cfg_sanitize [label="DATA_FLOW: per channel objects", style=solid];
  cfg_sanitize -> hpet_readl [label="DIRECT_CALL: read global/per-channel cfg", style=solid];
  cfg_sanitize -> hpet_writel [label="DIRECT_CALL: actual first config writes, not second warning pass", style=solid];
  cfg_sanitize -> hpet_counting [label="CONDITIONAL_STEP: after channel iteration", style=dotted];
  hpet_counting -> restart_counter [label="DIRECT_CALL: first", style=solid];
  restart_counter -> stop_counter [label="DIRECT_CALL: counter reset chain", style=solid];
  restart_counter -> reset_counter [label="DIRECT_CALL: second", style=solid];
  restart_counter -> start_counter [label="DIRECT_CALL: third", style=solid];
  hpet_counting -> hpet_readl [label="DIRECT_CALL: counter progress test", style=solid];
  hpet_counting -> rdtsc [label="DIRECT_CALL: TSC threshold, not wall-time guarantee", style=solid];
  hpet_counting -> out_nohpet [label="CONDITIONAL_STEP: no counter advance within conditional TSC gate", style=dotted];
  hpet_counting -> hz_macro [label="CONDITIONAL_STEP: counting passed", style=dotted];
  out_nohpet -> real_hw [label="UNPROVEN_JOIN: iounmap body empty; actual stop/unmap unknown", style=dashed];
  freq32 -> hz_macro [label="DATA_FLOW: register argument frequency", style=solid];
  hz_macro -> register_scale [label="DIRECT_CALL: macro expansion", style=solid];
  register_scale -> update_scale [label="DIRECT_CALL: mult shift before list", style=solid];
  update_scale -> multshift [label="DIRECT_CALL: freq nonzero", style=solid];
  multshift -> hpet_clock [label="DATA_FLOW: writes cs->mult/shift", style=solid];
  register_scale -> enqueue [label="DIRECT_CALL: source registration body", style=solid];
  enqueue -> clocksource_list [label="DATA_FLOW: list_add and count++", style=solid];
  hpet_clock -> hz_macro [label="DATA_FLOW: clocksource object passed", style=solid];
  hpet_clock -> read_hpet [label="CALLBACK_BINDING: read field, not invocation", style=solid];
  hpet_clock -> hpet_enable [label="CALLBACK_BINDING: enable field, registration does not call enable", style=solid];
  hpet_counting -> legacy [label="CONDITIONAL_STEP: after register, ID LEGSUP tested", style=dotted];
  legacy -> periodic [label="DIRECT_CALL: only if LEGSUP", style=solid];
  legacy -> no_legacy_zero [label="CONDITIONAL_STEP: not LEGACY then return0 after registration", style=dotted];
  periodic -> delta [label="DATA_FLOW: use clocksource mult/shift", style=solid];
  hpet_clock -> delta [label="DATA_FLOW: cs->mult/shift requested", style=solid];
  periodic -> hpet_writel [label="DIRECT_CALL: first CFG CMP then second CMP", style=solid];
