  hpet_readl -> counter [label="DATA_FLOW: read low counter", style=solid];
  read_hpet -> hpet_readl [label="DIRECT_CALL: return cast to u64", style=solid];
  periodic -> real_hw [label="UNPROVEN_JOIN: hardware accept and IRQ delivery not proven", style=dashed];
  done_booting -> default_clock [label="DIRECT_CALL: initial curr_clocksource default", style=solid];
