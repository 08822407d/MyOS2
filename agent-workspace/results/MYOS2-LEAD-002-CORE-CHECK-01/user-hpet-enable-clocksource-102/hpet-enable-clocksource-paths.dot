  best [label="clocksource_find_best", shape=box, style="solid"];
  best_local [label="best local variable\nno active commit", shape=ellipse, style="solid"];
  curr_clocksource [label="curr_clocksource\nassignment of best commented", shape=ellipse, style="solid"];
  default_clock [label="clocksource_default_clock\nweak", shape=box, style="solid"];
