  legacy [label="LEGACY branch\nmode=LEGACY; return 1", shape=diamond, style="solid"];
  periodic [label="myos_hpet_clkevt_set_state_periodic", shape=box, style="solid"];
  delta [label="delta = ((NSEC/HZ)*mult)>>(shift+7)\nconditional, direction mismatch", shape=ellipse, style="solid"];
  counter [label="HPET_COUNTER\nread low, mask32", shape=ellipse, style="solid"];
  hpet_clock [label="clocksource_hpet\nrating250 read_hpet", shape=ellipse, style="solid"];
  read_hpet [label="read_hpet", shape=box, style="solid"];
  hz_macro [label="clocksource_register_hz macro", shape=hexagon, style="solid"];
  register_scale [label="__clocksource_register_scale", shape=box, style="solid"];
  update_scale [label="__clocksource_update_freq_scale", shape=box, style="solid"];
  multshift [label="clocks_calc_mult_shift\ncycles to ns", shape=box, style="solid"];
  enqueue [label="clocksource_enqueue", shape=box, style="solid"];
  clocksource_list [label="clocksource_list\nlist count+rating", shape=ellipse, style="solid"];
  done_booting [label="clocksource_done_booting\nfs_initcall declaration", shape=box, style="solid"];
