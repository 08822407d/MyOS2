digraph CORE_USER_DIRECT_MAP_RANGE_82 {
  graph [label="82: candidate bits, five-segment partition, conditional request/accounting; static relationship not execution CFG",labelloc=t,rankdir=LR];
  node [shape=box,fontname="sans-serif",fontsize=9];
  edge [fontname="sans-serif",fontsize=8];
  // Every source_fact_keys resolves to original time source path::symbol, exact evidence quote and supporting literal in facts.
  subgraph cluster_A {
    label="G01 Capability and promotion";
    A_probe [label="simple_probe_page_size_mask",source_fact_keys="probe_2m,probe_1g"];
    A_pse [label="PageSize_Ext分支",source_fact_keys="probe_2m,cpu_pse"];
    A_gb [label="direct_gbpages开关",source_fact_keys="gb_default,probe_1g_else"];
    A_mask [label="全局page_size_mask OR",source_fact_keys="global_mask,probe_2m,probe_1g"];
    A_one [label="Page_1GB分支",source_fact_keys="probe_1g,cpu_1g"];
    A_item [label="MR单项page_size_mask",source_fact_keys="range_fields"];
    A_adjust [label="adjust_range_page_size_mask",source_fact_keys="promote_2m_gate,promote_1g_gate"];
    A_round [label="round_up/round_down至PMD/PUD",source_fact_keys="round_up,round_down,pmd_size,pud_size"];
    A_lookup [label="memblock_is_region_memory",source_fact_keys="single_search,single_containment"];
    A_search [label="memblock_search",source_fact_keys="search_enter,search_access"];
    A_phase [label="after_bootmem提升门",source_fact_keys="promotion_phase,phase_flag"];
    A_stop [label="STOP查询/端点合法性未证",source_fact_keys="round_up,search_access",style=dashed];
    A_model [label="隔离能力/重复探测模型",source_fact_keys="probe_2m,probe_1g"];
  }
  subgraph cluster_B {
    label="G02 Partition and merge";
    B_split [label="split_mem_range",source_fact_keys="split_args"];
    B_floor [label="PFN_DOWN start/end",source_fact_keys="limit_floor,head_bounds"];
    B_head [label="第1段：4K头",source_fact_keys="head_bounds,head_save"];
    B_2m [label="第2段：2M前部",source_fact_keys="two_bounds,two_save"];
    B_1g [label="第3段：1G中部",source_fact_keys="one_bounds,one_save"];
    B_tail2 [label="第4段：2M尾部",source_fact_keys="tail2_bounds,tail2_save"];
    B_tail4 [label="第5段：4K尾部",source_fact_keys="tail4_save"];
    B_save [label="save_mr 五元素表",source_fact_keys="save_guard,save_count,capacity"];
    B_promote [label="after_bootmem=0才提升",source_fact_keys="promotion_phase"];
    B_merge [label="相邻同掩码并移动MR",source_fact_keys="merge_guard,merge_move,merge_count"];
    B_print [label="page_size_string输出",source_fact_keys="display_preference,print_only"];
    B_count [label="返回nr_range",source_fact_keys="split_return"];
    B_stop [label="STOP五项容量/反向范围",source_fact_keys="save_guard,limit_floor",style=dashed];
    B_model [label="隔离五段和合并模型",source_fact_keys="head_save,two_save,one_save,tail2_save,tail4_save"];
  }
  subgraph cluster_C {
    label="G03 Request/accounting";
    C_top [label="init_mem_mapping顶层",source_fact_keys="top_entry,top_probe"];
    C_probe [label="页大小探测请求",source_fact_keys="top_probe,probe_alias"];
    C_max [label="max_pfn字节上界",source_fact_keys="top_probe,max_pfn_upstream"];
    C_isa [label="无条件ISA请求",source_fact_keys="top_isa,isa_end"];
    C_bottom [label="memblock_bottom_up条件",source_fact_keys="direction_gate,bottomup_accessor"];
    C_hi [label="先高端[kernel_end,end)",source_fact_keys="two_calls,pa_symbol"];
    C_lo [label="后低端[ISA_END,kernel_end)",source_fact_keys="two_calls,isa_end"];
    C_range [label="init_range_memory_mapping",source_fact_keys="range_initial,range_clamp"];
    C_iter [label="for_each_mem_pfn_range",source_fact_keys="iterator_macro,iterator_scan"];
    C_clamp [label="物理PFN clamp与跳空交",source_fact_keys="range_clamp,clamp_val"];
    C_sum [label="mapped_ram_size+=end-start",source_fact_keys="range_account,range_return"];
    C_inner [label="init_memory_mapping",source_fact_keys="local_state,call_split"];
    C_request [label="逐MR调用kernel_physical_mapping_init",source_fact_keys="each_request,mapping_macro"];
