    C_root [label="load_cr3及flush",source_fact_keys="load_root"];
    C_stop [label="STOP请求/返回/硬件证明门",source_fact_keys="range_account,lower_return",style=dashed];
    C_model [label="隔离洞/逆序/部分返回模型",source_fact_keys="range_clamp,each_request"];
  }
  C_top -> C_probe [type="MACRO",label="MACRO",source_fact_keys="top_probe,probe_alias"];
  A_probe -> A_pse [type="CALLER_SEQUENCE",label="CALLER_SEQUENCE",source_fact_keys="probe_2m"];
