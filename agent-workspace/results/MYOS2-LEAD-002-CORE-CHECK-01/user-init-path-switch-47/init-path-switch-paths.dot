digraph IP47 {
  rankdir=LR;
  graph [label="IP47: init internal cwd/root switch, kern_path output, devtmpfsd ignored results. No 46 correction graph.",labelloc=t];
  node [fontname="sans",shape=box];
  D0 [label="devtmpfsd entry; err=0",shape=box,style=solid];
  D1 [label="err=init_mount(devtmpfs,/,...); CALL",shape=box,style=solid];
  D2 [label="SOURCE if(err)",shape=diamond,style=solid];
  D3 [label="goto out: return err (mount nonzero)",shape=box,style=solid];
  D4 [label="init_chdir(/..) CALL; int result ignored",shape=box,style=solid];
  D5 [label="init_chroot(.) CALL; int result ignored",shape=box,style=solid];
  D6 [label="complete(&setup_done) CALL if prior calls normal",shape=box,style=solid];
  D7 [label="devtmpfs_work_loop() CALL (opaque)",shape=box,style=solid];
  D8 [label="out: return unchanged err if loop returns",shape=box,style=solid];
  D9 [label="ANALYTIC nonreturn from either switch stops later progress",shape=octagon,style=solid];
  I0 [label="init_mount(dev_name,dir,type,flags)",shape=box,style=solid];
  I1 [label="local path declared without explicit initializer",shape=box,style=solid];
  I2 [label="ret=kern_path(dir,LOOKUP_FOLLOW,&path) CALL",shape=box,style=solid];
  I3 [label="SOURCE if(ret)",shape=diamond,style=solid];
  I4 [label="return ret; skip path_mount,path_put",shape=box,style=solid];
  I5 [label="ret=path_mount(dev_name,&path,type,flags) opaque",shape=box,style=solid];
  I6 [label="path_put(&path) REQUEST; direct dput no active count",shape=box,style=solid];
  I7 [label="return ret if normal",shape=box,style=solid];
  C0 [label="init_chdir(filename): path local, error int",shape=box,style=solid];
  C1 [label="error=kern_path(...,FOLLOW or DIRECTORY,&path) CALL",shape=box,style=solid];
  C2 [label="SOURCE if(error)",shape=diamond,style=solid];
  C3 [label="return nonzero error; skip setter and path_put",shape=box,style=solid];
  C4 [label="SOURCE if(!error); no intervening active reassignment",shape=diamond,style=solid];
  C5 [label="set_fs_pwd(current.fs,&path) CALL (void)",shape=box,style=solid];
  C6 [label="path_put(&path) REQUEST",shape=box,style=solid];
  C7 [label="return error (0 under valid success)",shape=box,style=solid];
  C8 [label="STOP path output/current.fs/setter not valid",shape=octagon,style=solid];
  R0 [label="init_chroot(filename): local path and error",shape=box,style=solid];
  R1 [label="error=kern_path(...FOLLOW or DIRECTORY,&path) CALL",shape=box,style=solid];
  R2 [label="SOURCE if(error)",shape=diamond,style=solid];
  R3 [label="return nonzero error; skip setter and path_put",shape=box,style=solid];
  R4 [label="set_fs_root(current.fs,&path) CALL (void)",shape=box,style=solid];
  R5 [label="dput_and_out label: FALLTHROUGH; no active goto",shape=box,style=solid];
  R6 [label="path_put(&path) REQUEST",shape=box,style=solid];
  R7 [label="return error (0 under normal success)",shape=box,style=solid];
  R8 [label="STOP invalid path/current.fs or non-returning call",shape=octagon,style=solid];
  K0 [label="kern_path(name,flags,path) entry",shape=box,style=solid];
  K1 [label="getname_kernel(name) CALL: filename_s*",shape=box,style=solid];
  K2 [label="filename_lookup(AT_FDCWD,name,flags,path,NULL) CALL",shape=box,style=solid];
  K3 [label="SOURCE IS_ERR(name)",shape=diamond,style=solid];
  K4 [label="return PTR_ERR(name) before nameidata/output",shape=box,style=solid];
  K5 [label="set_nameidata(&nd,dfd,name,NULL)",shape=box,style=solid];
  K6 [label="retval=path_lookupat(&nd,flags,path) CALL",shape=box,style=solid];
  K7 [label="loop link_path_walk int err and lookup_last pointer",shape=box,style=solid];
  K8 [label="SOURCE if(err==0) after complete_walk",shape=diamond,style=solid];
  K9 [label="*path=nd.path (shallow); clear nd.path pointers",shape=box,style=solid];
  K10 [label="no successful path output store on nonzero err",shape=box,style=solid];
  K11 [label="terminate_walk if reached, return err",shape=box,style=solid];
  K12 [label="putname(name) then return retval",shape=box,style=solid];
  K13 [label="kern_path returns filename_lookup int",shape=box,style=solid];
  K14 [label="STOP upstream invalid/opaque nonreturn",shape=octagon,style=solid];
  T0 [label="LOOKUP_FOLLOW=1, DIRECTORY=2; passed not enforcement",shape=box,style=dashed];
  T1 [label="AT_FDCWD=-100 input code only",shape=box,style=dashed];
  T2 [label="path_put direct dput no-op count; lifetime unknown",shape=box,style=dashed];
  T3 [label="commented permission/CAP checks not source gates",shape=box,style=dashed];
  T4 [label="literal /.. and . paths not verified resolution",shape=box,style=dashed];
  T5 [label="C01 source false after zero error, setter called once",shape=box,style=dashed];
  T6 [label="devtmpfsd err not assigned by C/R result",shape=box,style=dashed];
  D0 -> D1 [label="SOURCE: source",style=solid];
  D1 -> I0 [label="CALL: init_mount",style=solid];
  I7 -> D2 [label="RETURN matched call: only devtmpfsd caller and normal",style=solid];
  D2 -> D3 [label="GOTO: err!=0",style=solid];
  D2 -> D4 [label="SOURCE: err==0",style=solid];
  D4 -> C0 [label="CALL: init_chdir",style=solid];
  C7 -> D5 [label="RETURN matched call: only devtmpfsd chdir call, ANY int",style=solid];
  C3 -> D5 [label="RETURN matched call: only devtmpfsd chdir call, ANY int",style=solid];
  D5 -> R0 [label="CALL: init_chroot",style=solid];
  R7 -> D6 [label="RETURN matched call: only devtmpfsd chroot call, ANY int",style=solid];
  R3 -> D6 [label="RETURN matched call: only devtmpfsd chroot call, ANY int",style=solid];
  D4 -> D9 [label="ANALYTIC: callee invalid or nonreturn",style=dashed];
  D5 -> D9 [label="ANALYTIC: callee invalid or nonreturn",style=dashed];
  D6 -> D7 [label="RETURN matched call: complete normal",style=solid];
  D7 -> D8 [label="RETURN matched call: work_loop only if normal",style=solid];
  T6 -> D4 [label="NOTE: no result assignment",style=dashed];
  T6 -> D5 [label="NOTE: no result assignment",style=dashed];
  T4 -> D4 [label="NOTE: literal only",style=dashed];
  T4 -> D5 [label="NOTE: literal only",style=dashed];
  I0 -> I1 [label="SOURCE: source",style=solid];
  I1 -> I2 [label="SOURCE: source",style=solid];
  I2 -> K0 [label="CALL: from init_mount",style=solid];
  K13 -> I3 [label="RETURN matched call: only init_mount caller",style=solid];
  I3 -> I4 [label="SOURCE: ret!=0",style=solid];
  I3 -> I5 [label="SOURCE: ret==0 + valid path premise",style=solid];
  I5 -> I6 [label="RETURN matched call: opaque path_mount normal",style=solid];
  I6 -> I7 [label="RETURN matched call: path_put normal",style=solid];
  C0 -> C1 [label="SOURCE: source",style=solid];
  C1 -> K0 [label="CALL: from init_chdir",style=solid];
  K13 -> C2 [label="RETURN matched call: only init_chdir caller",style=solid];
  C2 -> C3 [label="SOURCE: error!=0",style=solid];
  C2 -> C4 [label="SOURCE: error==0",style=solid];
  C4 -> C5 [label="SOURCE: !error true after no reassign",style=solid];
  C5 -> C8 [label="ANALYTIC: path/current.fs invalid or setter nonreturn",style=dashed];
  C5 -> C6 [label="RETURN matched call: void setter normal",style=solid];
  C6 -> C7 [label="RETURN matched call: path_put normal",style=solid];
  T5 -> C4 [label="NOTE: redundant gate",style=dashed];
  R0 -> R1 [label="SOURCE: source",style=solid];
  R1 -> K0 [label="CALL: from init_chroot",style=solid];
  K13 -> R2 [label="RETURN matched call: only init_chroot caller",style=solid];
  R2 -> R3 [label="SOURCE: error!=0",style=solid];
  R2 -> R4 [label="SOURCE: error==0 and valid path",style=solid];
  R4 -> R8 [label="ANALYTIC: path/current.fs invalid or nonreturn",style=dashed];
  R4 -> R5 [label="RETURN matched call: void setter normal",style=solid];
  R5 -> R6 [label="FALLTHROUGH: no active goto to label",style=solid];
  R6 -> R7 [label="RETURN matched call: path_put normal",style=solid];
  K0 -> K1 [label="SOURCE: source",style=solid];
  K1 -> K14 [label="ANALYTIC: name producer nonreturn/invalid",style=dashed];
  K1 -> K2 [label="RETURN matched call: defined pointer result",style=solid];
  K2 -> K3 [label="CALL: filename_lookup",style=solid];
  K3 -> K4 [label="SOURCE: IS_ERR true",style=solid];
  K3 -> K5 [label="SOURCE: IS_ERR false, valid name premise",style=solid];
  K5 -> K6 [label="SOURCE: nameidata valid",style=solid];
  K6 -> K7 [label="CALL: path_lookupat",style=solid];
  K7 -> K8 [label="SOURCE: loop/complete if normal",style=solid];
  K7 -> K14 [label="ANALYTIC: invalid path or opaque call",style=dashed];
  K8 -> K9 [label="SOURCE: err==0 + valid writable output",style=solid];
  K8 -> K10 [label="SOURCE: err!=0",style=solid];
  K9 -> K11 [label="SOURCE: clear local, terminate, return",style=solid];
  K10 -> K11 [label="SOURCE: terminate, return err",style=solid];
  K11 -> K12 [label="RETURN matched call: filename_lookup then putname",style=solid];
  K12 -> K13 [label="RETURN matched call: filename_lookup int",style=solid];
  K4 -> K13 [label="RETURN matched call: early encoded error",style=solid];
  T0 -> C1 [label="NOTE: flags passed only",style=dashed];
  T0 -> R1 [label="NOTE: flags passed only",style=dashed];
  T1 -> K2 [label="NOTE: dfd value only",style=dashed];
  T2 -> C6 [label="NOTE: no actual count delta",style=dashed];
  T2 -> R6 [label="NOTE: no actual count delta",style=dashed];
  T3 -> C4 [label="NOTE: permission comment",style=dashed];
  T3 -> R4 [label="NOTE: permission comment",style=dashed];
}
