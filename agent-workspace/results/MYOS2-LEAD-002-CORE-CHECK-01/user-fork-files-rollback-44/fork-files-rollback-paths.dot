digraph FR44 {
  rankdir=LR;
  graph [label="FR44 fork file ownership rollback: selected source gotos, fallthrough and analytic preconditions",labelloc=t];
  node [fontname="sans",shape=box];
  P0 [label="copy_process entry; selected valid args",shape=box,style=solid];
  P1 [label="node=NUMA_NO_NODE premise for dup_task allocation",shape=box,style=dashed];
  P2 [label="dup_task_struct; *p=*current preseed files pointer",shape=box,style=solid];
  P3 [label="pre-copy_files steps, sched_fork etc opaque",shape=box,style=solid];
  P4 [label="pre-copy failure goto policy/delayacct/fork_out",shape=diamond,style=solid];
  P5 [label="call copy_files(flags,p)",shape=box,style=solid];
  P6 [label="source: if(retval) after copy_files",shape=diamond,style=solid];
  P7 [label="copy_files normal failure -> goto semundo",shape=box,style=solid];
  P8 [label="copy_files success; new ownership conditional",shape=box,style=solid];
  P9 [label="oldf NULL -> p.files NULL only under preseed premise",shape=box,style=solid];
  P10 [label="shared valid oldf n->n+1; p.files pointer inherited",shape=box,style=solid];
  P11 [label="nonshare: newf refcount1 and p.files=newf",shape=box,style=solid];
  P12 [label="inner dup_fd failure: no normal completion",shape=octagon,style=solid];
  S0 [label="copy_fs result check",shape=diamond,style=solid];
  S1 [label="copy_sighand result check",shape=diamond,style=solid];
  S2 [label="copy_signal result check",shape=diamond,style=solid];
  S3 [label="copy_mm result check",shape=diamond,style=solid];
  S4 [label="copy_namespaces result check",shape=diamond,style=solid];
  S5 [label="copy_thread result check",shape=diamond,style=solid];
  S6 [label="alloc_pid IS_ERR gate and PTR_ERR",shape=diamond,style=solid];
  S7 [label="normal remaining path returns p",shape=box,style=solid];
  L0 [label="bad_fork_cleanup_thread",shape=box,style=solid];
  L1 [label="bad_fork_cleanup_io",shape=box,style=solid];
  L2 [label="bad_fork_cleanup_namespaces",shape=box,style=solid];
  L3 [label="bad_fork_cleanup_mm",shape=box,style=solid];
  L4 [label="bad_fork_cleanup_signal",shape=box,style=solid];
  L5 [label="bad_fork_cleanup_sighand",shape=box,style=solid];
  L6 [label="bad_fork_cleanup_fs",shape=box,style=solid];
  L7 [label="bad_fork_cleanup_files",shape=box,style=solid];
  L8 [label="bad_fork_cleanup_semundo",shape=box,style=solid];
  L9 [label="bad_fork_cleanup_security/audit/perf",shape=box,style=solid];
  L10 [label="bad_fork_cleanup_policy",shape=box,style=solid];
  L11 [label="bad_fork_cleanup_delayacct/count",shape=box,style=solid];
  L12 [label="bad_fork_free",shape=box,style=solid];
  L13 [label="fork_out",shape=box,style=solid];
  O0 [label="exit_thread(p) opaque",shape=box,style=solid];
  O1 [label="if(p.mm) mmput(p.mm) opaque",shape=box,style=solid];
  O2 [label="__cleanup_sighand(p.sighand) opaque; UV-14",shape=box,style=solid];
  O3 [label="exit_fs(p) opaque",shape=box,style=solid];
  O4 [label="exit_files(p) conditional caller",shape=box,style=solid];
  O5 [label="put_task_stack; delayed_free_task opaque",shape=box,style=solid];
  O6 [label="spin_lock_irq / spin_unlock_irq opaque",shape=box,style=solid];
  X0 [label="exit_files reads p.files (requires valid p)",shape=box,style=solid];
  X1 [label="source if(files)",shape=diamond,style=solid];
  X2 [label="NULL: no table put",shape=box,style=solid];
  X3 [label="task_lock then p.files=NULL then unlock",shape=box,style=solid];
  X4 [label="put_files_struct(saved files)",shape=box,style=solid];
  X5 [label="decrement table refcount",shape=box,style=solid];
  X6 [label="if last ref: iterate filp_close, table free request",shape=box,style=solid];
  X7 [label="shared case n+1 -> n if stable and valid",shape=box,style=dashed];
  X8 [label="new table 1 -> 0; slot contents opaque",shape=box,style=dashed];
  X9 [label="stop if invalid file/cleanup nonreturn",shape=octagon,style=solid];
  K0 [label="copy_process returns ERR_PTR(retval) if cleanup normal",shape=box,style=solid];
  K1 [label="kernel_clone checks IS_ERR(p)",shape=diamond,style=solid];
  K2 [label="kernel_clone returns PTR_ERR(p)",shape=box,style=solid];
  K3 [label="not IS_ERR: no certified error result",shape=octagon,style=solid];
  A0 [label="bad_fork_cancel_cgroup/put_pidfd/free_pid structural labels",shape=box,style=dashed];
  A1 [label="no selected active goto into A0 from these failure gates",shape=box,style=dashed];
  A2 [label="source successful return p precedes error labels",shape=box,style=dashed];
  A3 [label="ERR_PTR range premise; positive/unencoded not automatic error",shape=box,style=dashed];
  P0 -> P1 [label="ANALYTIC: selected clone path",style=dashed];
  P1 -> P2 [label="SOURCE: node matches and prior allocation works",style=solid];
  P2 -> P3 [label="SOURCE: prerequisites normal",style=solid];
  P3 -> P4 [label="SOURCE: pre-copy control",style=solid];
  P4 -> L10 [label="SOURCE: sched_fork failure",style=solid];
  P4 -> L11 [label="SOURCE: kthread setup failure",style=solid];
  P4 -> L13 [label="SOURCE: dup_task_struct NULL",style=solid];
  P4 -> P5 [label="SOURCE: no pre-copy failure",style=solid];
  P5 -> P6 [label="RETURN: copy_files returned normally",style=solid];
  P5 -> P12 [label="ANALYTIC: dup_fd inner invalid access",style=dashed];
  P6 -> P7 [label="SOURCE: retval!=0",style=solid];
  P7 -> L8 [label="GOTO: goto bad_fork_cleanup_semundo",style=solid];
  P6 -> P8 [label="SOURCE: retval=0",style=solid];
  P8 -> P9 [label="DATA: oldf NULL case",style=solid];
  P8 -> P10 [label="DATA: CLONE_FILES share case",style=solid];
  P8 -> P11 [label="DATA: new dynamic table case",style=solid];
  P8 -> S0 [label="SOURCE: copy_fs next",style=solid];
  S0 -> L7 [label="GOTO: copy_fs failed",style=solid];
  S0 -> S1 [label="SOURCE: copy_fs normally succeeded",style=solid];
  S1 -> L6 [label="GOTO: copy_sighand failed",style=solid];
  S1 -> S2 [label="SOURCE: copy_sighand normally succeeded",style=solid];
  S2 -> L5 [label="GOTO: copy_signal failed",style=solid];
  S2 -> S3 [label="SOURCE: copy_signal normally succeeded",style=solid];
  S3 -> L4 [label="GOTO: copy_mm failed",style=solid];
  S3 -> S4 [label="SOURCE: copy_mm normally succeeded",style=solid];
  S4 -> L3 [label="GOTO: copy_namespaces failed",style=solid];
  S4 -> S5 [label="SOURCE: copy_namespaces normally succeeded",style=solid];
  S5 -> L1 [label="GOTO: copy_thread failed",style=solid];
  S5 -> S6 [label="SOURCE: copy_thread normally succeeded",style=solid];
  S6 -> L0 [label="GOTO: IS_ERR(alloc_pid) -> retval PTR_ERR",style=solid];
  S6 -> S7 [label="SOURCE: no alloc_pid error; later steps conditional",style=solid];
  S7 -> A2 [label="NOTE: source return p before labels",style=dashed];
  L0 -> O0 [label="CALL: exit_thread",style=solid];
  O0 -> L1 [label="RETURN: callee normal",style=solid];
  L1 -> L2 [label="FALLTHROUGH: IO cleanup commented",style=solid];
  L2 -> L3 [label="FALLTHROUGH: namespaces cleanup commented",style=solid];
  L3 -> O1 [label="CALL: if(p.mm) mmput else no call",style=solid];
  O1 -> L4 [label="RETURN: conditionally normal",style=solid];
  L4 -> L5 [label="FALLTHROUGH: signal cleanup commented",style=solid];
  L5 -> O2 [label="CALL: sighand cleanup",style=solid];
  O2 -> L6 [label="RETURN: only if normal; UV-14 boundary",style=solid];
  L6 -> O3 [label="CALL: exit_fs",style=solid];
  O3 -> L7 [label="RETURN: if normal",style=solid];
  L7 -> O4 [label="CALL: exit_files",style=solid];
  O4 -> X0 [label="CALL: actual definition",style=solid];
  X0 -> X1 [label="SOURCE: valid p/files source",style=solid];
  X1 -> X2 [label="SOURCE: NULL",style=solid];
  X1 -> X3 [label="SOURCE: nonnull files",style=solid];
  X3 -> X4 [label="SOURCE: p.files cleared if lock and objects valid",style=solid];
  X4 -> X5 [label="SOURCE: table decrement",style=solid];
  X5 -> X6 [label="SOURCE: last ref",style=solid];
  X5 -> X7 [label="ANALYTIC: shared count n+1->n",style=dashed];
  X5 -> X8 [label="ANALYTIC: new table ref1->0",style=dashed];
  X6 -> X9 [label="ANALYTIC: invalid slot or nonreturn",style=dashed];
  X2 -> L8 [label="RETURN: exit_files normally returned",style=solid];
  X5 -> L8 [label="RETURN: table count stayed nonzero; normal",style=solid];
  X6 -> L8 [label="RETURN: all traversal/free calls normal",style=solid];
  L8 -> L9 [label="FALLTHROUGH: semundo/security/audit/perf comments",style=solid];
  L9 -> L10 [label="FALLTHROUGH: fallthrough",style=solid];
  L10 -> L11 [label="FALLTHROUGH: fallthrough",style=solid];
  L11 -> L12 [label="FALLTHROUGH: fallthrough",style=solid];
  L12 -> O5 [label="CALL: task cleanup",style=solid];
  O5 -> L13 [label="RETURN: if normal",style=solid];
  L13 -> O6 [label="CALL: sighand lock/unlock",style=solid];
  O6 -> K0 [label="RETURN: if normal",style=solid];
  K0 -> K1 [label="CALL: returns pointer into kernel_clone",style=solid];
  K1 -> K2 [label="SOURCE: IS_ERR true",style=solid];
  K1 -> K3 [label="ANALYTIC: not recognized as error pointer",style=dashed];
  A1 -> A0 [label="NOTE: no direct active goto to structural labels",style=dashed];
  A2 -> A1 [label="NOTE: return p separates error labels",style=dashed];
  A3 -> K1 [label="ANALYTIC: valid encoded error interval",style=dashed];
  P9 -> X2 [label="ANALYTIC: only if later rollback reached",style=dashed];
  P10 -> X7 [label="ANALYTIC: only if later rollback reached",style=dashed];
