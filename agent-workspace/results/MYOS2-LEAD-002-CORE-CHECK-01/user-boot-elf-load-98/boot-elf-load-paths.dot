// Fixed time@a039d9803ade; STATIC graph not a full CFG. Graphviz NOT_RUN.
// CALL: true direct function call; INDIRECT_CALL: EFI protocol function pointer; CALL_REQUEST: external CopyMem/ZeroMem; DATA_HANDOFF is NOT C call.
digraph BE98_Boot_ELF_Load {
 graph [rankdir=LR, labelloc=t, label="BE98: raw EFI file -> ELF64 metadata -> PT_LOAD request -> entry handoff"];
 node [shape=box,fontsize=9]; edge [fontsize=8];
 subgraph cluster_funcs { label="actual source call owners";
  p_UefiMain [label="UefiMain / loader entry (caller)"];
  p_loadkernel [label="load_elf_kernel / raw and target"];
  p_LoadFile [label="LoadFile / EFI file I/O"];
  p_IsElfFormat [label="IsElfFormat / ELF subset predicate"];
  p_ParseElfImage [label="ParseElfImage / context"];
  p_GetElf64SectionByIndex [label="GetElf64SectionByIndex / index only"];
  p_GetElf64SegmentByIndex [label="GetElf64SegmentByIndex / index only"];
  p_GetElfSegmentInfo [label="GetElfSegmentInfo / program fields"];
  p_GetElfSectionPos [label="GetElfSectionPos / section fields"];
  p_CalculateElfFileSize [label="CalculateElfFileSize / section-derived"];
  p_LoadElfImage [label="LoadElfImage / dispatch"];
  p_LoadElf64Image [label="LoadElf64Image / PT_LOAD writes"];
  p_RelocateElf64Sections [label="RelocateElf64Sections / only if moved"];
 }
 subgraph cluster_A {label="A file acquisition and resource";
  uefi [label="UefiMain加载入口" ];
  vol [label="LoadFile卷与根句柄" ];
  open [label="文件打开失败" ];
  getinfo [label="信息取得" ];
  filebytes [label="Read请求字节数" ];
  filepages [label="原始文件页请求" ];
  read [label="文件字节实际取得" ];
  raw [label="raw_img_addr按值交接" ];
  length_split [label="读长与ELF推算长" ];
  filelog [label="日志不是字节证明" ];
  fileinfo [label="FileInfo池对象" ];
  cleanup [label="正常后缀资源关闭" ];
 }
 subgraph cluster_B {label="B ELF64 parsing and size";
  magic [label="魔数逐字测试" ];
  class [label="编码与class" ];
  machine [label="64位机器类型版本" ];
  elf_header [label="header字段位置" ];
  shindex [label="section索引检查" ];
  phindex [label="program header索引检查" ];
  shstr [label="必须访问section-name索引" ];
  seginfo [label="段字段来源" ];
  assert [label="段索引状态消费" ];
  entry_macro [label="步长宏和物理对象" ];
  bounds [label="实际文件长度证明链" ];
  context [label="上下文清零/文件指针" ];
  span [label="Base/End初始化" ];
  segment [label="ReloadRequired记录" ];
  imagesize [label="ImageSize计算" ];
  filesize [label="section终点计算" ];
  types [label="类型转换发生前后" ];
  model [label="不完整加载记录的停门" ];
  sectionpos [label="GetElfSectionPos返回定义" ];
 }
 subgraph cluster_C {label="C allocation, segments, entry";
  alloc_addr [label="loaded_addr的初始化来源" ];
  preferred [label="目标申请与复制地址分叉" ];
  load_dispatch [label="加载前置判定" ];
  loadseg [label="PT_LOAD筛选" ];
  copy [label="段复制/清零目的" ];
  segment_overlap [label="多个段对象约束" ];
  zeroreq [label="清零宽度独立" ];
  reloc [label="实际重定位分支可达性" ];
  entry [label="入口值产生与提前发布" ];
  return_status [label="load_elf_kernel返回范围" ];
  file_status [label="LoadFile返回状态被忽略" ];
  loader_status [label="LoadElf64Image终结状态" ];
  reload_flag [label="ReloadRequired不代替真正分配" ];
  uefi_exit [label="UefiMain间接调用入口" ];
  entry_gate [label="入口和目标并非同一认证对象" ];
 }
 subgraph cluster_ABC {label="ABC chain";
 }
 subgraph cluster_limits {label="earliest proof boundaries";
  stop_A [label="A STOP: EFI status / Read extent / handle",shape=octagon];
  stop_B [label="B STOP: ELF raw bytes / table / arithmetic",shape=octagon];
  stop_C [label="C STOP: allocated writable pages / entry",shape=octagon];
  stop_ABI [label="ABI STOP: UINTN/EFI_PAGE_SIZE/extern semantics",shape=octagon];
  stop_history [label="HISTORY: R97-S01/02/03, R80-S01; no new D00",shape=octagon];
 }
 p_UefiMain -> p_loadkernel [label="CALL: UefiMain direct load_elf_kernel",color=blue,style=solid];
 p_loadkernel -> p_LoadFile [label="CALL: raw file acquisition",color=blue,style=solid];
 p_loadkernel -> p_IsElfFormat [label="CALL: raw file format check",color=blue,style=solid];
 p_loadkernel -> p_ParseElfImage [label="CALL: raw ELF parse if format accepted",color=blue,style=solid];
 p_loadkernel -> p_LoadElfImage [label="CALL: dispatch load after Parse",color=blue,style=solid];
 p_LoadFile -> vol [label="INDIRECT_CALL: gBS HandleProtocol and Vol OpenVolume",color=purple,style=dashed];
 p_LoadFile -> open [label="INDIRECT_CALL: RootFs Open, status consumed",color=purple,style=dashed];
 p_LoadFile -> getinfo [label="INDIRECT_CALL: gBS AllocatePool and FileHandle GetInfo",color=purple,style=dashed];
 p_LoadFile -> filepages [label="INDIRECT_CALL: gBS AllocatePages with local addr",color=purple,style=dashed];
 p_LoadFile -> read [label="INDIRECT_CALL: FileHandle Read inout bufsize",color=purple,style=dashed];
 p_LoadFile -> cleanup [label="INDIRECT_CALL: FreePool and Close handles; results not consumed",color=purple,style=dashed];
 p_LoadFile -> filebytes [label="DATA: size or FileInfo FileSize selects request",color=gray,style=dotted];
 filebytes -> filepages [label="DATA: page count from selected request",color=gray,style=dotted];
 filepages -> read [label="SOURCE_ORDER: requested addr may change by reference",color=gray,style=dotted];
 p_UefiMain -> raw [label="DATA: raw arg fixed in load_elf_kernel",color=gray,style=dotted];
 p_loadkernel -> raw [label="DATA: raw_img_addr=0x2000000",color=gray,style=dotted];
 raw -> p_IsElfFormat [label="DATA: image pointer",color=gray,style=dotted];
 raw -> p_ParseElfImage [label="DATA: same raw pointer, no actual byte count",color=gray,style=dotted];
 read -> length_split [label="DATA_BOUNDARY: actual read length not exported to Parse",color=gray,style=dotted];
 p_ParseElfImage -> p_IsElfFormat [label="CALL: repeat predicate on FileBase",color=blue,style=solid];
 p_IsElfFormat -> magic [label="BRANCH: magic 0,1,1,2; no byte3 test",color=gray,style=dotted];
 p_IsElfFormat -> class [label="BRANCH: little endian and class",color=gray,style=dotted];
 p_IsElfFormat -> machine [label="BRANCH: x86_64 type and version",color=gray,style=dotted];
 magic -> stop_B [label="PROOF_BOUNDARY: source byte extent and 4th magic",color=red,style=dotted];
 class -> stop_B [label="PROOF_BOUNDARY: actual file class not certified",color=red,style=dotted];
 p_ParseElfImage -> p_GetElf64SectionByIndex [label="CALL: ELF64 shstrndx before load loop",color=blue,style=solid];
 p_ParseElfImage -> p_GetElfSegmentInfo [label="CALL: each phdr index",color=blue,style=solid];
 p_ParseElfImage -> p_CalculateElfFileSize [label="CALL: returned status ignored",color=blue,style=solid];
 p_CalculateElfFileSize -> p_GetElfSectionPos [label="CALL: ShNum minus one",color=blue,style=solid];
 p_GetElfSectionPos -> p_GetElf64SectionByIndex [label="CALL: section metadata value",color=blue,style=solid];
 p_GetElfSegmentInfo -> p_GetElf64SegmentByIndex [label="CALL: program header by Index",color=blue,style=solid];
 p_GetElf64SectionByIndex -> shindex [label="DATA: index less than e_shnum only",color=gray,style=dotted];
 p_GetElf64SegmentByIndex -> phindex [label="DATA: index less than e_phnum only",color=gray,style=dotted];
 shindex -> shstr [label="DATA: section-name table requirement",color=gray,style=dotted];
 phindex -> seginfo [label="DATA: program metadata fields",color=gray,style=dotted];
 shstr -> context [label="DATA: ShStrOff and ShStrLen may truncate",color=gray,style=dotted];
 p_ParseElfImage -> context [label="DATA: ZeroMem then field producers",color=gray,style=dotted];
 p_ParseElfImage -> span [label="DATA: Base MAX_UINT32, End zero",color=gray,style=dotted];
 seginfo -> span [label="DATA: PT_LOAD p_paddr/memsz",color=gray,style=dotted];
 span -> imagesize [label="DATA: ImageSize End-Base+1",color=gray,style=dotted];
 p_CalculateElfFileSize -> filesize [label="DATA: section/table ends and MAX",color=gray,style=dotted];
 filesize -> length_split [label="DATA_BOUNDARY: not actual Read byte count",color=gray,style=dotted];
 filesize -> stop_B [label="PROOF_BOUNDARY: no raw object span bound",color=red,style=dotted];
 shindex -> stop_B [label="PROOF_BOUNDARY: valid index not valid address span",color=red,style=dotted];
 phindex -> stop_B [label="PROOF_BOUNDARY: valid index not valid segment bytes",color=red,style=dotted];
 imagesize -> stop_ABI [label="PROOF_BOUNDARY: EFI_PAGE_SIZE and UINTN assumption",color=red,style=dotted];
 p_loadkernel -> alloc_addr [label="DATA: loaded_addr set before ImageAddress change",color=gray,style=dotted];
 p_loadkernel -> preferred [label="DATA: ImageAddress forced to Preferred",color=gray,style=dotted];
 p_loadkernel -> entry [label="DATA: entry_addr written before allocation/load",color=gray,style=dotted];
 alloc_addr -> preferred [label="DATA_MISMATCH: AllocatePages targets loaded_addr, writes at ImageAddress",color=gray,style=dotted];
 p_loadkernel -> load_dispatch [label="SOURCE_ORDER: AllocatePages followed by LoadElfImage no status consumption",color=gray,style=dotted];
 p_LoadElfImage -> p_LoadElf64Image [label="CONDITIONAL_CALL: EiClass==ELFCLASS64",color=darkorange,style=dashed];
 p_LoadElfImage -> loader_status [label="RETURN_FLOW: status returned to load_elf_kernel but ignored",color=purple,style=dotted];
 p_LoadElf64Image -> loadseg [label="BRANCH: PT_LOAD and memsz>0",color=gray,style=dotted];
 loadseg -> copy [label="CALL_REQUEST: CopyMem from FileBase plus p_offset",color=blue,style=dashed];
 copy -> zeroreq [label="CALL_REQUEST: ZeroMem tail length memsz-filesz",color=blue,style=dashed];
 loadseg -> segment_overlap [label="CONDITIONAL_DATA: separate source segments may overlap",color=darkorange,style=dashed];
 loadseg -> stop_C [label="PROOF_BOUNDARY: target page allocation independent",color=red,style=dotted];
 copy -> stop_C [label="PROOF_BOUNDARY: source extent/dest and external CopyMem",color=red,style=dotted];
 zeroreq -> stop_C [label="PROOF_BOUNDARY: underflow/capacity and external ZeroMem",color=red,style=dotted];
 p_LoadElf64Image -> p_RelocateElf64Sections [label="CONDITIONAL_CALL_NOT_SELECTED: caller sets ImageAddress==Preferred",color=darkorange,style=dashed];
 p_RelocateElf64Sections -> reloc [label="DATA: Delta and EntryPoint rewrite only when reached",color=gray,style=dotted];
 reloc -> entry_gate [label="PROOF_BOUNDARY: not this caller; no full algorithm audit",color=red,style=dotted];
 preferred -> p_LoadElf64Image [label="DATA: destination context ImageAddress",color=gray,style=dotted];
 entry -> p_UefiMain [label="DATA_HANDOFF: k_load_addr to func",color=black,style=dotted];
 p_UefiMain -> uefi_exit [label="SOURCE_ORDER: later MBI production and entry call attempted",color=gray,style=dotted];
 p_UefiMain -> entry_gate [label="ASSEMBLY_CONTROL: callq indirect to func, not success proof",color=gray,style=dotted];
 p_loadkernel -> return_status [label="RETURN_FLOW: only Parse status returned, not alloc/load",color=purple,style=dotted];
 p_LoadFile -> file_status [label="RETURN_FLOW: Open failure returned, all other suffix EFI_SUCCESS",color=purple,style=dotted];
 file_status -> return_status [label="RESULT_IGNORED: LoadFile return not consumed",color=gray,style=dotted];
 loader_status -> return_status [label="RESULT_IGNORED: LoadElfImage return not consumed",color=gray,style=dotted];
 return_status -> entry_gate [label="PROOF_BOUNDARY: EFI_SUCCESS not successful CPU entry",color=red,style=dotted];
 reload_flag -> preferred [label="DATA_UNUSED: ReloadRequired not used by this caller",color=gray,style=dotted];
 p_ParseElfImage -> reload_flag [label="DATA: MemLen != Length toggles TRUE",color=gray,style=dotted];
 p_LoadElf64Image -> loader_status [label="RETURN_FLOW: returns EFI_SUCCESS after calls",color=purple,style=dotted];
 raw -> stop_A [label="PROOF_BOUNDARY: actual readable buffer not proven",color=red,style=dotted];
 open -> stop_A [label="PROOF_BOUNDARY: earlier handles/status",color=red,style=dotted];
 read -> stop_A [label="PROOF_BOUNDARY: short-read status not observed",color=red,style=dotted];
 alloc_addr -> stop_C [label="PROOF_BOUNDARY: requested and written addresses differ",color=red,style=dotted];
 entry -> stop_C [label="PROOF_BOUNDARY: entry was published before segment writes",color=red,style=dotted];
 stop_history -> stop_ABI [label="HISTORY_LIMIT: prior review limits still active",color=gray,style=dotted];
 uefi -> stop_A [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 filelog -> stop_A [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 fileinfo -> stop_A [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 elf_header -> stop_B [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 assert -> stop_B [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 entry_macro -> stop_B [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 bounds -> stop_B [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 segment -> stop_B [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 types -> stop_B [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 model -> stop_B [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
 sectionpos -> stop_B [label="PROOF_BOUNDARY: matrix-specific condition, not executed",color=red,style=dotted];
}
