digraph NI37 {
  graph [label="CORE-USER-INODE-INIT-37 | fixed time; selected FAT path and separate once helpers",rankdir=LR,labelloc=t];
  node [shape=box,fontsize=10];
  fatfill [label="fat_fill_super sets sb.s_op=&fat_sops"];
  fatops [label="fat_sops alloc_inode=fat_alloc_inode"];
  sb [label="superblock instance: actual binding PRECONDITION",shape=note];
  fatbuild [label="fat_build_inode calls new_inode"];
  new [label="new_inode calls alloc_inode"];
  alloc [label="alloc_inode reads sb.s_op"];
  callback [label="ops.alloc_inode != NULL?",shape=diamond];
  fatalloc [label="fat_alloc_inode; kmalloc outer msdos_inode_info"];
  fallback [label="kmem_cache_alloc inode_cachep (other branch)"];
  nullouter [label="ei == NULL?",shape=diamond];
  outer_fields [label="write five outer FAT fields to zero"];
  embedded [label="return &ei.vfs_inode (not ei address)"];
  returned [label="inode pointer from selected allocator"];
  nullinode [label="if inode==NULL return NULL",shape=diamond];
  always [label="inode_init_always(sb,inode)"];
  binding [label="mapping = &inode.i_data (inline member)"];
  defaultops [label="set i_sb, i_op=&empty_iops, i_fop=&no_open_fops"];
  sizezero [label="i_size=0; i_blocks=0"];
  mappingbase [label="mapping.a_ops=&empty_aops; host=inode"];
  mappingtail [label="mapping flags/private_data/index; inode.i_mapping=mapping"];
  always0 [label="return 0 from selected definition"];
  defensive [label="if(unlikely(inode_init_always result))?",shape=diamond];
  error_cleanup [label="defensive destroy/free paths; no nonzero producer proven"];
  allocreturn [label="alloc_inode returns same inode"];
  newlist [label="set i_sb and INIT_LIST_S(i_sb_list)"];
  sbadd [label="inode_sb_list_add: list_header_add_to_tail"];
  newret [label="new_inode returns inode"];
  buildnull [label="new_inode NULL?",shape=diamond];
  enomem [label="fat_build_inode -> ERR_PTR(-ENOMEM)"];
  fill [label="fat_fill_inode"];
  modenull [label="write i_mode=0; MSDOS_I(inode).i_pos=0"];
  dirtest [label="de.attr&ATTR_DIR and not FAT32_IS_FREE?",shape=diamond];
  dir [label="dir: i_op/i_fop = VFAT/FAT32"];
  file [label="else: i_size=de.size; i_op/i_fop; mapping.a_ops=&fat_aops"];
  fillret [label="fat_fill_inode return 0"];
  buildcheck [label="if(err) defensive branch",shape=diamond];
  fill_error [label="fat_build_inode: iput(inode); inode=ERR_PTR(err); goto out"];
  buildret [label="fat_build_inode returns inode or defensive ERR_PTR"];
  fatcallback [label="FAT32_lookup tests IS_ERR(p) before size/private/dentry writes"];
  lookupslow [label="__lookup_slow sets i_mapping.nrpages; page_array only when nrpages>0"];
  mappingunknown [label="nrpages/page_array NOT explicitly set by inode_init_always",shape=note];
  privateunknown [label="private_idx_info NOT set by inode_init_always/fat_alloc_inode",shape=note];
  once [label="inode_init_once (separate defined function)"];
  oncemem [label="memset(inode,0,sizeof(inode_s)); init i_devices"];
  onceinternal [label="__address_space_init_once calls init_rwsem"];
  addr_once [label="address_space_init_once (separate function)"];
  addrmem [label="memset(mapping,0,sizeof(*mapping))"];
  cacheinit [label="inode_init registers inode cache constructor NULL"];
  noonce [label="NO observed once-helper call in selected FAT kmalloc/new_inode chain",shape=note];
  stop [label="STOP: invalid pointer, nonreturn, unknown allocator/lifetime",shape=octagon];
  fatfill -> fatops [label="static binding",style=dashed];
  fatops -> sb [label="fat_fill_super writes s_op; binding condition"];
  sb -> alloc [label="actual sb passed to alloc_inode"];
  fatbuild -> new [label="call"];
  new -> alloc [label="call"];
  alloc -> callback [label="check function pointer"];
  callback -> fatalloc [label="nonNULL, selected FAT ops"];
  callback -> fallback [label="NULL callback (alternative)"];
  fatalloc -> nullouter [label="kmalloc returns"];
  nullouter -> nullinode [label="ei NULL leads NULL return"];
  nullouter -> outer_fields [label="ei nonNULL"];
  outer_fields -> embedded [label="return embedded address"];
  embedded -> returned [label="pointer origin"];
  fallback -> returned [label="normal pointer only if allocated"];
  returned -> nullinode [label="check NULL"];
  nullinode -> always [label="nonNULL"];
  nullinode -> newret [label="NULL via alloc_inode and new_inode"];
  always -> binding [label="alias setup"];
  binding -> defaultops [label="field writes"];
  defaultops -> sizezero [label="field writes"];
  sizezero -> mappingbase [label="field writes"];
  mappingbase -> mappingtail [label="field writes"];
  mappingtail -> always0 [label="normal return"];
  always0 -> defensive [label="actual if evaluates int 0"];
  defensive -> error_cleanup [label="nonzero hypothetical (no source)",style=dashed];
  defensive -> allocreturn [label="zero actual"];
  allocreturn -> newlist [label="return from alloc_inode"];
  newlist -> sbadd [label="successful object"];
  sbadd -> newret [label="return"];
  newret -> buildnull [label="fat_build_inode consumes return"];
  buildnull -> enomem [label="NULL"];
  buildnull -> fill [label="nonNULL"];
  fill -> modenull [label="entry writes"];
  modenull -> dirtest [label="evaluate actual condition"];
  dirtest -> dir [label="true"];
  dirtest -> file [label="false"];
  dir -> fillret [label="normal completion"];
  file -> fillret [label="normal completion"];
  fillret -> buildcheck [label="fat_build_inode checks returned zero"];
  buildcheck -> buildret [label="zero normal path"];
  buildcheck -> fill_error [label="nonzero defensive branch only",style=dashed];
  fill_error -> buildret [label="goto out, return encoded error"];
  buildret -> fatcallback [label="selected subsequent caller"];
  fatcallback -> lookupslow [label="callback normal result consumed upstream"];
  mappingbase -> mappingunknown [label="limits of writes (analysis note)",style=dashed];
  mappingtail -> mappingunknown [label="limits of writes (analysis note)",style=dashed];
  outer_fields -> privateunknown [label="initialization gap (analysis note)",style=dashed];
  mappingunknown -> lookupslow [label="prior state unknown, later nrpages assignment",style=dashed];
  privateunknown -> fatcallback [label="later private_idx_info reassigned"];
  once -> oncemem [label="separate helper body"];
  oncemem -> onceinternal [label="actual invocation inside inode_init_once"];
  addr_once -> addrmem [label="separate helper body"];
  addrmem -> onceinternal [label="actual invocation inside address_space_init_once"];
  cacheinit -> fallback [label="only cache provenance, not callback"];
  once -> noonce [label="definition exists, selected chain call not found (non-control)",style=dashed];
  addr_once -> noonce [label="definition exists, selected chain call not found (non-control)",style=dashed];
  noonce -> stop [label="cannot promote definition into actual FAT initialization"];
  fatalloc -> stop [label="kmalloc failure or invalid object, conditional",style=dashed];
  mappingtail -> stop [label="invalid mapping prerequisites"];
  fatcallback -> stop [label="valid inode/mapping and blocks math premises",style=dashed];
}
