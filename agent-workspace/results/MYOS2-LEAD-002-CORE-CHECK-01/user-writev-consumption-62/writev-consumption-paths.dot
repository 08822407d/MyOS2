digraph MYOS2_WRITEV_CONSUMPTION_62 {
 graph [rankdir=LR,labelloc=t,label="Batch62: only bounded source-call/data/control/analysis-stop relations; NOT full CFG"];
 node [shape=box];
 edge [fontsize=9];
 subgraph cluster_A {
 label="A entry / user vector";
  sys [label="writev macro body"];
  do [label="do_writev"];
  getpos [label="fdget_pos(int fd)"];
  tofd [label="__to_fd(ulong v)"];
  array [label="files.fd_array slot (data)"];
  nullslot [label="valid NULL slot => EBADF"];
  validfile [label="valid nonNULL file (premise)"];
  vfswritev [label="vfs_writev(actual callee)"];
  mode [label="FMODE_WRITE check"];
  iov [label="iov_s array (data)"];
  vecfield [label="vec[i].base / len"];
  vlen [label="ulong vlen"];
  iovmax [label="UIO_MAXIOV macro, no active check"];
  importoff [label="import_iovec commented"];
  scalar [label="vfs_write scalar contrast only"];
  scalaraccess [label="scalar CAN_WRITE/access_ok"];
  scalariter [label="scalar write_iter fallback"];
  fop [label="file.f_op.write (method)"];
  badfd [label="bad fd index STOP",shape=octagon];
  badvec [label="bad iovec field STOP",shape=octagon];
  badmethod [label="absent write method STOP",shape=octagon];
 }
 subgraph cluster_B {
 label="B callback return sum";
  loop [label="int i loop, i < vlen"];
  callwrite [label="write(file, base, len, pos)"];
  result [label="per-callback ssize_t result"];
  sum [label="ret += callback result"];
  shortresult [label="short callback result (data)"];
  negative [label="negative callback result (data)"];
  zero [label="zero callback result (data)"];
  signedlimit [label="ssize_t / int limit condition"];
  continuecall [label="next i if bounded"];
  aggregate [label="final aggregated ret"];
  totalsign [label="ret>=0 gate"];
  badsum [label="invalid signed addition STOP",shape=octagon];
  badindex [label="int i overflow / vec boundary STOP",shape=octagon];
 }
 subgraph cluster_C {
 label="C position and FAT consumer";
  ppos [label="file_ppos(file)"];
  stream [label="FMODE_STREAM => NULL pos"];
  localpos [label="nonstream local pos copy"];
  commit [label="do_writev final f_pos commit"];
  fpos [label="file.f_pos field"];
  fdputpos [label="fdput_pos"];
  fdput [label="fdput(flags3)"];
  fput [label="fput"];
  refdec [label="file.f_count decrement (data)"];
  fatops [label="FAT32_file_ops.write binding"];
  fatwrite [label="FAT32_write (conditional callee)"];
  inode [label="file inode/private refs"];
  fsbi [label="FAT geometry (data)"];
  posptr [label="loff_t *position (data)"];
  badpos [label="NULL position deref STOP",shape=octagon];
  badgeometry [label="bad geometry / invalid objects STOP",shape=octagon];
  buffer [label="kmalloc buffer"];
  badbuffer [label="invalid cluster buffer STOP",shape=octagon];
  sector [label="sector0 or computed address"];
  flags [label="flags0/1 branches"];
  cluster [label="initial/next cluster (data)"];
  firstcluster [label="first_cluster store"];
  writemeta [label="write_inode / FAT mark requests"];
  doloop [label="do { ... } while(index)"];
  countzero [label="iov_len0 still one callback"];
  blockread [label="ROOTBLK READ request"];
  copyfrom [label="copy_from_user / memcpy"];
  residue [label="cplen unused"];
  blockwrite [label="ROOTBLK WRITE request"];
  blockerr [label="local ret_val=-EIO"];
  progress [label="index / buf / *position advance"];
  sizeupdate [label="inode.i_size / write_inode"];
  tailoverwrite [label="if !index ret_val=count"];
  fatreturn [label="FAT callback returns ssize_t"];
 }
 sys -> do [label="CALL"];
 do -> getpos [label="CALL"];
 getpos -> tofd [label="CALL"];
 tofd -> array [label="DATA"];
 array -> nullslot [label="DATA"];
 tofd -> badfd [label="ANALYSIS_STOP"];
 do -> validfile [label="LOCAL_CONTROL"];
 validfile -> ppos [label="DATA"];
 do -> ppos [label="CALL"];
 do -> vfswritev [label="CALL"];
 vfswritev -> mode [label="LOCAL_CONTROL"];
 mode -> loop [label="LOCAL_CONTROL"];
 do -> iov [label="DATA"];
 iov -> vecfield [label="DATA"];
 vlen -> loop [label="DATA"];
 iovmax -> importoff [label="DATA"];
 iov -> importoff [label="DATA"];
 scalar -> scalaraccess [label="DATA"];
 scalar -> scalariter [label="DATA"];
 loop -> vecfield [label="DATA"];
 loop -> fop [label="DATA"];
 loop -> callwrite [label="CALL"];
 vecfield -> callwrite [label="DATA"];
 fop -> callwrite [label="DATA"];
 vecfield -> badvec [label="ANALYSIS_STOP"];
 fop -> badmethod [label="ANALYSIS_STOP"];
 callwrite -> result [label="RETURN"];
 result -> sum [label="DATA"];
 shortresult -> result [label="DATA"];
 negative -> result [label="DATA"];
 zero -> result [label="DATA"];
 sum -> continuecall [label="LOCAL_CONTROL"];
 continuecall -> loop [label="LOCAL_CONTROL"];
 sum -> signedlimit [label="DATA"];
 sum -> badsum [label="ANALYSIS_STOP"];
 loop -> badindex [label="ANALYSIS_STOP"];
 sum -> aggregate [label="DATA"];
 aggregate -> totalsign [label="DATA"];
 do -> totalsign [label="LOCAL_CONTROL"];
 do -> fdputpos [label="CALL"];
 fdputpos -> fdput [label="CALL"];
 fdput -> fput [label="CALL"];
 fput -> refdec [label="DATA"];
 ppos -> stream [label="LOCAL_CONTROL"];
 ppos -> localpos [label="DATA"];
 localpos -> callwrite [label="DATA"];
 aggregate -> commit [label="LOCAL_CONTROL"];
 totalsign -> commit [label="LOCAL_CONTROL"];
 localpos -> commit [label="DATA"];
 commit -> fpos [label="DATA"];
 fatops -> fop [label="DATA"];
 callwrite -> fatwrite [label="CALL"];
 fatwrite -> inode [label="DATA"];
 fatwrite -> fsbi [label="DATA"];
 fatwrite -> posptr [label="DATA"];
 stream -> posptr [label="DATA"];
 posptr -> badpos [label="ANALYSIS_STOP"];
 inode -> badgeometry [label="ANALYSIS_STOP"];
 fsbi -> badgeometry [label="ANALYSIS_STOP"];
 fatwrite -> buffer [label="CALL"];
 buffer -> badbuffer [label="ANALYSIS_STOP"];
 fatwrite -> cluster [label="DATA"];
 fatwrite -> flags [label="DATA"];
 flags -> sector [label="LOCAL_CONTROL"];
 cluster -> firstcluster [label="DATA"];
 flags -> firstcluster [label="LOCAL_CONTROL"];
 fatwrite -> writemeta [label="CALL"];
 firstcluster -> writemeta [label="DATA"];
 fatwrite -> doloop [label="LOCAL_CONTROL"];
 countzero -> doloop [label="DATA"];
 doloop -> blockread [label="CALL"];
 doloop -> copyfrom [label="CALL"];
 copyfrom -> residue [label="DATA"];
 doloop -> blockwrite [label="CALL"];
 sector -> blockwrite [label="DATA"];
 blockwrite -> blockerr [label="LOCAL_CONTROL"];
 blockwrite -> progress [label="LOCAL_CONTROL"];
 progress -> posptr [label="DATA"];
 progress -> sizeupdate [label="DATA"];
 fatwrite -> sizeupdate [label="LOCAL_CONTROL"];
 sizeupdate -> writemeta [label="CALL"];
 fatwrite -> tailoverwrite [label="LOCAL_CONTROL"];
 tailoverwrite -> fatreturn [label="DATA"];
 blockerr -> fatreturn [label="DATA"];
 fatwrite -> fatreturn [label="RETURN"];
 fatreturn -> result [label="DATA"];
}
