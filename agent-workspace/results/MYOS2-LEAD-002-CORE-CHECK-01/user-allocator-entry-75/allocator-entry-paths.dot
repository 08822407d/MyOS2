// Only a static directed evidence/data graph, not CPU CFG, actual execution or physical release.
// COMMENT, INFERENCE, PRECONDITION and ANALYSIS_STOP are not executable code branches.
// D00 replaces old 74 K48 evidence consumption; no old file is rewritten.
digraph AE75 {
  rankdir=LR;
  node [shape=box];
  D_PSHIFT [label="PAGE_SHIFT=12 (D04)"];
  D_AC [label="_AC(1,UL) C token concatenation (D05)"];
  D_PSIZE [label="PAGE_SIZE macro (D03)"];
  D_TORDER [label="THREAD_SIZE_ORDER=3 (D01)"];
  D_TSIZE [label="THREAD_SIZE macro (D02)"];
  D_OLDK48 [label="74 DOT K48 size claim: replacement consumption"];
  D_32768 [label="32768: bounded C integer projection, not runtime"];
  A_TASK [label="fork alloc_task_struct_node: kzalloc(sizeof(task_s))"];
  A_STACK [label="fork alloc_thread_stack_node: kmalloc(THREAD_SIZE)"];
  A_KZ [label="slub.h kzalloc adds __GFP_ZERO"];
  A_KM [label="slub.h kmalloc"];
  A_GATE [label="kmalloc size > KMALLOC_MAX_CACHE_SIZE?"];
  A_MAX [label="KMALLOC_MAX_CACHE_SIZE=PAGE_SIZE=4096"];
  A_SMALL [label="slab_common.__kmalloc"];
  A_SPIN [label="direct __kmalloc(>4096) spin; historical MC-09"];
  A_KSLAB [label="kmalloc_slab: 0 rejection / index"];
  A_SINDEX [label="size_to_index(1..192)"];
  A_FLS [label="fls(size-1) for 193..4096"];
  A_CACHES [label="kmalloc_caches[index]"];
  A_INFO [label="kmalloc_info sizes incl 8192 slot"];
  A_CREATE [label="create_kmalloc_caches conditional fill 1..13"];
  A_BOOT [label="kmem_cache_init calls create_kmalloc_caches"];
  A_NULLCACHE [label="cache pointer NULL return NULL"];
  A_KALLOC [label="kmem_cache_alloc(s,flags)"];
  A_SALLOC [label="slab_alloc(s,flags)"];
  A_PARTIAL [label="get_from_partial_list"];
  A_INITNEW [label="alloc_init_new_slab"];
  A_ALLOCSLAB [label="alloc_slab -> alloc_pages"];
  A_ALLOCPAGES [label="alloc_pages request / returned page"];
  A_KLARGE [label="kmalloc_large"];
  A_GETORDER [label="get_order(request size)"];
  A_PAGEVIRT [label="page_to_virt on nonNULL page"];
  B_ZEROFLAG [label="__GFP_ZERO macro value"];
  B_COMPFLAG [label="__GFP_COMP macro"];
  B_PREPFLAGS [label="prepare_alloc_flags filters flags for slab page alloc"];
  B_HOOK [label="slab_post_alloc_hook(s,gfpflags,&object)"];
  B_OBJECTSIZE [label="s->object_size"];
  B_MEMSMALL [label="memset(*obj_p,0,s->object_size)"];
  B_MEMLARGE [label="memset(ptr,0,original size)"];
  B_RETNULL [label="NULL failure result (no successful hook)"];
  B_NOZERO [label="stack kmalloc(GFP_KERNEL): no caller ZERO request"];
  B_VALIDOBJ [label="valid nonNULL object and writable length required"];
  C_FREESTACK [label="release_task_stack requests kfree(tsk->stack)"];
  C_FREETASK [label="free_task_struct requests kfree(tsk)"];
  C_STATE [label="exact TASK_DEAD gate on valid task"];
  C_KFREE [label="slub.h kfree(object)"];
  C_NULL [label="object==NULL -> return"];
  C_FOLIO [label="virt_to_folio: virt_to_page -> page_folio"];
  C_TESTSLAB [label="folio_test_slab(PG_slab bit)"];
  C_SLABPATH [label="slab branch"];
  C_NONSLABPATH [label="non-slab branch"];
  C_CACHEFREE [label="kmem_cache_free(cache, object)"];
  C_SLABFREE [label="slab_free"];
  C_FREETOPARTIAL [label="free_to_partial_list"];
  C_FREESLAB [label="free_slab"];
  C_FREEPAGES [label="__free_pages request"];
  C_LARGEFREE [label="free_large_kmalloc"];
  C_FOLIOORDER [label="folio_order"];
  C_WARN0 [label="order==0 pr_warn_once then onward"];
  C_FREE_ORIGIN [label="allocation provenance / object base not proved by PG_slab"];
