// MyOS2 RTC104 fixed-time static-only graph. No Graphviz/port access/model run.
digraph RTC104 {
 graph [rankdir=LR,label="MYOS2 104: D00 RTC -> BCD -> mktime64 -> timekeeper",labelloc=t];
 node [fontsize=9]; edge [fontsize=8];
 timekeeping_init [label="timekeeping_init",shape=box,style=solid];
 persistent [label="read_persistent_clock64",shape=box,style=solid];
 mc_get [label="mc146818_get_time",shape=box,style=solid];
 simple_get [label="simple_mc146818_gettime",shape=box,style=solid];
 CMOS_READ [label="CMOS_READ(addr)",shape=hexagon,style=solid];
 rtc_cmos_read [label="rtc_cmos_read",shape=box,style=solid];
 RTC_PORT [label="RTC_PORT(x)",shape=hexagon,style=solid];
 outb [label="outb from BUILDIO",shape=box,style=solid];
 inb [label="inb from BUILDIO",shape=box,style=solid];
 BUILDIO [label="BUILDIO(b,b,char)",shape=hexagon,style=solid];
 port_index [label="nominal port 0x70 index request",shape=ellipse,style=solid];
 port_data [label="nominal port 0x71 data request",shape=ellipse,style=solid];
 reg_sec [label="RTC_SECONDS index0",shape=ellipse,style=solid];
 reg_min [label="RTC_MINUTES index2",shape=ellipse,style=solid];
 reg_hour [label="RTC_HOURS index4",shape=ellipse,style=solid];
 reg_mday [label="RTC_DAY_OF_MONTH index7",shape=ellipse,style=solid];
 reg_mon [label="RTC_MONTH index8",shape=ellipse,style=solid];
 reg_year [label="RTC_YEAR index9",shape=ellipse,style=solid];
 tm_fields [label="rtc_time_s six int fields",shape=ellipse,style=solid];
 tm_others [label="wday yday isdst not written here",shape=ellipse,style=solid];
 UIP [label="RTC_UIP macro not tested",shape=octagon,style=dashed];
 UIP_retry [label="mc146818_avoid_UIP commented",shape=octagon,style=dashed];
 control [label="RTC_CONTROL mode read commented",shape=octagon,style=dashed];
 century [label="century read commented",shape=octagon,style=dashed];
 bcd2bin [label="bcd2bin(x) dispatch macro",shape=hexagon,style=solid];
 bcd_const [label="const_bcd2bin(x)",shape=hexagon,style=solid];
 bcd_runtime [label="_bcd2bin(unsigned char)",shape=box,style=solid];
 bcd_valid [label="bcd_is_valid exists not invoked",shape=octagon,style=dashed];
 yearcut [label="tm_year <= 69 branch",shape=diamond,style=solid];
 monthdec [label="tm_mon--",shape=diamond,style=solid];
 rtc_converter [label="rtc_tm_to_time64",shape=box,style=solid];
 mktime64 [label="mktime64",shape=box,style=solid];
 monthcalc [label="uint mon-=2 then (int) test",shape=diamond,style=solid];
 daysmath [label="Gregorian unsigned intermediate day expression",shape=diamond,style=solid];
 seconds [label="time64_t seconds",shape=box,style=solid];
 rtc_valid_tm [label="rtc_valid_tm separate checker",shape=box,style=solid];
 rtc_month_days [label="rtc_month_days",shape=box,style=solid];
 rtc_days [label="rtc_days_in_month[] table",shape=ellipse,style=solid];
 is_leap [label="is_leap_year",shape=box,style=solid];
 ts_tv_sec [label="timespec64.tv_sec",shape=ellipse,style=solid];
 ts_tv_nsec [label="timespec64.tv_nsec=0",shape=ellipse,style=solid];
 wall_time [label="timekeeping_init wall_time",shape=ellipse,style=solid];
 local_clock [label="local_clock",shape=box,style=solid];
 native_sched [label="native_sched_clock opaque",shape=box,style=dashed];
 ns_to_ts [label="ns_to_timespec64(s64)",shape=box,style=solid];
 boot_offset [label="boot_offset",shape=ellipse,style=solid];
 timespec_sub [label="timespec64_sub",shape=box,style=solid];
 wall_to_mono_local [label="wall_to_mono computed local",shape=ellipse,style=solid];
 default_clock [label="clocksource_default_clock weak",shape=box,style=solid];
 tk_setup [label="tk_setup_internals",shape=box,style=solid];
 oldclock [label="old_clock pointer and shift domains",shape=diamond,style=solid];
 tkr_raw [label="tkr_raw cached fields",shape=ellipse,style=solid];
 tkr_mono [label="tkr_mono cached fields",shape=ellipse,style=solid];
 tk_set_xtime [label="tk_set_xtime",shape=box,style=solid];
 tk_xtime_sec [label="timekeeper.xtime_sec u64",shape=ellipse,style=solid];
 tk_xtime_nsec [label="tkr_mono.xtime_nsec",shape=ellipse,style=solid];
 raw_sec [label="timekeeper.raw_sec=0",shape=ellipse,style=solid];
 tk_set_wall [label="tk_set_wall_to_mono",shape=box,style=solid];
 tk_wtm [label="timekeeper.wall_to_monotonic",shape=ellipse,style=solid];
 clocksource_done [label="clocksource_done_booting",shape=box,style=solid];
 clocksource_select_macro [label="clocksource_select() macro",shape=hexagon,style=solid];
 __clocksource_select [label="__clocksource_select(false)",shape=box,style=solid];
 register_scale [label="__clocksource_register_scale",shape=box,style=solid];
 update_scale [label="__clocksource_update_freq_scale",shape=box,style=solid];
 clock_enqueue [label="clocksource_enqueue",shape=box,style=solid];
 calc_mult [label="clocks_calc_mult_shift",shape=box,style=solid];
 fs_initcall [label="fs_initcall macro",shape=hexagon,style=solid];
 __define_initcall [label="__define_initcall macro",shape=hexagon,style=solid];
 ___define_initcall [label="___define_initcall macro",shape=hexagon,style=solid];
 __unique_initcall [label="__unique_initcall macro",shape=hexagon,style=solid];
 ____define_initcall [label="____define_initcall macro",shape=hexagon,style=solid];
 initcall_branch [label="PREL32 versus non-PREL32 conditional section",shape=diamond,style=solid];
 RTC_VALID [label="RTC_VRT validity bit macro not read",shape=octagon,style=dashed];
 timekeeping_init -> persistent [label="DIRECT_CALL: wall clock first",style=solid];
 persistent -> mc_get [label="DIRECT_CALL: int status discarded",style=solid];
 mc_get -> simple_get [label="DIRECT_CALL: six requests",style=solid];
 simple_get -> CMOS_READ [label="MACRO_EXPANSION: six macro expressions",style=solid];
 CMOS_READ -> rtc_cmos_read [label="MACRO_EXPANSION: macro target",style=solid];
 rtc_cmos_read -> RTC_PORT [label="MACRO_EXPANSION: port0 then port1",style=solid];
 rtc_cmos_read -> outb [label="DIRECT_CALL: index write",style=solid];
 rtc_cmos_read -> inb [label="DIRECT_CALL: data read",style=solid];
 BUILDIO -> outb [label="MACRO_EXPANSION: emits in/out wrapper",style=solid];
 BUILDIO -> inb [label="MACRO_EXPANSION: emits in/out wrapper",style=solid];
 RTC_PORT -> port_index [label="DATA_FLOW: index port0x70",style=solid];
 RTC_PORT -> port_data [label="DATA_FLOW: data port0x71",style=solid];
 reg_sec -> simple_get [label="DATA_FLOW: distinct requested index",style=solid];
 reg_min -> simple_get [label="DATA_FLOW: distinct requested index",style=solid];
 reg_hour -> simple_get [label="DATA_FLOW: distinct requested index",style=solid];
 reg_mday -> simple_get [label="DATA_FLOW: distinct requested index",style=solid];
 reg_mon -> simple_get [label="DATA_FLOW: distinct requested index",style=solid];
 reg_year -> simple_get [label="DATA_FLOW: distinct requested index",style=solid];
 simple_get -> tm_fields [label="DATA_FLOW: writes six ints",style=solid];
 simple_get -> tm_others [label="DATA_FLOW: does not update three other fields",style=solid];
 mc_get -> UIP_retry [label="UNPROVEN_JOIN: callsite commented; no active retry",style=dashed];
 mc_get -> control [label="UNPROVEN_JOIN: control read commented",style=dashed];
 simple_get -> century [label="UNPROVEN_JOIN: century read commented",style=dashed];
 rtc_cmos_read -> UIP [label="UNPROVEN_JOIN: no status check in this direct function",style=dashed];
 mc_get -> bcd2bin [label="MACRO_EXPANSION: six bcd2bin calls",style=solid];
 bcd2bin -> bcd_const [label="CONDITIONAL_STEP: constant macro choice",style=dotted];
 bcd2bin -> bcd_runtime [label="CONDITIONAL_STEP: runtime helper choice",style=dotted];
 bcd2bin -> bcd_valid [label="UNPROVEN_JOIN: numeric transform not validity call",style=dashed];
 mc_get -> yearcut [label="CONDITIONAL_STEP: decoded <=69 adds100",style=dotted];
 mc_get -> monthdec [label="DATA_FLOW: month minus one",style=solid];
 yearcut -> tm_fields [label="DATA_FLOW: tm_year int",style=solid];
 monthdec -> tm_fields [label="DATA_FLOW: tm_mon int",style=solid];
 persistent -> rtc_converter [label="DIRECT_CALL: RTC to seconds",style=solid];
 rtc_converter -> mktime64 [label="DIRECT_CALL: six converted uint args",style=solid];
 mktime64 -> monthcalc [label="CONDITIONAL_STEP: January February cast gate",style=dotted];
 mktime64 -> daysmath [label="DATA_FLOW: uint day formula",style=solid];
 monthcalc -> daysmath [label="DATA_FLOW: year and mon adjusted conditionally",style=solid];
 daysmath -> seconds [label="DATA_FLOW: time64 value if C legal",style=solid];
 rtc_valid_tm -> rtc_month_days [label="DIRECT_CALL: valid month index and day check",style=solid];
 rtc_month_days -> is_leap [label="DIRECT_CALL: February leap rule",style=solid];
 rtc_days -> rtc_month_days [label="DATA_FLOW: days table index",style=solid];
 persistent -> rtc_valid_tm [label="UNPROVEN_JOIN: no direct active call from persistent/getter/converter",style=dashed];
 seconds -> ts_tv_sec [label="DATA_FLOW: assigned calendar result",style=solid];
 persistent -> ts_tv_nsec [label="DATA_FLOW: assigned zero",style=solid];
 ts_tv_sec -> wall_time [label="DATA_FLOW: two-field timespec output",style=solid];
 ts_tv_nsec -> wall_time [label="DATA_FLOW: zero fraction",style=solid];
 timekeeping_init -> local_clock [label="DIRECT_CALL: opaque local timer",style=solid];
 local_clock -> native_sched [label="DIRECT_CALL: source returns native function",style=solid];
 timekeeping_init -> ns_to_ts [label="DIRECT_CALL: u64 to s64 parameter conversion gate",style=solid];
 ns_to_ts -> boot_offset [label="DATA_FLOW: timespec from clock",style=solid];
 timekeeping_init -> timespec_sub [label="DIRECT_CALL: wall minus boot offset",style=solid];
 boot_offset -> timespec_sub [label="DATA_FLOW: lhs",style=solid];
 wall_time -> timespec_sub [label="DATA_FLOW: rhs",style=solid];
 timespec_sub -> wall_to_mono_local [label="DATA_FLOW: normalized difference, if valid",style=solid];
 timekeeping_init -> default_clock [label="DIRECT_CALL: weak function if selected",style=solid];
 timekeeping_init -> tk_setup [label="DIRECT_CALL: timekeeper clock cache",style=solid];
 tk_setup -> oldclock [label="CONDITIONAL_STEP: old_clock NULL or nonNULL",style=dotted];
 tk_setup -> tkr_mono [label="DATA_FLOW: clock shift mult cache",style=solid];
 tk_setup -> tkr_raw [label="DATA_FLOW: raw shift and fraction conditional rewrite",style=solid];
 oldclock -> tkr_raw [label="CONDITIONAL_STEP: both shift branches write raw when oldclock exists",style=dotted];
 timekeeping_init -> tk_set_xtime [label="DIRECT_CALL: consumer of wall_time",style=solid];
 wall_time -> tk_set_xtime [label="DATA_FLOW: ts argument",style=solid];
 tk_set_xtime -> tk_xtime_sec [label="DATA_FLOW: signed time64 to u64",style=solid];
 tk_set_xtime -> tk_xtime_nsec [label="DATA_FLOW: zero shifted if valid",style=solid];
 timekeeping_init -> raw_sec [label="DATA_FLOW: store0",style=solid];
 timekeeping_init -> tk_set_wall [label="DIRECT_CALL: wtm arg",style=solid];
 wall_to_mono_local -> tk_set_wall [label="DATA_FLOW: computed arg",style=solid];
 tk_set_wall -> tk_wtm [label="UNPROVEN_JOIN: body assignment commented; not stored here",style=dashed];
 clocksource_done -> clocksource_select_macro [label="MACRO_EXPANSION: actual callsite",style=solid];
 clocksource_select_macro -> __clocksource_select [label="MACRO_EXPANSION: expands to false call",style=solid];
 register_scale -> update_scale [label="DIRECT_CALL: G102-20 actual E011",style=solid];
 register_scale -> clock_enqueue [label="DIRECT_CALL: G102-22 actual E012",style=solid];
 update_scale -> calc_mult [label="CONDITIONAL_STEP: only when freq nonzero",style=dotted];
 fs_initcall -> __define_initcall [label="MACRO_EXPANSION: id5",style=solid];
 __define_initcall -> ___define_initcall [label="MACRO_EXPANSION: next macro",style=solid];
 ___define_initcall -> __unique_initcall [label="MACRO_EXPANSION: unique name",style=solid];
 __unique_initcall -> ____define_initcall [label="MACRO_EXPANSION: conditional final",style=solid];
 ____define_initcall -> initcall_branch [label="CONDITIONAL_STEP: PREL32 or section attribute, not executed proof",style=dotted];
 mc_get -> RTC_VALID [label="UNPROVEN_JOIN: valid RAM register not inspected",style=dashed];
}
