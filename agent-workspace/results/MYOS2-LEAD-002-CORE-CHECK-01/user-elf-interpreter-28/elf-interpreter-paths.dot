  main_elf_hdrs -> interp_phdr [label="result: separate phdr buffer or NULL", style=solid];
  loader -> begin [label="call: after interpreter initial checks", style=solid];
  loader -> argpages [label="call: after begin_new_exec", style=solid];
  loader -> main_ptload [label="control: main PT_LOAD loop before interpreter loader", style=dashed];
  loader -> interp_loader [label="conditional_call: if local interpreter non-NULL", style=dashed];
  interp_file -> interp_loader [label="data: interpreter file parameter", style=solid];
  interp_head -> interp_loader [label="data: interp header fields", style=solid];
  interp_phdr -> interp_loader [label="data: interpreter phdr table", style=solid];
  mainbias -> no_base [label="data: actual caller passes main load_bias", style=solid];
  no_base -> interp_loader [label="data: ulong no_base argument", style=solid];
  interp_loader -> interptype [label="control: e_type ET_EXEC/ET_DYN gate", style=dashed];
  interp_loader -> mmapcheck [label="control: mmap method gate, later than begin_new_exec", style=dashed];
  interp_file -> mmapcheck [label="data: file f_op pointer checked", style=solid];
  interp_loader -> totalcalc [label="call: compute PT_LOAD range", style=solid];
  interp_phdr -> totalcalc [label="data: complete phdr array for this helper", style=solid];
  totalcalc -> total [label="result: total mapping span or zero", style=solid];
  interp_loader -> seg_gate [label="control: filter PT_LOAD only", style=dashed];
