  main_elf_hdrs [label="load_elf_phdrs()", shape=box];
  interp_head [label="interp_elf_ex: separately allocated ELF header", shape=ellipse];
  interp_phdr [label="interp_elf_phdata: separate array", shape=ellipse];
  magic [label="ELFMAG/arch/fdpic check", shape=hexagon];
  libbad [label="retval=-ELIBBAD before interp phdr", shape=diamond];
  begin [label="begin_new_exec()", shape=box];
  argpages [label="setup_arg_pages()", shape=box];
  main_ptload [label="main program PT_LOAD loop", shape=hexagon];
  interp_loader [label="load_elf_interp()", shape=box];
  interptype [label="interpreter e_type ET_EXEC/ET_DYN", shape=hexagon];
  mmapcheck [label="interpreter->f_op->mmap gate", shape=hexagon];
  totalcalc [label="total_mapping_size()", shape=box];
  total [label="total_size [bytes]", shape=diamond];
  seg_gate [label="interpreter PT_LOAD gate", shape=hexagon];
  makeprot [label="make_prot()", shape=box];
  flags [label="elf_type: MAP_PRIVATE/MAP_FIXED", shape=diamond];
  no_base [label="no_base (from main load_bias)", shape=diamond];
  vaddr [label="p_vaddr [byte addr]", shape=ellipse];
  load_addr [label="load_addr [interpreter bias]", shape=diamond];
  load_set [label="load_addr_set [0/1]", shape=diamond];
  elfload [label="elf_load()", shape=box];
  elfmap [label="elf_map() [filesz>0 only]", shape=box];
  anon [label="vm_brk_flags() [filesz<memsz only]", shape=box];
  mapaddr [label="map_addr [address/error]", shape=diamond];
  badaddr [label="BAD_ADDR check", shape=hexagon];
  errval [label="error [ulong ~0UL/errno/map/offset]", shape=diamond];
  postgate [label="p_filesz/memsz/TASK_SIZE postcheck", shape=hexagon];
  retval [label="load_elf_binary retval [int]", shape=diamond];
  errcheck [label="IS_ERR_VALUE/PTR_ERR/BAD_ADDR", shape=hexagon];
  mainbias [label="load_bias [main ELF]", shape=diamond];
