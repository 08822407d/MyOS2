// EI28 source time@a039d9803ade; static, conditional, NOT_RUN.
// Edges are semantic: function call is an actual caller, data objects are NOT callers.
// Data/result edges do not assert actual file bytes or physical mappings.
// effect_attempt from kfree/fput does not prove complete global resource release.
// bprm->interpreter field distinct from local interpreter, intentionally no store edge.
digraph EI28_Interpreter {
  graph [rankdir=LR, fontsize=12, labelloc=t, label="EI28: PT_INTERP path to final entry and local cleanup (static only)"];
  node [fontsize=10, shape=box];
  loader [label="load_elf_binary()", shape=box];
  main_phdr [label="elf_phdata: main phdr array", shape=ellipse];
  main_file [label="bprm->file: main executable", shape=ellipse];
  main_head [label="elf_ex: main ELF header in bprm.buf", shape=ellipse];
  interp_type [label="PT_INTERP / p_type gate", shape=hexagon];
  path_length [label="p_filesz [bytes, 2..PATH_MAX]", shape=ellipse];
  path_offset [label="p_offset [main-file byte offset]", shape=ellipse];
  path_ptr [label="elf_interpreter: temporary char*", shape=ellipse];
  kalloc [label="kmalloc()", shape=box];
  kfree [label="kfree()", shape=box];
  elfread [label="elf_read()", shape=box];
  path_nul [label="last-byte NUL gate", shape=hexagon];
  openexec [label="open_exec()", shape=box];
  fname [label="filename_s* local to open_exec", shape=ellipse];
  getname [label="getname_kernel()", shape=box];
  namealloc [label="__myos_getname()", shape=box];
  doopen [label="do_open_execat()", shape=box];
  filpopen [label="do_filp_open()", shape=box];
  putname [label="putname()", shape=box];
