  interp_file -> errcheck [label="data: pointer bits not assumed an error", style=solid];
  loader -> kalloc [label="conditional_call: allocate interp_elf_ex sizeof header", style=dashed];
  kalloc -> interp_head [label="result: independent header buffer", style=solid];
  loader -> elfread [label="conditional_call: read 64-byte interp ELF header at pos=0", style=dashed];
  interp_file -> elfread [label="data: interpreter file, not main file", style=solid];
  interp_head -> elfread [label="data: destination header buffer", style=solid];
  loader -> magic [label="control: ELF magic/arch/fdpic gates before begin_new_exec", style=dashed];
  interp_head -> magic [label="data: read header fields", style=solid];
  loader -> libbad [label="write: retval=-ELIBBAD before check", style=bold];
  loader -> main_elf_hdrs [label="call: read interpreter program headers with other args", style=solid];
