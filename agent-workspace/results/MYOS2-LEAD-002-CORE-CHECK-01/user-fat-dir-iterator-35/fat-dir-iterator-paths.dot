digraph IT35 {
  graph [label="CORE-USER-FAT-DIR-ITERATOR-35 | static; pinned time",rankdir=LR];
  node [shape=box,fontsize=10];
  inode [label="parent inode/FAT32 private fields"];
  chain [label="get_cluster_chain"];
  chain_err [label="ERR_PTR(-ENOMEM or -EIO)"];
  chain_ok [label="ordinary chain list"];
  chain_null [label="iobuf_init checks only ==NULL"];
  chain_count [label="clus_lhdrp->count"];
  init [label="FAT32_iobuf_init"];
  arrays [label="iobuf arrays if count>0"];
  bind [label="cursor=-1; iter_init/next assigned"];
  init_err [label="ERR_PTR(error) on iobuf alloc failure"];
  lookup [label="FAT32_lookup"];
  init_call [label="iobuf->iter_init(iobuf)"];
  cursor_zero [label="cursor=0, end=false, return 0"];
  limit [label="lookup cursor<FAT_MAX_DIR_SIZE?"];
  getter [label="FAT32_get_full_ent"];
  next [label="iobuf->next=FAT32_iobuf_iter_next"];
  readent [label="FAT32_iobuf_readent(old cursor)"];
  bufend [label="nr_clus*bufsize"];
  start_check [label="off<0 or >=bufend?"];
  read_err [label="ERR_PTR(-ENOENT)"];
  indices [label="bufidx=off/bufsize;bufoff=off%bufsize"];
  cache [label="buffers[bufidx]==NULL?"];
  alloc [label="kmalloc(bufsize)"];
  alloc_err [label="ERR_PTR(-ENOMEM)"];
  disk [label="ROOTBLK_TRANSFER clusters[0] (result ignored)"];
  ptr [label="buffers[bufidx]+bufoff"];
  increment [label="cursor+=sizeof(msdos_dirent_s)"];
  end_check [label="if cursor>=bufend set end=true"];
  ret_next [label="next returns original ret_val"];
  attr [label="getter ret_val->attr; FAT32_ent_empty"];
  repeat [label="long/empty and !end?"];
  end_final [label="post-loop end flag?"];
  override [label="overwrite ret_val with ERR_PTR(-ENOENT)"];
  get_ok [label="getter returns ordinary pointer"];
  get_err [label="getter returns encoded pointer"];
  lookup_err [label="lookup IS_ERR(tmpde) => callback NULL"];
  lookup_ok [label="lookup body consumes ordinary tmpde"];
  bound_skip [label="lookup bound false keeps old tmpde"];
  unsafe [label="STOP at invalid pointer/size/nonreturn",shape=octagon];
  premise [label="Valid object and complete dirent required (analysis premise)",shape=note];
  missing_len [label="off+sizeof entry not checked (absent gate)",shape=note];
  index_mismatch [label="buffers indexed by bufidx but disk read clusters[0]",shape=note];
  inode -> chain [label="call"];
  chain -> chain_err [label="encoded failure"];
  chain -> chain_ok [label="normal list"];
  chain_err -> chain_null [label="NULL-only guard does not reject"];
  chain_ok -> chain_null [label="same guard"];
  chain_null -> chain_count [label="non-NULL path"];
  chain_count -> unsafe [label="error-pointer .count invalid",style=dashed];
  chain_count -> init [label="valid chain"];
  init -> arrays [label="allocated iobuf"];
  arrays -> init_err [label="allocation error"];
  arrays -> bind [label="arrays available or count zero"];
  init_err -> unsafe [label="lookup dereferences invalid iobuf",style=dashed];
  bind -> lookup [label="callback caller"];
  lookup -> init_call [label="calls init"];
  init_call -> cursor_zero [label="reset"];
  cursor_zero -> limit [label="first loop"];
  limit -> getter [label="true"];
  limit -> bound_skip [label="false (getter not called)"];
  getter -> next [label="function pointer call"];
  next -> readent [label="old cursor"];
  readent -> bufend [label="compute bounds"];
  bufend -> start_check [label="test"];
  start_check -> read_err [label="out of range"];
  start_check -> indices [label="in range"];
  indices -> cache [label="select cache slot"];
  indices -> missing_len [label="no full entry check"];
  cache -> ptr [label="cache hit"];
  cache -> alloc [label="miss"];
  alloc -> alloc_err [label="NULL"];
  alloc -> disk [label="non-NULL"];
  disk -> ptr [label="publish buffer"];
  indices -> index_mismatch [label="bufidx controls cache"];
  disk -> index_mismatch [label="clusters[0] controls read"];
  read_err -> increment [label="next returns pointer but increments"];
  alloc_err -> increment [label="next returns pointer but increments"];
  ptr -> increment [label="ordinary result"];
  increment -> end_check [label="after fetch"];
  end_check -> ret_next [label="return fetched pointer"];
  ret_next -> attr [label="getter reads before error guard"];
  attr -> unsafe [label="bad ret_val invalid",style=dashed];
  attr -> repeat [label="valid ret_val"];
  repeat -> next [label="skip entry and not end"];
  repeat -> end_final [label="otherwise"];
  end_final -> override [label="end true"];
  end_final -> get_ok [label="end false"];
  override -> get_err [label="return"];
  get_ok -> lookup_ok [label="non-error pointer"];
  get_err -> lookup_err [label="IS_ERR"];
  lookup_err -> unsafe [label="if downstream release fails; no guarantee"];
  lookup_ok -> limit [label="if unmatched next iteration"];
