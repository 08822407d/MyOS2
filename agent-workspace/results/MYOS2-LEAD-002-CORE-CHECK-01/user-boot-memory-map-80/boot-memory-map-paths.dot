digraph CORE_USER_BOOT_MEMORY_MAP_80 {
  graph [label="第80批：启动内存图输入/PFN/早期memblock接合及79文档纠正；静态，非真实运行轨迹", labelloc="t", rankdir="LR", fontsize="15"];
  node [shape="box", fontsize="9", fontname="sans-serif"];
  edge [fontname="sans-serif", fontsize="8"];
  // Edge type is semantic: CALL, CALLER_SEQUENCE, DATA, MACRO, CONDITION, ANALYSIS_STOP, HYPOTHETICAL_SEQUENCE.
  // Caller sequence is NOT a claim that the previous node calls the next.
  subgraph cluster_D {
    label="D00:历史文档补正";
    D_old [label="79/A06 A07 macro外ifndef引文"];
    D_fix [label="80/D01 D02 单行宏定义"];
    D_hist [label="79 95原始标签与旧统计"];
    D_sup [label="80历史清单补记，区分当前取证"];
    D_s01 [label="79-S01 PAGE_SIZE / retry / mirror"];
    D_s02 [label="79-S02 关系顺序、iterator终点"];
    D_s03 [label="79-S03 类型与指针边界"];
    D_pending [label="R79-01/02仅C06闭合", style="dashed"];
  }
  subgraph cluster_A {
    label="G01/A:标签与E820";
    A_source [label="外部启动输入源/extent未知"];
    A_startup [label="__startup_64 内核C copy分支"];
    A_copy [label="memcpy sizeof(multiboot_MBI)"];
    A_buffer [label="multiboot_MBI[32*PAGE_SIZE]"];
    A_startkernel [label="x86_64_start_kernel"];
    A_early [label="myos_early_init_system"];
    A_parse [label="parse_tag"];
    A_magic [label="magic校验"];
    A_align [label="addr&7校验"];
    A_head [label="读取total_size但未作上界"];
    A_tagloop [label="tag.type END与tag.size取整"];
    A_mmap [label="MMAP tag / entries"];
    A_ram [label="ram_map指针"];
    A_e820setup [label="e820__memory_setup"];
    A_srcstride [label="mmap_entp++固定C对象步长"];
    A_sentinel [label="len/type非0循环门"];
    A_dest [label="e820_table.entries[i]"];
    A_cap [label="E820_MAX_ENTRIES 128"];
    A_publish [label="e820_table.nr_entries=i"];
    A_print [label="e820__print_table"];
    A_stop_extent [label="STOP：输入tag/entries未证extent", style="dashed"];
    A_stop_zero [label="STOP：非END tag零步长", style="dashed"];
    A_stop_cap [label="STOP：第129条形成entries[128]", style="dashed"];
  }
  subgraph cluster_B {
    label="G02/B:最大PFN";
    B_wrap [label="e820__end_of_ram_pfn()宏"];
    B_real [label="e820__end_ram_pfn(limit)"];
    B_maxmem [label="MAXMEM 1UL<<MAX_PHYSMEM_BITS"];
    B_arch [label="MAX_ARCH_PFN (MAXMEM>>PAGE_SHIFT)"];
    B_pageshift [label="PAGE_SHIFT=12"];
    B_nr [label="nr_entries"];
    B_filter [label="RAM或ACPI类型筛选"];
    B_addr [label="entry.addr + entry.size"];
    B_start [label="start_pfn"];
    B_end [label="end_pfn"];
    B_limit [label="limit_pfn"];
    B_last [label="last_pfn最大/limit/break/cap"];
    B_setup [label="setup_arch"];
    B_maxpfn [label="max_pfn / max_possible_pfn"];
    B_low [label="max_low_pfn"];
    B_high [label="high_memory=__va(...)+1"];
    B_zone [label="zone_sizes_init"];
    B_freearea [label="free_area_init"];
    B_stop_wrap [label="STOP：端点u64回绕", style="dashed"];
    B_stop_high [label="STOP：未证地址映射/指针形成", style="dashed"];
  }
  subgraph cluster_C {
    label="G03/C:早期预留与移交";
    C_setup [label="setup_arch"];
    C_early [label="early_reserve_memory"];
    C_kernel [label="内核_text至end_of_kernel_reserve"];
    C_low [label="保留0..SZ_64K"];
    C_bios [label="保留0x9F000..SZ_1M"];
    C_reserve [label="simple_mmblk_reserve"];
    C_brkalloc [label="early_alloc_pgt_buf"];
    C_extend [label="extend_brk(size,align)"];
    C_mask [label="align-1和align&mask"];
    C_brkend [label="_brk_end更新/memset"];
    C_brkclose [label="reserve_brk"];
    C_clear [label="_brk_start=0"];
    C_maphook [label="myos_early_map_pgt_buf_into_directmap"];
    C_e820handoff [label="e820__memblock_setup"];
    C_type [label="E820 type分派"];
    C_physend [label="u64 end与resource_size_t同宽cast"];
    C_soft [label="SOFT_RESERVED"];
    C_ram [label="RAM"];
    C_other [label="ACPI/RESERVED/其它"];
    C_add [label="simple_mmblk_add"];
    C_trim [label="memblock_trim_memory(PAGE_SIZE)"];
    C_old79 [label="MR79-F/U前置合法性门"];
    C_memory [label="memblock.memory"];
    C_reserved [label="memblock.reserved"];
    C_mapping [label="init_mem_mapping"];
    C_zone [label="zone_sizes_init"];
    C_stop_brk [label="STOP：brk无效算术/指针", style="dashed"];
    C_stop_phys [label="STOP：u64 end已回绕", style="dashed"];
    C_stop_old [label="STOP：79首个未证门", style="dashed"];
  }
  D_old -> D_fix [type="DATA", label="DATA | 定义边界替代引文"];
  D_hist -> D_sup [type="DATA", label="DATA | 原始字段缺口 当前补记不追认"];
  D_s01 -> D_pending [type="ANALYSIS_STOP", label="ANALYSIS_STOP | S01条件保留，不能自行关闭", style="dashed"];
  D_s02 -> D_pending [type="ANALYSIS_STOP", label="ANALYSIS_STOP | S02图消费限定", style="dashed"];
  D_s03 -> D_pending [type="ANALYSIS_STOP", label="ANALYSIS_STOP | S03类型与指针限定", style="dashed"];
  D_fix -> D_pending [type="DATA", label="DATA | 交由C06独立判"];
  A_source -> A_startup [type="DATA", label="DATA | 复制源与有效extent待证"];
  A_startup -> A_copy [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | magic分支后才复制"];
  A_copy -> A_buffer [type="DATA", label="DATA | 目标固定字节数"];
  A_startkernel -> A_early [type="CALL", label="CALL | 所读C函数直接调用"];
  A_early -> A_parse [type="CALL", label="CALL | magic和MBI指针实参"];
  A_buffer -> A_parse [type="DATA", label="DATA | 地址作为parse_tag参数"];
  A_parse -> A_magic [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 先magic"];
  A_magic -> A_align [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | magic通过后才对齐门"];
  A_align -> A_head [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 校验通过后取header"];
  A_head -> A_tagloop [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | size读取后转type循环"];
  A_tagloop -> A_mmap [type="CONDITION", label="CONDITION | type==MMAP时命中"];
  A_tagloop -> A_stop_zero [type="ANALYSIS_STOP", label="ANALYSIS_STOP | size0且非END可不前进", style="dashed"];
  A_tagloop -> A_stop_extent [type="ANALYSIS_STOP", label="ANALYSIS_STOP | 缺END/非法tag边界", style="dashed"];
  A_mmap -> A_ram [type="DATA", label="DATA | 发布entries的指针"];
  A_ram -> A_e820setup [type="DATA", label="DATA | e820复制源指针"];
  A_e820setup -> A_srcstride [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | mmap_entp++"];
  A_e820setup -> A_sentinel [type="CONDITION", label="CONDITION | len && type非0"];
  A_srcstride -> A_sentinel [type="DATA", label="DATA | 源地址步进影响下次读"];
  A_sentinel -> A_dest [type="CONDITION", label="CONDITION | 继续循环才构造目标"];
  A_cap -> A_dest [type="DATA", label="DATA | 目标数组容量128"];
  A_dest -> A_stop_cap [type="ANALYSIS_STOP", label="ANALYSIS_STOP | i=128形成越界地址", style="dashed"];
  A_dest -> A_publish [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 循环结束后才发布"];
  A_publish -> A_print [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 打印消费nr_entries"];
  A_sentinel -> A_stop_extent [type="ANALYSIS_STOP", label="ANALYSIS_STOP | 没有可读哨兵时停止", style="dashed"];
  B_maxmem -> B_arch [type="MACRO", label="MACRO | MAXMEM参与宏替换"];
  B_pageshift -> B_arch [type="MACRO", label="MACRO | PAGE_SHIFT参与右移"];
  B_arch -> B_wrap [type="MACRO", label="MACRO | 无参宏实参"];
  B_wrap -> B_real [type="MACRO", label="MACRO | 宏展开产生callee调用"];
  B_nr -> B_real [type="DATA", label="DATA | 目标表已发布的计数"];
  B_real -> B_filter [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 每entry先类型筛选"];
  B_filter -> B_start [type="CONDITION", label="CONDITION | 仅RAM和ACPI"];
  B_filter -> B_end [type="CONDITION", label="CONDITION | 仅RAM和ACPI"];
  B_addr -> B_end [type="DATA", label="DATA | 求和后右移"];
  B_addr -> B_stop_wrap [type="ANALYSIS_STOP", label="ANALYSIS_STOP | u64端点回绕", style="dashed"];
  B_start -> B_last [type="CONDITION", label="CONDITION | start>=limit跳过"];
  B_end -> B_last [type="DATA", label="DATA | end对最大值或limit"];
  B_limit -> B_last [type="CONDITION", label="CONDITION | end>limit截断并break"];
  B_arch -> B_last [type="DATA", label="DATA | 最后架构cap"];
  B_real -> B_setup [type="DATA", label="DATA | return last_pfn"];
  B_setup -> B_maxpfn [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 赋值max_pfn"];
  B_maxpfn -> B_low [type="DATA", label="DATA | max_low_pfn=max_pfn"];
  B_low -> B_high [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | high_memory表达式"];
  B_high -> B_stop_high [type="ANALYSIS_STOP", label="ANALYSIS_STOP | 不证明映射或指针合法", style="dashed"];
  B_low -> B_zone [type="DATA", label="DATA | zone上界"];
  B_zone -> B_freearea [type="CALL", label="CALL | 直接传zone bounds"];
  C_setup -> C_early [type="CALL", label="CALL | 直接调用早期预留"];
  C_early -> C_reserve [type="CALL", label="CALL | early_reserve_memory直接发出三次保留请求"];
  C_early -> C_kernel [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 先kernel span"];
  C_early -> C_low [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 再低64KiB"];
  C_early -> C_bios [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 再BIOS区间"];
  C_kernel -> C_reserve [type="DATA", label="DATA | reserve请求"];
  C_low -> C_reserve [type="DATA", label="DATA | reserve请求"];
  C_bios -> C_reserve [type="DATA", label="DATA | reserve请求"];
  C_reserve -> C_reserved [type="DATA", label="DATA | reserved.add_range消费"];
  C_setup -> C_brkalloc [type="CALL", label="CALL | 早期页表buffer入口"];
  C_brkalloc -> C_extend [type="HYPOTHETICAL_SEQUENCE", label="HYPOTHETICAL_SEQUENCE | 内部申请未在本包审计，不能声称实际调用", style="dashed"];
  C_extend -> C_mask [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | align-1先行"];
  C_mask -> C_brkend [type="CONDITION", label="CONDITION | 仅先行检查通过"];
  C_mask -> C_stop_brk [type="ANALYSIS_STOP", label="ANALYSIS_STOP | align0/非2幂和地址门", style="dashed"];
  C_brkend -> C_stop_brk [type="ANALYSIS_STOP", label="ANALYSIS_STOP | 加法/指针/可写extent未证", style="dashed"];
  C_setup -> C_brkclose [type="CALL", label="CALL | 在e820接合前调用"];
  C_brkclose -> C_reserve [type="CALL", label="CALL | 非空brk才reserve"];
  C_brkclose -> C_clear [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 忽略reserve返回后置清零"];
  C_brkalloc -> C_brkclose [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | setup_arch中先后"];
  C_brkclose -> C_maphook [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | setup_arch中先后"];
  C_maphook -> C_e820handoff [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | setup_arch中先后"];
  C_setup -> C_e820handoff [type="CALL", label="CALL | 直接调用"];
  C_e820handoff -> C_physend [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 每entry先端点算术"];
  C_physend -> C_type [type="CONDITION", label="CONDITION | 比较后继续分派"];
  C_physend -> C_stop_phys [type="ANALYSIS_STOP", label="ANALYSIS_STOP | 回绕不能由同宽cast查出", style="dashed"];
  C_type -> C_soft [type="CONDITION", label="CONDITION | type==SOFT_RESERVED"];
  C_type -> C_ram [type="CONDITION", label="CONDITION | type==RAM"];
  C_type -> C_other [type="CONDITION", label="CONDITION | 其它跳过add"];
  C_soft -> C_reserve [type="CONDITION", label="CONDITION | SOFT请求"];
  C_ram -> C_add [type="CONDITION", label="CONDITION | RAM请求"];
  C_add -> C_memory [type="DATA", label="DATA | memory.add_range"];
  C_e820handoff -> C_trim [type="CALL", label="CALL | 循环结束后trim"];
  C_memory -> C_trim [type="DATA", label="DATA | trim目标memory"];
  C_memory -> C_old79 [type="CONDITION", label="CONDITION | 依赖旧79区间算法"];
  C_reserved -> C_old79 [type="CONDITION", label="CONDITION | 依赖旧79区间算法"];
  C_old79 -> C_stop_old [type="ANALYSIS_STOP", label="ANALYSIS_STOP | 真实路径首个未证C门", style="dashed"];
  C_e820handoff -> C_mapping [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | 返回后进入init_mem_mapping"];
  C_mapping -> C_zone [type="CALLER_SEQUENCE", label="CALLER_SEQUENCE | setup_arch后续zone入口"];
}
