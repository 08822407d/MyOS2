// CORE-USER-WAIT-WAKE-CONSISTENCY-52. Source-level conditional A/B/C graph; NOT_RUN.
// solid=local/call/control; dashed=conditional cross-context or loop; dotted=STOP/scope.
digraph WW52 {
 graph [rankdir=LR,labelloc=t,label="Wait/Wake Consistency 52: A counted queue; B timer; C caller roles"];
 node [shape=box,fontsize=10];
 a0 [label="A swait prepare"];
 a1 [label="List_hdr count++"];
 a2 [label="anchor linked nodes"];
 a3 [label="swake checks count==0"];
