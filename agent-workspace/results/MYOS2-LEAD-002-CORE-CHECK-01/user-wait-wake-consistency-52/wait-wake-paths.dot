 b12 [label="running_timer == timer?"];
 b13 [label="ret negative + cpu_relax retry"];
 b14 [label="detach_if_pending true"];
 b15 [label="del returns int ignored"];
 b16 [label="destroy_timer_on_stack empty"];
 b17 [label="return original finite timeout"];
 b18 [label="process_timeout async callback possible"];
 b19 [label="wake_up_process request"];
 b20 [label="STOP wheel/scheduler/lock internals"];
 c0 [label="C direct caller class"];
 c1 [label="devtmpfs setup_done"];
 c2 [label="kthread done"];
 c3 [label="init kthreadd_done"];
 c4 [label="device request done"];
 c5 [label="public wait_for_completion void"];
 c6 [label="wait_for_common MAX action"];
 c7 [label="complete(done)"];
 c8 [label="down_timeout int"];
 c9 [label="msleep while"];
 c10 [label="STOP full build/runtime"];
 a0 -> a1 [label="local: self-linked node append",style=solid];
