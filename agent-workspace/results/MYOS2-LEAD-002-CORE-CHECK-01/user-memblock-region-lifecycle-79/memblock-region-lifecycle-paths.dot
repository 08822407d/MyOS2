  D_fix -> D_pages [type="replacement", label="replacement | PB78-F06", style=solid];
  D_pages -> D_pages_read [type="stop", label="stop | indeterminate read", style=solid];
  A_add -> A_cap [type="call", label="call | memory", style=solid];
  A_reserve -> A_cap [type="call", label="call | reserved", style=solid];
  A_memory -> A_add [type="state", label="state | 初值", style=solid];
  A_reserved -> A_reserve [type="state", label="state | 初值", style=solid];
  A_cap -> A_zero [type="gate", label="gate | size==0", style=solid];
  A_cap -> A_loop [type="gate", label="gate | size>0", style=solid];
  A_loop -> A_prev [type="data", label="data | idx0", style=solid];
  A_prev -> A_STOP [type="stop", label="stop | 先于if idx>0", style=solid];
  A_loop -> A_readslot [type="conditional", label="conditional | 继续假设合法", style=dashed];
  A_readslot -> A_tail [type="gate", label="gate | idx==cnt", style=solid];
  A_tail -> A_overflow [type="stop", label="stop | cnt==max", style=solid];
  A_readslot -> A_skip [type="gate", label="gate | rend<=base idx<cnt", style=solid];
  A_readslot -> A_before [type="gate", label="gate | idx==cnt或rbase>=end", style=solid];
  A_readslot -> A_overlap [type="gate", label="gate | rbase<end", style=solid];
  A_overlap -> A_unsigned [type="stop", label="stop | base>rbase", style=solid];
  A_readslot -> A_goto [type="gate", label="gate | 其余分支", style=solid];
  A_before -> A_callinsert [type="call", label="call | 隔离前提", style=solid];
  A_overlap -> A_callinsert [type="conditional", label="conditional | 大小未证正确", style=dashed];
  A_callinsert -> A_callmerge [type="call", label="call | idx-1", style=solid];
  A_callmerge -> A_latecheck [type="conditional", label="conditional | 若返回", style=dashed];
  A_goto -> A_latecheck [type="conditional", label="conditional | 若扫描结束", style=dashed];
  A_callinsert -> B_idx [type="call", label="call | 插入", style=solid];
  B_idx -> B_capacity [type="gate", label="gate | 容量检验晚于取址", style=solid];
  B_capacity -> B_move [type="gate", label="gate | cnt<max", style=solid];
  B_move -> B_write [type="state", label="state | 新槽base,size", style=solid];
  B_write -> B_flag [type="data", label="data | 缺flags写入", style=solid];
  B_write -> B_inc [type="state", label="state | cnt,total递增", style=solid];
  A_callmerge -> B_merge_start [type="call", label="call | 合并", style=solid];
  B_merge_start -> B_signed [type="gate", label="gate | idx0", style=solid];
  B_merge_start -> B_pair [type="gate", label="gate | 有效i/end", style=solid];
  B_pair -> B_mismatch [type="gate", label="gate | 不相接或flags不同", style=solid];
  B_pair -> B_left [type="gate", label="gate | 相接且flags同", style=solid];
  B_left -> B_total [type="state", label="state | 先增加", style=solid];
  B_total -> B_remove [type="call", label="call | 右邻删除", style=solid];
  B_remove -> B_sub [type="state", label="state | 扣旧size", style=solid];
  B_sub -> B_shift [type="call", label="call | memmove左移", style=solid];
  B_shift -> B_dec [type="state", label="state | cnt--不清尾", style=solid];
  B_dec -> B_bridge [type="conditional", label="conditional | bridge截断扫描范围", style=dashed];
  B_dec -> C_stale [type="data", label="data | 物理槽数据残留", style=solid];
  C_trim -> C_topdown [type="call", label="call | 倒序", style=solid];
  C_topdown -> C_align [type="data", label="data | 有效记录", style=solid];
  C_align -> C_keep [type="gate", label="gate | start<end", style=solid];
  C_keep -> C_stale_total [type="state", label="state | 没有total更新", style=solid];
  C_align -> C_del [type="gate", label="gate | start>=end", style=solid];
  C_del -> B_remove [type="call", label="call | 删除", style=solid];
  C_del -> C_skipprev [type="stop", label="stop | 内部与宏双r--", style=solid];
  C_search -> C_empty [type="gate", label="gate | cnt0", style=solid];
