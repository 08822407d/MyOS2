digraph CORE_USER_MEMBLOCK_REGION_LIFECYCLE_79 {
  graph [label="第79批 memblock 区间生命周期／R78-01纠正；静态、条件模型，非运行结果", labelloc=t, fontsize=16, rankdir=LR];
  node [shape=box, fontname="sans-serif", fontsize=10];
  edge [fontname="sans-serif", fontsize=8];
  // 各边type表示源码调用/状态/数据/门/停止/假设或历史替代；不是动态trace。
  subgraph cluster_D {
    label="历史勘误与停止门";
    D_fix [label="D00 R78-01 追加纠正", shape=box];
    D_macro [label="D01 __va实际宏定义单行", shape=box];
    D_ifndef [label="ifndef仅条件 不属于宏定义", shape=box];
    D_internal [label="memblock_alloc_internal", shape=box];
    D_first [label="首轮memblock_alloc_range", shape=box];
    D_retry [label="首轮物理0且min非零重试", shape=box];
    D_zero [label="重试仍物理0返回NULL", shape=diamond];
    D_translate [label="非0再phys_to_virt", shape=box];
    D_direct [label="alloc_node_mem_map直接转换", shape=box];
    D_zone [label="zone first producer B13", shape=box];
    D_reset [label="memmap B19覆写present0", shape=box];
    D_pages [label="memblock_free_all pages未初始化", shape=box];
    D_pages_read [label="pages自加首个非空PFN阻断", shape=box];
  }
  subgraph cluster_A {
    label="G01 注册与裁剪";
    A_memory [label="memory cnt0/max128", shape=box];
    A_reserved [label="reserved cnt0/max256", shape=box];
    A_add [label="simple_mmblk_add(memory)", shape=box];
    A_reserve [label="simple_mmblk_reserve(reserved)", shape=box];
    A_cap [label="cap_size physical bytes", shape=box];
    A_zero [label="size0返回ENOERR无插入", shape=diamond];
    A_loop [label="for_each_memblock_type cnt+1", shape=box];
    A_prev [label="idx0先形成rgn-1", shape=box];
    A_STOP [label="C指针界限_STOP", shape=diamond];
    A_readslot [label="读rbase/rend含tail", shape=box];
    A_tail [label="idx==cnt可能tail未有效", shape=box];
    A_overflow [label="cnt==max tail读越界", shape=box];
    A_skip [label="旧段结束<=base则continue", shape=box];
    A_before [label="新段在前或尾槽end-base", shape=box];
    A_overlap [label="rbase<end计算rbase-base", shape=box];
    A_unsigned [label="负差转size_t风险", shape=box];
    A_goto [label="else goto no_update", shape=box];
    A_callinsert [label="memblock_insert_region", shape=box];
    A_callmerge [label="simple_mmblk_merge_rgn idx-1", shape=box];
    A_latecheck [label="循环后cnt>=max-2检查", shape=box];
  }
  subgraph cluster_B {
    label="G02 插入合并删除";
    B_idx [label="insert rgn=&regions[idx]", shape=box];
    B_capacity [label="BUG_ON cnt>=max后置", shape=box];
    B_move [label="memmove旧项向右", shape=box];
    B_write [label="仅写base与size", shape=box];
    B_flag [label="flags未赋值", shape=box];
    B_inc [label="cnt++和total+=size", shape=box];
    B_merge_start [label="merge(start_rgn,end_rgn)", shape=box];
    B_signed [label="idx0负号/ulong/int边界", shape=box];
    B_pair [label="相邻this/next端点与flags", shape=box];
    B_mismatch [label="不匹配i++或重叠BUG_ON", shape=box];
    B_left [label="匹配左区间size扩容", shape=box];
    B_total [label="total_size临时加右块size", shape=box];
    B_remove [label="remove右记录", shape=box];
    B_sub [label="先total_size-=oldsize", shape=box];
    B_shift [label="memmove覆盖原槽", shape=box];
    B_dec [label="cnt--不清尾槽", shape=box];
    B_bridge [label="桥接后右邻居未必合并", shape=box];
  }
  subgraph cluster_C {
    label="G03 裁齐搜索分配";
    C_trim [label="trim_memory topdown", shape=box];
    C_topdown [label="idx=cnt-1，macro r--", shape=box];
    C_align [label="round_up/base,round_down/end", shape=box];
    C_keep [label="非空slice写base和size", shape=box];
    C_stale_total [label="trim未更新total_size", shape=box];
    C_del [label="空slice remove并r--", shape=box];
    C_skipprev [label="宏又r--跳过前项", shape=box];
    C_search [label="memblock_search do/while", shape=box];
    C_empty [label="cnt0仍读slot0", shape=box];
    C_stale [label="删后旧slot仍可被读", shape=box];
    C_member [label="is_memory / is_reserved", shape=box];
    C_map [label="is_map_memory先命中再NOMAP", shape=box];
    C_subset [label="is_region_memory先查base后检查end", shape=box];
    C_free [label="for_each_free_mem_range", shape=box];
    C_skipflag [label="should_skip_region flags筛选", shape=box];
    C_dual [label="双索引扫描memory-reserved", shape=box];
    C_reservedtail [label="reserved尾槽仅指针/条件分支", shape=box];
    C_intersect [label="半开相交区间输出", shape=box];
    C_find [label="__memblock_find_range_bottom_up", shape=box];
    C_round [label="clamp+round_up candidate", shape=box];
    C_valid [label="candidate<this_end且剩余够size", shape=box];
    C_alloc [label="memblock_alloc_range", shape=box];
    C_align0 [label="align0使用SMP_CACHE_BYTES", shape=box];
    C_end0 [label="end特殊值转current_limit", shape=box];
    C_pagefloor [label="start>=PAGE_SIZE", shape=box];
    C_reservetry [label="非0candidate调用reserve", shape=box];
    C_success [label="reserve返回0物理地址输出", shape=box];
    C_failure [label="否则返回物理0", shape=diamond];
    C_zeroalloc [label="size0 reserve无记录仍可能返回非0", shape=box];
  }
  D_fix -> D_macro [type="replacement", label="replacement | R78-A31", style=solid];
  D_ifndef -> D_macro [type="condition", label="condition | 预处理分支未定", style=solid];
  D_fix -> D_internal [type="replacement", label="replacement | R78-S02", style=solid];
  D_internal -> D_first [type="call", label="call | 首轮", style=solid];
  D_first -> D_retry [type="gate", label="gate | phys0,min>0", style=solid];
