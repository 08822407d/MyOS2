  C_search -> C_subset [type="data", label="data | 起点搜+截size", style=solid];
  C_free -> C_skipflag [type="call", label="call | memory属性", style=solid];
  C_skipflag -> C_dual [type="gate", label="gate | 允许扫描", style=solid];
  C_dual -> C_reservedtail [type="data", label="data | 终端gap", style=solid];
  C_reservedtail -> C_intersect [type="data", label="data | 输出交集", style=solid];
  C_intersect -> C_find [type="call", label="call | 候选区间", style=solid];
  C_find -> C_round [type="call", label="call | clamp/align", style=solid];
  C_round -> C_valid [type="gate", label="gate | cand和size", style=solid];
  C_alloc -> C_align0 [type="gate", label="gate | align==0", style=solid];
  C_alloc -> C_end0 [type="gate", label="gate | end==0或1", style=solid];
  C_alloc -> C_pagefloor [type="gate", label="gate | start下界", style=solid];
  C_align0 -> C_find [type="call", label="call | 选定align", style=solid];
  C_end0 -> C_find [type="call", label="call | 选定end", style=solid];
  C_pagefloor -> C_find [type="call", label="call | 物理下界", style=solid];
  C_valid -> C_reservetry [type="gate", label="gate | found!=0", style=solid];
