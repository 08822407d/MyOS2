  m_B_V07 [label="B-V07 (underflow)"];
  m_B_V08 [label="B-V08 (software_route)"];
  m_B_R01 [label="B-R01 (ioapic_retentry_T)"];
  m_B_R02 [label="B-R02 (ioapic_map_s)"];
  m_B_R03 [label="B-R03 (ioapic_rte_read)"];
  m_B_R04 [label="B-R04 (ioapic_rte_read)"];
  m_B_R05 [label="B-R05 (ioapic_rte_write)"];
  m_B_R06 [label="B-R06 (ioapic_mask)"];
  m_B_R07 [label="B-R07 (ioapic_ack)"];
  m_B_R08 [label="B-R08 (HPET_RTE)"];
  m_B_R09 [label="B-R09 (IOAPIC_init)"];
  m_C_S01 [label="C-S01 (start_kernel)"];
  m_C_S02 [label="C-S02 (init_IRQ)"];
  m_C_S03 [label="C-S03 (idt_to_stubs)"];
  m_C_S04 [label="C-S04 (asm_to_C)"];
  m_C_S05 [label="C-S05 (HPET_time)"];
  m_C_S06 [label="C-S06 (HPET_registration)"];
  m_C_S07 [label="C-S07 (LVT_registration)"];
  m_C_S08 [label="C-S08 (preinit_ack)"];
  m_C_S09 [label="C-S09 (time_relationship)"];
