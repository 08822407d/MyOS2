 no_hardware -> idt_memory [label="UNPROVEN_JOIN: no timer device delivery proof",color=red,style=dashed];
 irq_entries -> common_irq_entry [label="ASM_SOURCE_BRANCH: push dummy and vector, jump common",color=gray,style=solid];
 common_irq_entry -> excep_context [label="ASM_CALL_REQUEST: C function call after register save",color=gray,style=solid];
 common_irq_entry -> no_cpu_return [label="CONDITIONAL_STEP: iretq only after callee normal return",color=gray,style=solid];
 excep_context -> irq_vector [label="DATA_READ: reads regs->irq_nr",color=darkorange,style=dotted];
 excep_context -> hw_handler [label="DIRECT_CALL_CONDITIONAL: when vector >=0x20",color=gray,style=solid];
 hw_handler -> descriptor_table [label="DATA_READ: indexes same full vector",color=darkorange,style=dotted];
