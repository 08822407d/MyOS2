// Fixed time@a039d9803ade; source-only semantic graph. No Graphviz or hardware run.
// DIRECT_CALL, CALLBACK_BINDING, DATA_FLOW and UNPROVEN_JOIN are distinct relations.
digraph IR101 {
 graph [rankdir=LR,label="IR101 registration / routing / HPET LVT dispatch (source only)",labelloc=t];
 node [shape=box,fontsize=9]; edge [fontsize=8];
 subgraph cluster_sources {label="real function/data owners, not test observations";
  start_kernel [label="C start_kernel, source caller",shape=box];
  init_IRQ [label="C init_IRQ, source caller",shape=box];
  idt_gates [label="C idt_setup_apic_and_irq_gates",shape=box];
  bsp_intr [label="C myos_init_bsp_intr",shape=box];
  ioapic_init [label="C IOAPIC_init (register setup text)",shape=box];
  ioapic_install [label="C IOAPIC_install",shape=box];
  ioapic_enable [label="C IOAPIC_enable",shape=box];
  ioapic_disable [label="C IOAPIC_disable",shape=box];
  ioapic_uninstall [label="C IOAPIC_uninstall",shape=box];
  ioapic_rte_read [label="C ioapic_rte_read",shape=box];
  ioapic_rte_write [label="C ioapic_rte_write",shape=box];
  ioapic_edge_ack [label="C IOAPIC_edge_ack",shape=box];
  ioapic_level_ack [label="C IOAPIC_level_ack, not bound in shown two controllers",shape=box];
  apic_msr_write [label="C inline apic_msr_write request",shape=box];
  late_time_init [label="C late_time_init",shape=box];
  hpet_time_init [label="C hpet_time_init",shape=box];
  hpet_enable [label="C hpet_enable (opaque bounded result)",shape=box];
  hpet_init [label="C myos_HPET_init",shape=box];
  hpet_handler [label="C HPET_handler",shape=box];
  hpet_ctrl [label="Data HPET_int_controller callbacks",shape=box];
  hpet_entry [label="Data local HPET ioapic_retentry_T, incomplete fields",shape=box];
  percpu_intr [label="C myos_init_percpu_intr",shape=box];
  lvt_init [label="C LVT_timer_init",shape=box];
  lvt_handler [label="C LVT_timer_handler",shape=box];
  lvt_ack [label="C LVT_timer_ack",shape=box];
  lvt_ctrl [label="Data LVT_timer_int_controller callbacks",shape=box];
  descriptor_table [label="Data irq_descriptors[NR_VECTORS]",shape=box];
  register_irq [label="C register_irq",shape=box];
  unregister_irq [label="C unregister_irq",shape=box];
  hw_handler [label="C hwint_irq_handler",shape=box];
  excep_context [label="C excep_hwint_context",shape=box];
  in_atomic [label="Macro in_atomic",shape=box];
  schedule [label="C schedule opaque call",shape=box];
  idt_memory [label="Data IDT gates/stub offsets",shape=box];
  irq_entries [label="ASM irq_entries_start",shape=box];
  common_irq_entry [label="ASM sa_entintr_retp",shape=box];
  irq_vector [label="Data regs->irq_nr from presumed frame",shape=box];
  ioapic_map [label="Data ioapic_map MMIO address requests",shape=box];
  index_u8 [label="uint8_t IOAPIC register selector",shape=box];
  lvt_reg [label="Data local periodic LVT timer register value",shape=box];
  no_hardware [label="UNKNOWN: real timer IRQ hardware delivery",shape=octagon];
  no_cpu_return [label="UNKNOWN: actual frame/iretq/CPU result",shape=octagon];
  no_success [label="PROOF_BOUNDARY: no real test/compile/MSR/MMIO",shape=octagon];
  d00 [label="R100-01 six old evidence classifications corrected only",shape=box];
 }
 subgraph cluster_matrices {label="matrix IDs, not callable nodes";
  m_A_L01 [label="A-L01 (irq_descriptors)"];
  m_A_L02 [label="A-L02 (register_irq)"];
  m_A_L03 [label="A-L03 (register_irq)"];
  m_A_L04 [label="A-L04 (register_irq)"];
  m_A_L05 [label="A-L05 (register_irq)"];
  m_A_L06 [label="A-L06 (register_irq)"];
  m_A_L07 [label="A-L07 (unregister_irq)"];
  m_A_L08 [label="A-L08 (unregister_irq)"];
  m_A_L09 [label="A-L09 (hwint_irq_handler)"];
  m_A_R01 [label="A-R01 (install_result)"];
  m_A_R02 [label="A-R02 (enable_disable)"];
  m_A_R03 [label="A-R03 (stack_arg)"];
  m_A_R04 [label="A-R04 (borrowed_fields)"];
  m_A_R05 [label="A-R05 (handler_reentry)"];
  m_A_R06 [label="A-R06 (ack_argument)"];
  m_A_R07 [label="A-R07 (return_status)"];
