  m_ABC_01 [label="ABC-01 (register_to_route)"];
  m_ABC_02 [label="ABC-02 (gate_to_dispatch)"];
  m_ABC_03 [label="ABC-03 (timer_binding)"];
  m_ABC_04 [label="ABC-04 (ack_and_schedule)"];
  m_ABC_05 [label="ABC-05 (retained_history)"];
 }
 start_kernel -> init_IRQ [label="DIRECT_CALL: active start_kernel call",color=blue];
 init_IRQ -> idt_gates [label="DIRECT_CALL: IDT gate setup request",color=blue];
 init_IRQ -> bsp_intr [label="DIRECT_CALL: BSP init request",color=blue];
 bsp_intr -> ioapic_init [label="DIRECT_CALL: IOAPIC_init actual source body",color=blue];
 ioapic_init -> ioapic_map [label="DATA_WRITE_REQUEST: MMIO pointer assignments",color=darkorange,style=dotted];
 ioapic_init -> ioapic_rte_write [label="DIRECT_CALL: RTE loop writes 24 candidate entries",color=blue];
 ioapic_map -> no_hardware [label="UNPROVEN_JOIN: physical device and mapping unknown",color=red,style=dashed];
 start_kernel -> late_time_init [label="DIRECT_CALL: actual start_kernel call",color=blue];
 late_time_init -> hpet_time_init [label="DIRECT_CALL: time initialization",color=blue];
 hpet_time_init -> hpet_enable [label="DIRECT_CALL: return unconsumed",color=blue];
 hpet_time_init -> hpet_init [label="DIRECT_CALL: follows enable normal return",color=blue];
 hpet_enable -> no_success [label="PROOF_BOUNDARY: actual HPET status unknown",color=red,style=dashed];
 hpet_init -> hpet_entry [label="DATA_WRITE: selected local bitfield assignments",color=darkorange,style=dotted];
 hpet_init -> hpet_ctrl [label="DATA_BINDING: register_irq passes controller pointer",color=darkorange,style=dotted];
 hpet_init -> register_irq [label="DIRECT_CALL: HPET vector0x22 registration",color=blue];
 hpet_entry -> ioapic_install [label="INDIRECT_ARGUMENT_DATA: arg dereferenced only if callback invoked",color=darkorange,style=dotted];
 hpet_ctrl -> ioapic_install [label="CALLBACK_BINDING: controller.install",color=purple,style=dashed];
 hpet_ctrl -> ioapic_enable [label="CALLBACK_BINDING: controller.enable",color=purple,style=dashed];
 hpet_ctrl -> ioapic_disable [label="CALLBACK_BINDING: controller.disable",color=purple,style=dashed];
 hpet_ctrl -> ioapic_uninstall [label="CALLBACK_BINDING: controller.uninstall",color=purple,style=dashed];
 hpet_ctrl -> ioapic_edge_ack [label="CALLBACK_BINDING: controller.ack, param unused",color=purple,style=dashed];
 start_kernel -> percpu_intr [label="DIRECT_CALL: active later start_kernel call",color=blue];
 percpu_intr -> lvt_init [label="DIRECT_CALL: LVT_timer_init source",color=blue];
 lvt_init -> register_irq [label="DIRECT_CALL: LVT vector0xee registration",color=blue];
 lvt_init -> lvt_ack [label="DIRECT_CALL: one direct pre-event ack call",color=blue];
 lvt_init -> lvt_reg [label="DATA_WRITE: LVT vector and periodic bits",color=darkorange,style=dotted];
 lvt_init -> lvt_ctrl [label="DATA_BINDING: controller callback fields",color=darkorange,style=dotted];
 lvt_ctrl -> lvt_ack [label="CALLBACK_BINDING: ack present, other callbacks null",color=purple,style=dashed];
 register_irq -> descriptor_table [label="DATA_WRITE: fields saved in direct array",color=darkorange,style=dotted];
 unregister_irq -> descriptor_table [label="DATA_CLEAR: disable/uninstall then fields cleared",color=darkorange,style=dotted];
 register_irq -> hpet_ctrl [label="CONDITIONAL_CALLBACK: HPET instance",color=purple,style=dashed];
 register_irq -> lvt_ctrl [label="CONDITIONAL_CALLBACK: LVT instance",color=purple,style=dashed];
 register_irq -> ioapic_install [label="CONDITIONAL_CALLBACK: only if controller callback bound",color=purple,style=dashed];
 register_irq -> ioapic_enable [label="CONDITIONAL_CALLBACK: only if controller callback bound",color=purple,style=dashed];
 ioapic_install -> ioapic_rte_write [label="DIRECT_CALL: 64-bit value from arg",color=blue];
 ioapic_enable -> ioapic_rte_read [label="DIRECT_CALL: read-modify-write low-index",color=blue];
 ioapic_enable -> ioapic_rte_write [label="DIRECT_CALL: clear mask and write",color=blue];
 ioapic_disable -> ioapic_rte_read [label="DIRECT_CALL: read-modify-write low-index",color=blue];
 ioapic_disable -> ioapic_rte_write [label="DIRECT_CALL: set mask and write",color=blue];
 ioapic_uninstall -> ioapic_rte_write [label="DIRECT_CALL: write mask value",color=blue];
 ioapic_rte_read -> index_u8 [label="DATA_FLOW: high index then low index",color=darkorange,style=dotted];
 ioapic_rte_write -> index_u8 [label="DATA_FLOW: low index then high index",color=darkorange,style=dotted];
 ioapic_edge_ack -> apic_msr_write [label="DIRECT_CALL: APIC_EOI value0",color=blue];
 ioapic_level_ack -> ioapic_edge_ack [label="DIRECT_CALL: edge ack first",color=blue];
 ioapic_level_ack -> ioapic_map [label="DATA_WRITE_REQUEST: then EOI port receives irq_nr",color=darkorange,style=dotted];
 lvt_ack -> apic_msr_write [label="DIRECT_CALL: TMICT LVTT TDCR registers requested",color=blue];
 lvt_ack -> ioapic_edge_ack [label="DIRECT_CALL: parameter passed, ignored inside edge",color=blue];
 idt_gates -> idt_memory [label="DATA_WRITE_REQUEST: vector gates mapped to stubs",color=darkorange,style=dotted];
