digraph MYOS2_FS_CONTEXT_CWD_60 {
  graph [rankdir=LR,labelloc=t,label="60: source-level A cwd/root; B getcwd; C copy/share/exit (not complete CFG)"];
  node [shape=box];
  edge [fontsize=9];
  subgraph cluster_A {
    label="A path update and references";
    chdir [label="user chdir macro body"];
    userpath [label="user_path_at wrapper"];
    atempty [label="user_path_at_empty"];
    filename_lookup [label="filename_lookup"];
    lookupat [label="path_lookupat"];
    path_output [label="path_s output (data)"];
    pwdwrite [label="pwd = path direct"];
    init_chdir [label="init_chdir"];
    init_chroot [label="init_chroot"];
    setpwd [label="set_fs_pwd"];
    setroot [label="set_fs_root"];
    initfs [label="set_init_taskfs"];
    rootpwd [label="fs.root / fs.pwd (data)"];
    pathget [label="path_get"];
    dget [label="dget returns ptr"];
    pathput [label="path_put"];
    dput [label="dput no-op body"];
    old_cond [label="old.dentry check"];
    errno_chdir [label="lookup-error return"];
    badfs [label="invalid fs/path first access STOP",shape=octagon];
  }
  subgraph cluster_B {
    label="B reverse cwd and buffer";
    getcwd [label="getcwd macro body"];
    kzalloc [label="kzalloc(PATH_MAX)"];
    badalloc [label="NULL bufhead + PATH_MAX STOP",shape=octagon];
    prepend [label="myos_prepend"];
    prepath [label="myos_prepend_path"];
    realmount [label="real_mount"];
    walk [label="__prepend_path"];
    pname [label="prepend_name"];
    qstr [label="qstr len/name (data)"];
    parent [label="dentry parent / mount topology"];
    detached [label="return 2 detached"];
    escaped [label="return 3 escaped"];
    pbuf [label="prpndbuf int len + cursor"];
    unreachable [label="unreachable prefix request"];
    countlen [label="unsigned length calculation"];
    len_gate [label="PATH_MAX / size tests"];
    usercopy [label="copy_to_user"];
    inlineraw [label="inline raw copy wrapper"];
    castret [label="(long)buf → int error"];
    kfree [label="kfree(bufhead)"];
    underflow [label="buffer/string/arith invalid STOP",shape=octagon];
  }
  subgraph cluster_C {
    label="C taskfs share/copy/exit";
    copyprocess [label="copy_process"];
    dup [label="dup_task_struct"];
    shallow [label="*tsk = *orig data"];
    copyfs [label="copy_fs"];
    clonegate [label="CLONE_FS bit gate"];
    inexec [label="fs.in_exec check"];
    usersinc [label="fs.users++"];
    fsclone [label="copy_fs_struct"];
    kalloc [label="kmem_cache_alloc(fs_cachep)"];
    oldlock [label="old fs lock"];
    pathcopy [label="root/pwd shallow copy"];
    newfs [label="new taskfs users=1"];
    allocerror [label="new alloc NULL / -ENOMEM"];
    cleanupfiles [label="bad_fork_cleanup_files"];
    cleanupfs [label="bad_fork_cleanup_fs"];
    doexit [label="do_exit"];
    exitfs [label="exit_fs"];
    nulltsk [label="tsk.fs = NULL"];
    usersdec [label="kill = !--users"];
    freefs [label="free_fs_struct"];
    cachefree [label="kmem_cache_free"];
    init_task [label="init_task.fs"];
    init_static [label="static init_fs"];
    CLONEFILES [label="CLONE_FILES separate fd table"];
    badold [label="invalid old fs/int overflow STOP",shape=octagon];
  }
  chdir -> userpath [label="CALL"];
  userpath -> atempty [label="CALL"];
  atempty -> filename_lookup [label="CALL"];
