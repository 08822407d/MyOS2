  kalloc -> allocerror [label="LOCAL_CONTROL"];
  fsclone -> oldlock [label="LOCAL_CONTROL"];
  oldlock -> pathcopy [label="LOCAL_CONTROL"];
  fsclone -> pathget [label="CALL"];
  pathcopy -> newfs [label="DATA"];
  newfs -> copyfs [label="RETURN"];
  fsclone -> copyfs [label="RETURN"];
  copyprocess -> cleanupfiles [label="LOCAL_CONTROL"];
