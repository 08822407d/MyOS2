  setpwd -> old_cond [label="LOCAL_CONTROL"];
  setroot -> old_cond [label="LOCAL_CONTROL"];
  old_cond -> pathput [label="LOCAL_CONTROL"];
  setpwd -> pathput [label="CALL"];
  setroot -> pathput [label="CALL"];
