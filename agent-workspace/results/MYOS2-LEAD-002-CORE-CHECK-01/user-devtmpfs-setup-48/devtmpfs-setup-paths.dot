digraph DS48 {
  rankdir=LR;
  graph [label="DS48: two execution contexts and separate creation/status/completion channels; source branches vs analytic conditions", labelloc=t];
  node [fontname="sans",shape=box];
  subgraph cluster_creator {
    label="Creator: devtmpfs_init and kthread_run macro";
    C0 [label="devtmpfs_init: caller context",shape=box,style=solid];
    C1 [label="opts and local caller.err; INIT_LIST_HEADER_S",shape=box,style=solid];
    C2 [label="mnt = vfs_kern_mount(...); opaque",shape=box,style=solid];
    C3 [label="SOURCE IS_ERR(mnt)?",shape=diamond,style=solid];
    C4 [label="mount error: return PTR_ERR(mnt)",shape=box,style=solid];
    C5 [label="caller.err = register_filesystem(dev_fs_type)",shape=box,style=solid];
    C6 [label="SOURCE if(caller.err)",shape=diamond,style=solid];
    C7 [label="registration error: return caller.err",shape=box,style=solid];
    C8 [label="thread = kthread_run(devtmpfsd, &caller.err, name)",shape=box,style=solid];
    C9 [label="SOURCE if(!IS_ERR(thread))",shape=diamond,style=solid];
    C10 [label="wait_for_completion(&setup_done) CALL (void)",shape=box,style=solid];
    C11 [label="creator else: caller.err=PTR_ERR(thread); thread=NULL",shape=box,style=solid];
    C12 [label="SOURCE while(caller.err); empty body",shape=diamond,style=solid];
    C13 [label="SOURCE after loop: if(caller.err)",shape=diamond,style=solid];
    C14 [label="unregister_filesystem; return caller.err if normal",shape=box,style=solid];
    C15 [label="pr_info and return0 if normal",shape=box,style=solid];
    C16 [label="ANALYTIC stable nonzero err loops here; no normal progress",shape=box,style=dashed];
    C17 [label="ANALYTIC valid thread required; !IS_ERR alone not enough",shape=box,style=dashed];
    M0 [label="kthread_run macro: kthread_create(threadfn,data,name)",shape=box,style=solid];
    M1 [label="kthread_create macro forwards to _on_node with NUMA_NO_NODE",shape=box,style=solid];
    M2 [label="__k = result of creation (task* or ERR_PTR)",shape=box,style=solid];
    M3 [label="SOURCE !IS_ERR(__k)?",shape=diamond,style=solid];
    M4 [label="wake_up_process(__k) actual call",shape=box,style=solid];
    M5 [label="macro yields __k; creator gets task* result",shape=box,style=solid];
  }
  subgraph cluster_worker {
    label="Worker: devtmpfsd and work_loop";
    W0 [label="devtmpfsd(void *p): independent worker context",shape=box,style=solid];
    W1 [label="worker local int err=0 (NOT caller.err)",shape=box,style=solid];
    W2 [label="worker.err=init_mount(devtmpfs,/,...)",shape=box,style=solid];
    W3 [label="SOURCE if(worker.err)",shape=diamond,style=solid];
    W4 [label="goto out: return worker.err; NO setup_done post",shape=box,style=solid];
    W5 [label="init_chdir(/..) return ignored",shape=box,style=solid];
    W6 [label="init_chroot(.) return ignored",shape=box,style=solid];
    W7 [label="complete(&setup_done) actual notification call",shape=box,style=solid];
    W8 [label="devtmpfs_work_loop()",shape=box,style=solid];
    W9 [label="while(1) in work_loop, no active normal exit",shape=diamond,style=solid];
    W10 [label="out: return worker.err only if reached",shape=box,style=solid];
    W11 [label="ANALYTIC nonreturn from any worker call stops later events",shape=octagon,style=solid];
    W12 [label="worker p is not accessed by active devtmpfsd body",shape=box,style=dashed];
  }
  subgraph cluster_handoff {
    label="Completion state and separate request object";
    H0 [label="setup_done: static DECLARE_COMPLETION; done literal0 macro",shape=box,style=solid];
    H1 [label="completion_s has uint done plus swqueue_hdr wait",shape=box,style=solid];
    H2 [label="complete directly increments done (unless UINT_MAX), swake request",shape=box,style=solid];
    H3 [label="wait_for_completion returns void; no errno",shape=box,style=solid];
    H4 [label="ANALYTIC: notifier + scheduler semantics not proved",shape=box,style=dashed];
    H5 [label="ANALYTIC no other notifier, initial done0",shape=box,style=dashed];
    Q0 [label="req.done separate completion_s; req.err separate int",shape=box,style=dashed];
    Q1 [label="req submit waits on req.done, returns req.err",shape=box,style=dashed];
    Q2 [label="work loop handles req, completes req.done not setup_done",shape=box,style=dashed];
  }
  subgraph cluster_limits {
    label="Analytical channel and validity notes";
    T0 [label="ERROR CHANNEL: caller.err &p vs worker local err distinct",shape=box,style=dashed];
    T1 [label="creation return task* != worker return int",shape=box,style=dashed];
    T2 [label="completion signal event != worker status payload",shape=box,style=dashed];
    T3 [label="IS_ERR false is not live or nonNULL validation",shape=box,style=dashed];
  }
  C0 -> C1 [label="SOURCE: source",style=solid];
  C1 -> C2 [label="SOURCE: source",style=solid];
  C2 -> C3 [label="RETURN matched: mount callee normal",style=solid];
  C3 -> C4 [label="SOURCE: IS_ERR true",style=solid];
  C3 -> C5 [label="SOURCE: IS_ERR false; valid mnt is ANALYTIC premise",style=solid];
  C5 -> C6 [label="RETURN matched: registration returned int",style=solid];
  C6 -> C7 [label="SOURCE: err nonzero",style=solid];
  C6 -> C8 [label="SOURCE: err zero",style=solid];
  C8 -> M0 [label="CALL: evaluate kthread_run macro; &caller.err passed",style=solid];
  M0 -> M1 [label="SOURCE: source",style=solid];
  M1 -> M2 [label="RETURN matched: opaque create returned",style=solid];
  M2 -> M3 [label="SOURCE: source",style=solid];
  M3 -> M4 [label="SOURCE: nonERR task returned",style=solid];
  M3 -> M5 [label="SOURCE: IS_ERR result, skip wake",style=solid];
  M4 -> M5 [label="RETURN matched: wake call normal",style=solid];
  M5 -> C9 [label="RETURN matched: creation result task pointer or ERR_PTR",style=solid];
  C9 -> C10 [label="SOURCE: !IS_ERR true",style=solid];
  C9 -> C11 [label="SOURCE: IS_ERR true",style=solid];
  C11 -> C12 [label="SOURCE: thread NULL assigned",style=solid];
  C10 -> H3 [label="CALL: wait_for_completion selected direct function",style=solid];
  H3 -> C12 [label="RETURN matched: only if wait returns normally",style=solid];
  C12 -> C12 [label="SOURCE: while(err) true, body empty",style=solid];
  C12 -> C13 [label="SOURCE: while(err) false",style=solid];
  C13 -> C14 [label="SOURCE: if(err) true only after previous loop normally exited",style=solid];
  C13 -> C15 [label="SOURCE: if(err) false",style=solid];
  C16 -> C12 [label="ANALYTIC: stable nonzero err prevents normal source exit",style=dashed];
  C17 -> C10 [label="ANALYTIC: must be live task for wait-notification interpretation",style=dashed];
  M4 -> W0 [label="POSSIBLE CROSS-CONTEXT: possible scheduling of selected threadfn, NOT synchronous call",style=dashed];
  W0 -> W1 [label="SOURCE: source",style=solid];
  W1 -> W2 [label="SOURCE: source",style=solid];
  W2 -> W3 [label="RETURN matched: worker init_mount normal",style=solid];
  W3 -> W4 [label="GOTO: worker.err nonzero, bypass setup_done",style=solid];
  W3 -> W5 [label="SOURCE: worker.err zero",style=solid];
  W5 -> W6 [label="RETURN matched: init_chdir returned ANY int",style=solid];
  W5 -> W11 [label="ANALYTIC: callee nonreturn",style=dashed];
  W6 -> W7 [label="RETURN matched: init_chroot returned ANY int",style=solid];
  W6 -> W11 [label="ANALYTIC: callee nonreturn",style=dashed];
  W7 -> H2 [label="CALL: complete(&setup_done) event request",style=solid];
  H2 -> W8 [label="RETURN matched: only if complete call normal",style=solid];
  W8 -> W9 [label="CALL: workloop enters loop",style=solid];
  W9 -> W9 [label="SOURCE: outer while(1), no return/break in selected body",style=solid];
  W8 -> W10 [label="ANALYTIC: counterfactual normal return: NOT source-proved",style=dashed];
  H0 -> H1 [label="DATA: struct and macro initialization",style=solid];
  H0 -> C10 [label="DATA: same setup_done object",style=solid];
  H0 -> W7 [label="DATA: same setup_done object",style=solid];
  H2 -> H3 [label="POSSIBLE CROSS-CONTEXT: notification may satisfy waiting, no status payload",style=dashed];
  H4 -> H2 [label="ANALYTIC: not guaranteed notifier completes wake",style=dashed];
  H4 -> H3 [label="ANALYTIC: not guaranteed wait returns",style=dashed];
  H5 -> C10 [label="ANALYTIC: worker failure can leave unmatched wait",style=dashed];
  W4 -> H5 [label="ANALYTIC: no selected worker setup_done complete on early error",style=dashed];
  T0 -> C8 [label="NOTE: caller &err passed to macro",style=dashed];
  T0 -> W12 [label="NOTE: no active p dereference/write in worker",style=dashed];
  T0 -> W1 [label="NOTE: new independent err",style=dashed];
  T1 -> M5 [label="NOTE: creation result is pointer",style=dashed];
  T1 -> W4 [label="NOTE: worker returns int",style=dashed];
  T2 -> H2 [label="NOTE: completion object, not worker err",style=dashed];
  T2 -> H3 [label="NOTE: void wait returns no error int",style=dashed];
  T3 -> C9 [label="NOTE: IS_ERR only encoded error range",style=dashed];
  Q0 -> Q1 [label="NOTE: request completion separate",style=dashed];
  Q0 -> Q2 [label="NOTE: request err/data separate",style=dashed];
}
