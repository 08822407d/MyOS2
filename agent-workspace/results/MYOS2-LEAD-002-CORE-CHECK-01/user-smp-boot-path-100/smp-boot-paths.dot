 asm64 -> asm_l1 [label="SOURCE_ORDER_ONLY: sets r8 and rbx",color=gray,style=dotted];
 apic_map -> asm_l1 [label="DATA_READ_REQUEST: indexed u64 values",color=purple,style=dashed];
 asm_l1 -> asm_debug [label="CONDITIONAL_BRANCH: only if compare succeeds",color=gray,style=dotted];
