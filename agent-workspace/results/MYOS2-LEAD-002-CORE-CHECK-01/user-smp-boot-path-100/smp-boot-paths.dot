  row_C_X04 [label="C-X04: BSP_comment"];
  row_C_X05 [label="C-X05: stack"];
  row_C_X06 [label="C-X06: thread_size"];
  row_C_X07 [label="C-X07: exit"];
  row_C_X08 [label="C-X08: data"];
  row_ABC_01 [label="ABC-01: topo_join"];
  row_ABC_02 [label="ABC-02: percpu_join"];
  row_ABC_03 [label="ABC-03: bsp_join"];
  row_ABC_04 [label="ABC-04: ap_join"];
  row_ABC_05 [label="ABC-05: online_join"];
 }
 uefi_main -> loader_cpu [label="DIRECT_CALL: UefiMain calls fill_cputopo_info after prior producers",color=blue,style=solid];
 loader_cpu -> efi_mp [label="INDIRECT_CALL_REQUEST: MP protocol queries, return unverified",color=purple,style=dashed];
 efi_mp -> mbi_tag [label="DATA_CANDIDATE: CPU counts and info input is unobserved",color=gray,style=dotted];
 loader_cpu -> mbi_tag [label="DATA_WRITE_REQUEST: core_num, availability and descriptors",color=purple,style=dashed];
 mbi_tag -> parse_tag [label="DATA_HANDOFF_NOT_DIRECT_CALL: firmware tag may become kernel readable MBI",color=gray,style=dotted];
 kernel_start -> early_mbi [label="DIRECT_CALL: x86_64_start_kernel calls myos_early_init_system",color=blue,style=solid];
 early_mbi -> parse_tag [label="DIRECT_CALL: myos_early_init_system calls parse_tag",color=blue,style=solid];
 parse_tag -> get_smpinfo [label="DIRECT_CALL: CPU_TOPO switch calls get_smpinfo",color=blue,style=solid];
 get_smpinfo -> nr_cpu_ids [label="DATA_WRITE: only core_num copied",color=gray,style=dotted];
 nr_cpu_ids -> for_each_cpu [label="DATA_CONSUMPTION: dense loop bound",color=gray,style=dotted];
 for_each_cpu -> setup_percpu [label="CALLER_MACRO: setup_per_cpu_areas uses dense iteration",color=gray,style=dotted];
 setup_percpu -> apic_map [label="NOT_CONNECTED: no shown producer filling this map",color=gray,style=dotted];
 kernel_start -> start_kernel [label="DIRECT_CALL: call after early parser",color=blue,style=solid];
 start_kernel -> setup_arch [label="DIRECT_CALL: BSP architecture setup",color=blue,style=solid];
 start_kernel -> setup_percpu [label="DIRECT_CALL: BSP perCPU area setup",color=blue,style=solid];
 start_kernel -> intr_init [label="DIRECT_CALL: late BSP source request",color=blue,style=solid];
 setup_arch -> bsp_x2apic [label="DIRECT_CALL: conditional x2APIC setup",color=blue,style=solid];
 setup_arch -> check_x2apic [label="DIRECT_CALL: check follows try",color=blue,style=solid];
 bsp_x2apic -> hardware_stop [label="HARDWARE_PROOF_BOUNDARY: MSR return and mode not measured",color=red,style=dashed];
 intr_init -> hardware_stop [label="HARDWARE_PROOF_BOUNDARY: LVT timer request is not AP complete",color=red,style=dashed];
 ap_copy -> memcpy_req [label="DIRECT_CALL_REQUEST: copy APboot source bytes",color=purple,style=dashed];
 ap_copy -> cr3_data [label="DATA_WRITE_REQUEST: cr3_paddr set from kernel_cr3",color=purple,style=dashed];
 ap_send -> msr_req [label="WRMSR_REQUEST: two calls with source constants",color=purple,style=dashed];
 msr_req -> hardware_stop [label="HARDWARE_PROOF_BOUNDARY: no IPI/AP online acknowledgment",color=red,style=dashed];
 start_kernel -> run_stop [label="SCOPED_CALL_GAP: selected start body has no call to ap_copy/send",color=gray,style=dotted];
 run_stop -> ap_copy [label="UNPROVEN_JOIN_NOT_CALL: independent function exists without reviewed active caller",color=red,style=dashed];
 run_stop -> ap_send [label="UNPROVEN_JOIN_NOT_CALL: independent function exists without reviewed active caller",color=red,style=dashed];
 cmake -> linker [label="DECLARED_DEPENDENCY: target link options name kernel.lds",color=gray,style=dotted];
 linker -> memcpy_req [label="LINK_DATA_DEPENDENCY: named APboot physical symbol and source section",color=gray,style=dotted];
 linker -> asm16 [label="LINK_MAPPING_UNPROVEN: input section actual layout not measured",color=red,style=dashed];
 memcpy_req -> asm16 [label="COPY_EFFECT_UNVERIFIED: no real physical bytes or AP execution",color=gray,style=dotted];
 asm16 -> asm32 [label="SOURCE_ORDER_ONLY: far jump in assembly text not actual CPU switch",color=gray,style=dotted];
 asm32 -> cr3_data [label="ASM_READ_REQUEST: load cr3_paddr address/value",color=purple,style=dashed];
 asm32 -> asm64 [label="SOURCE_ORDER_ONLY: long mode request and far jump",color=gray,style=dotted];
 asm64 -> cr3_data [label="ASM_READ_REQUEST: uses kernel_cr3 symbol",color=purple,style=dashed];
