// Fixed time@a039d9803ade; STATIC SOURCE/DECLARATION graph only. Graphviz NOT_RUN.
// DIRECT_CALL is a literal C call; DATA_HANDOFF / SOURCE_ORDER / UNPROVEN_JOIN are NOT runtime calls.
digraph SP100 {
 graph [rankdir=LR, labelloc=t, label="SP100 CPU topology / BSP / AP bootstrap (bounded source evidence)"];
 node [fontsize=9,shape=box]; edge [fontsize=8];
 subgraph cluster_owners {label="real source owners / data";
  uefi_main [label="UefiMain source producer call owner",shape=box];
  loader_cpu [label="fill_cputopo_info CPU tag writer",shape=box];
  efi_mp [label="external MP Services protocol interface (result unproven)",shape=box];
  mbi_tag [label="CPU_TOPO shared tag bytes (real extent unproven)",shape=box];
  parse_tag [label="parse_tag kernel tag walker",shape=box];
  get_smpinfo [label="get_smpinfo core_num -> nr_cpu_ids",shape=box];
  nr_cpu_ids [label="unsigned nr_cpu_ids data object",shape=box];
  for_each_cpu [label="for_each_cpu dense int macro",shape=box];
  setup_percpu [label="setup_per_cpu_areas C function",shape=box];
  apic_map [label="apicid_to_cpunr fixed u64 array initially -1",shape=box];
  kernel_start [label="x86_64_start_kernel function",shape=box];
  early_mbi [label="myos_early_init_system function",shape=box];
  start_kernel [label="start_kernel function",shape=box];
  setup_arch [label="setup_arch function",shape=box];
  bsp_x2apic [label="myos_try_enable_x2apic function",shape=box];
  check_x2apic [label="check_x2apic function",shape=box];
  intr_init [label="myos_init_percpu_intr function",shape=box];
  ap_copy [label="myos_early_init_smp independent defined function",shape=box];
  ap_send [label="myos_startup_smp independent defined function",shape=box];
  memcpy_req [label="memcpy request destination low APboot address",shape=box];
  msr_req [label="wrmsrl pair request, result not observed",shape=box];
  cr3_data [label="kernel_cr3/cr3_paddr data symbols",shape=box];
  asm16 [label="_APboot_start 16-bit ASM text",shape=box];
  asm32 [label="_AP_code32 ASM text",shape=box];
  asm64 [label="_AP_code64 ASM text",shape=box];
  asm_l1 [label="l1 indexed compare, starts slot1",shape=box];
  asm_debug [label="AP_DEBUG map-to-rsp and jmp dot",shape=box];
  linker [label="kernel.lds AP and entry textual declarations",shape=box];
  cmake [label="kernel CMake GLOB/target_sources textual declarations",shape=box];
  source_stop [label="STOP: source object or type invalid",shape=octagon];
  run_stop [label="STOP: actual call/reachability not shown",shape=octagon];
  hardware_stop [label="STOP: no real AP started/onlined evidence",shape=octagon];
 }
 subgraph cluster_matrix {label="bounded matrix ids, not functions";
  row_A_T01 [label="A-T01: loader_cpu"];
  row_A_T02 [label="A-T02: loader_cpu"];
  row_A_T03 [label="A-T03: cpu_tag"];
  row_A_T04 [label="A-T04: efi_phase"];
