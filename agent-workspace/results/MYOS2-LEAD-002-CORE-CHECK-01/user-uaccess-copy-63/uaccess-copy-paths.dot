digraph MYOS2_UACCESS_COPY_63 {
  graph [rankdir=LR,labelloc=t,label="63 bounded source relations; macro/include and asm candidate edges are NOT runtime CALLs"];
  node [shape=box];
  edge [fontsize=9];
  subgraph cluster_A {
    label="A source definition and address predicate";
    hinc [label="asm header include order"];
    xfunc [label="x86 __access_ok inline"];
    xmacro [label="object macro __access_ok"];
    ginclude [label="generic access_ok include"];
    guard [label="generic #ifndef __access_ok"];
    fallback [label="guarded generic fallback"];
    wrapper [label="generic access_ok wrapper"];
    consttest [label="builtin constant_p gate"];
    shortpath [label="small const: start sign only"];
    general [label="general: sum and bounds"];
    pagesize [label="PAGE_SIZE 4096"];
    tasklimit [label="TASK_SIZE_MAX threshold"];
    addr [label="numeric pointer as ulong"];
    sum [label="(ptr+size) modulo ulong"];
    numericresult [label="bool numeric result"];
    notmapped [label="mapping/perms NOT CERTIFIED"];
  }
  subgraph cluster_B {
    label="B bulk copy and residual";
    publicfrom [label="copy_from_user"];
    inlinefrom [label="_inline_copy_from_user"];
    rawfrom [label="raw_copy_from_user"];
    publicto [label="copy_to_user"];
    inlineto [label="_inline_copy_to_user"];
    rawto [label="raw_copy_to_user"];
    toaccess [label="access_ok(to,n) gate"];
    skiptocopy [label="to direction: return original n"];
    rawgeneric [label="copy_user_generic"];
    stac [label="stac request"];
    alternative [label="ALTERNATIVE asm selection text"];
    asmrep [label="rep movsb candidate"];
    asmcall [label="call rep_movs_alternative candidate"];
    extable [label="_ASM_EXTABLE_UA annotation"];
    clac [label="clac request"];
    residual [label="returned len/residual"];
    frompadding [label="memset trailing un-copied residual"];
    invalidres [label="res>n/invalid buffer STOP",shape=octagon];
    alternbody [label="rep_movs body not located"];
    copyinvalid [label="bad pointer/raw fault STOP",shape=octagon];
  }
  subgraph cluster_C {
    label="C scalar macros and 2 consumers";
    getmacro [label="get_user direct load macro"];
    putmacro [label="put_user direct store macro"];
    enoerr [label="-ENOERR=0 on normal eval"];
    rt [label="rt_sigreturn"];
    frame [label="frame from regs->sp"];
    frameguard [label="access_ok frame condition"];
    sigload [label="two get_user field reads"];
    badframe [label="goto badframe / return0"];
    restore [label="restore_sigcontext"];
    restorefrom [label="restore uses copy_from_user"];
    userret [label="return regs->ax conditional"];
    filldir [label="filldir64"];
    fields [label="direct d_off,ino,reclen,type stores"];
    copyname [label="copy_to_user name"];
    copyres [label="cplen retained but unused"];
    nul [label="direct trailing NUL"];
    advance [label="prev_reclen/current_dir/count update"];
    directbad [label="invalid scalar/direct memory STOP",shape=octagon];
    getdents [label="getdents64"];
    putcomment [label="last put_user is commented"];
  }
  hinc -> xfunc [label="DATA"];
  xfunc -> xmacro [label="DATA"];
  hinc -> ginclude [label="DATA"];
  ginclude -> guard [label="DATA"];
  xmacro -> guard [label="LOCAL_CONTROL"];
  guard -> fallback [label="LOCAL_CONTROL"];
  ginclude -> wrapper [label="DATA"];
  wrapper -> xfunc [label="DATA"];
  xfunc -> consttest [label="LOCAL_CONTROL"];
  pagesize -> consttest [label="DATA"];
  addr -> shortpath [label="DATA"];
  consttest -> shortpath [label="LOCAL_CONTROL"];
  consttest -> general [label="LOCAL_CONTROL"];
  addr -> sum [label="DATA"];
  sum -> general [label="DATA"];
  general -> numericresult [label="DATA"];
  shortpath -> numericresult [label="DATA"];
  tasklimit -> fallback [label="DATA"];
  numericresult -> notmapped [label="ANALYSIS_STOP"];
  publicfrom -> inlinefrom [label="CALL"];
  inlinefrom -> rawfrom [label="CALL"];
  publicto -> inlineto [label="CALL"];
  inlineto -> toaccess [label="LOCAL_CONTROL"];
  toaccess -> skiptocopy [label="LOCAL_CONTROL"];
  inlineto -> rawto [label="CALL"];
  rawfrom -> rawgeneric [label="CALL"];
  rawto -> rawgeneric [label="CALL"];
  rawgeneric -> stac [label="CALL"];
  rawgeneric -> alternative [label="DATA"];
  alternative -> asmrep [label="DATA"];
  alternative -> asmcall [label="DATA"];
  asmcall -> alternbody [label="ANALYSIS_STOP"];
  alternative -> extable [label="DATA"];
  rawgeneric -> clac [label="CALL"];
  rawgeneric -> residual [label="RETURN"];
  residual -> inlinefrom [label="DATA"];
  residual -> inlineto [label="DATA"];
  inlinefrom -> frompadding [label="LOCAL_CONTROL"];
  residual -> frompadding [label="DATA"];
  residual -> invalidres [label="ANALYSIS_STOP"];
  publicfrom -> copyinvalid [label="ANALYSIS_STOP"];
  publicto -> copyinvalid [label="ANALYSIS_STOP"];
  rt -> frame [label="DATA"];
  rt -> frameguard [label="LOCAL_CONTROL"];
  frameguard -> wrapper [label="DATA"];
  frameguard -> badframe [label="LOCAL_CONTROL"];
  rt -> sigload [label="LOCAL_CONTROL"];
  sigload -> getmacro [label="DATA"];
  getmacro -> enoerr [label="DATA"];
  putmacro -> enoerr [label="DATA"];
  sigload -> directbad [label="ANALYSIS_STOP"];
  rt -> restore [label="CALL"];
  restore -> restorefrom [label="CALL"];
  restorefrom -> publicfrom [label="CALL"];
  restore -> userret [label="RETURN"];
  rt -> userret [label="LOCAL_CONTROL"];
  filldir -> fields [label="LOCAL_CONTROL"];
  fields -> directbad [label="ANALYSIS_STOP"];
  filldir -> copyname [label="CALL"];
  copyname -> publicto [label="CALL"];
  publicto -> copyres [label="DATA"];
  copyres -> nul [label="LOCAL_CONTROL"];
  nul -> advance [label="LOCAL_CONTROL"];
  getdents -> putcomment [label="DATA"];
}
