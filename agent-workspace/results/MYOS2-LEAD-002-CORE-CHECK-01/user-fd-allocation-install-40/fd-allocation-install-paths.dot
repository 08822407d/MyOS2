digraph FD40 {
  graph [label="CORE-USER-FD-ALLOCATION-INSTALL-40 | fixed time, source calls vs assumptions",rankdir=LR,labelloc=t];
  node [shape=box,fontsize=9];
  openat [label="do_sys_openat2 starts"];
  build [label="fd=build_open_flags(how,&op) result unguarded"];
  name [label="getname(filename)"];
  nameerr [label="IS_ERR(tmp)?",shape=diamond];
  retname [label="early return PTR_ERR(tmp)"];
  select [label="fd=get_unused_fd_flags(how.flags)"];
  get_unused [label="get_unused_fd_flags(uint flags)"];
  currentfiles [label="files=current->files, shared FILES object"];
  fdcount [label="files.fd_count (unsigned long) converted to uint end"];
  alloc [label="alloc_fd(uint start,uint end,uint flags)"];
  args [label="start=0, end=fd_count, flags forwarded not read"];
  lock [label="spin_lock(file_lock)"];
  loop [label="for int i=start; i<end; ++i",shape=diamond];
  readslot [label="read fd_array[i] (requires 0<=i<256)"];
  empty [label="fd_array[i]==NULL?",shape=diamond];
  assign [label="fd=i local assignment"];
  break [label="break first match"];
  step [label="i++ and recheck i<end"];
  unlock [label="spin_unlock(file_lock)"];
  fdret [label="return local uint fd as int"];
  uninit [label="STOP if no assignment: indeterminate fd read",shape=octagon];
  bounds [label="PREMISE fd_count/end<=256 and i valid, no active size check",shape=note];
  noreserve [label="SCAN DOES NOT WRITE SLOT or bitmap",shape=note];
  flags [label="flags argument UNUSED in alloc_fd body",shape=note];
  sysgate [label="if fd>=0?",shape=diamond];
  sysopen [label="do_filp_open(dfd,tmp,&op)"];
  filp [label="file_s* f returned; UV04 validity premise"];
  iserr [label="IS_ERR(f)?",shape=diamond];
  seterr [label="fd=PTR_ERR(f), overwrites selected fd"];
  install [label="fd_install(fd,f)"];
  files2 [label="files=current->files; fps=files.fd_array"];
  rmb [label="smp_rmb() call"];
  checkslot [label="BUG_ON(fps[fd] != NULL)"];
  occupied [label="fps[fd] nonNULL?",shape=diamond];
  bugmacro [label="BUG_ON conditional code may invoke BUG"];
  store [label="fps[fd]=file"];
  installed [label="file pointer stored if all guards/objects valid"];
  refnone [label="fd_install has no local get_file or fput",shape=note];
  idxprem [label="PREMISE fd<256 prior to fps[fd] access",shape=note];
  notlock [label="fd_install has NO selected file_lock acquire",shape=note];
  putname [label="putname(tmp)"];
  sysret [label="return fd (whether index or overwritten error)"];
  fdneg [label="fd<0 branch: skip open, return after putname"];
  put_unused [label="put_unused_fd(fd) separate entry, NOT called by openat"];
  putlock [label="spin_lock(file_lock)"];
  putunlock [label="spin_unlock(file_lock), no bitmap/slot write"];
  initfiles [label="init_files static fd_count=0 (not every task.files)",shape=note];
  dup [label="dup_fd sets newf.fd_count=256, only selected copies",shape=note];
  dupfd [label="f_dupfd independent caller can call alloc_fd"];
  two [label="ANALYSIS only: two scans before either install see same NULL",shape=note];
  earlier [label="Earlier OF30 and UV04 incomplete producer limits",shape=note];
  invalid [label="STOP at invalid indexed read, unsupported return, or nonreturn",shape=octagon];
  returntype [label="IS_ERR(NULL) is false but valid file is extra premise",shape=note];
  openat -> build [label="actual call"];
  build -> name [label="validation error ignored"];
  name -> nameerr [label="after getname result"];
  nameerr -> retname [label="true"];
  nameerr -> select [label="false"];
  select -> get_unused [label="actual callee"];
  get_unused -> currentfiles [label="current object"];
  currentfiles -> fdcount [label="read length"];
  fdcount -> args [label="type converted"];
  args -> alloc [label="call"];
  alloc -> lock [label="actual first step"];
  lock -> loop [label="scan begins"];
  loop -> readslot [label="i<end"];
  loop -> unlock [label="i>=end, no match"];
  readslot -> empty [label="slot value"];
  empty -> assign [label="true, first NULL"];
  empty -> step [label="false, occupied"];
  assign -> break [label="found"];
  break -> unlock [label="break exits"];
  step -> loop [label="next i"];
  unlock -> fdret [label="return local"];
  fdret -> uninit [label="no match, fd indeterminate"];
  fdret -> noreserve [label="no shared state changed by scan"];
  fdret -> sysgate [label="sys consumer only when defined",style=dashed];
  sysgate -> sysopen [label="true"];
  sysgate -> fdneg [label="false"];
  fdneg -> putname [label="no do_filp_open"];
  sysopen -> filp [label="result producer"];
  filp -> iserr [label="outer gate"];
  iserr -> seterr [label="true encoded error"];
  iserr -> install [label="false (needs valid normal file)"];
  seterr -> putname [label="skip install"];
  install -> files2 [label="actual function"];
  files2 -> rmb [label="read barrier"];
  rmb -> checkslot [label="index read after barrier"];
  checkslot -> occupied [label="check indexed value"];
  occupied -> bugmacro [label="nonNULL true"];
  occupied -> store [label="NULL false, macro returns"];
  store -> installed [label="slot pointer published"];
  installed -> putname [label="call returns"];
  putname -> sysret [label="after filename cleanup"];
  noreserve -> two [label="two scans before store may select same index"];
  two -> occupied [label="second install sees occupied after first (conditional)",style=dashed];
  currentfiles -> initfiles [label="identity not established (data premise)",style=dashed];
  currentfiles -> dup [label="other possible files object producer (data)",style=dashed];
  dupfd -> alloc [label="separate caller f_dupfd (not syscall)",style=dashed];
  get_unused -> flags [label="formal ignored"];
  put_unused -> putlock [label="actual"];
  putlock -> putunlock [label="no clear operation"];
  earlier -> filp [label="UV04 file return not proven",style=dashed];
  earlier -> build [label="OF30 validation error ignored"];
  idxprem -> invalid [label="failed index guard, not active code",style=dashed];
  bounds -> invalid [label="scan i outside array, not active gate"];
  readslot -> invalid [label="if i invalid (analysis stop)",style=dashed];
  checkslot -> invalid [label="if fd invalid (analysis stop)",style=dashed];
  fdret -> invalid [label="when uninitialized local (analysis stop)",style=dashed];
  bugmacro -> invalid [label="macro consequence needs actual binding"];
  returntype -> install [label="valid file pointer separately required",style=dashed];
  refnone -> installed [label="metadata: not refcount call",style=dashed];
  notlock -> installed [label="metadata: no lock acquired",style=dashed];
  initfiles -> fdcount [label="only if current.files points to init_files (analysis)",style=dashed];
  dup -> fdcount [label="other instance, not actual call"];
}
