// RH54 object/return/callback abstract graph. Source-only; not a kernel control-flow graph.
digraph RH54 {
 graph [rankdir=LR,label="Request handoff 54: A device, B IDE, C NVMe/XHCI"];
 node [shape=box,fontsize=10];
 A0 [label="device_add valid input"];
 Ap [label="parent->kobj early gate"];
 Ax [label="STOP invalid parent"];
 Am [label="MAJOR(devt)"];
 Ac [label="devtmpfs_create_node int unused"];
 Ar [label="device_add returns -EINVAL"];
 Ao [label="myos_device_create retval/ERR_PTR"];
 Ad [label="device_del commented delete"];
 Bq [label="IDE queue header"];
 Ba [label="daemon req_in_using=node"];
 Bc [label="IDE_cmd_out return ignored"];
 Bi [label="IRQ reads active node"];
 Bx [label="STOP invalid node"];
 Bh [label="end_handler count/log"];
 Bg [label="node.count==0?"];
 Bn [label="end_request complete"];
 Bclear [label="clear req_in_using after complete"];
 Bw [label="caller wait done"];
 Br [label="free and return0"];
 Bnext [label="next queued request possible"];
 Nq [label="NVMe queue and submit SQ"];
 Ni [label="NVMe IO irq"];
 Nack [label="ack CQ no software count"];
 Nend [label="NVMe_end_request"];
 Nret [label="NVMe caller return0"];
 Nx [label="STOP status/CID unknown"];
 Xq [label="XHCI queue and cmd"];
 Xwhile [label="slot/ctx while"];
 Xd [label="TRB and DoorBell"];
 Xi [label="XHCI IRQ event"];
 Xe [label="event-pointer matching gate"];
 Xend [label="end_request MMIO then complete"];
 Xclear [label="clear active pointer"];
 Xpost [label="outer IRQ EP ring progress"];
 Xret [label="XHCI caller return0"];
 Xx [label="STOP EP lifetime/controller"];
 A0 -> Ap [label="LOCAL",style=solid];
 Ap -> Ax [label="STOP",style=dotted];
 Ap -> Am [label="VALID",style=solid];
 Am -> Ac [label="NONZERO",style=solid];
 Am -> Ar [label="ZERO",style=solid];
 Ac -> Ar [label="RETURN_IGNORED",style=solid];
 Ar -> Ao [label="RETURN",style=solid];
 Ad -> Ax [label="COMMENT_ONLY",style=solid];
 Bq -> Ba [label="ASYNC",style=dashed];
 Ba -> Bc [label="LOCAL",style=solid];
 Ba -> Bi [label="ASYNC",style=dashed];
 Bi -> Bx [label="STOP_IF_NULL",style=dotted];
 Bi -> Bh [label="VALID",style=solid];
 Bh -> Bg [label="RETURN",style=solid];
 Bg -> Bn [label="TRUE",style=solid];
 Bg -> Bnext [label="FALSE",style=solid];
 Bn -> Bclear [label="LOCAL",style=solid];
 Bn -> Bw [label="ASYNC",style=dashed];
 Bq -> Bw [label="CALL",style=solid];
 Bw -> Br [label="RETURN",style=solid];
 Bclear -> Bnext [label="ASYNC",style=dashed];
 Nq -> Ni [label="ASYNC",style=dashed];
 Ni -> Nack [label="LOCAL",style=solid];
 Nack -> Nend [label="LOCAL",style=solid];
 Nend -> Nret [label="ASYNC",style=dashed];
 Nend -> Nx [label="STOP",style=dotted];
 Xq -> Xwhile [label="LOCAL",style=solid];
 Xwhile -> Xx [label="STOP",style=dotted];
 Xwhile -> Xd [label="FALSE",style=solid];
 Xd -> Xi [label="ASYNC",style=dashed];
 Xi -> Xe [label="LOCAL",style=solid];
 Xe -> Xx [label="STOP",style=dotted];
 Xe -> Xend [label="MATCH",style=solid];
 Xend -> Xclear [label="LOCAL",style=solid];
 Xclear -> Xpost [label="LOCAL",style=solid];
 Xend -> Xret [label="ASYNC",style=dashed];
 Xpost -> Xx [label="STOP",style=dotted];
}
